{
  "name": "barbearia",
  "version": "1.0.0",
  "description": "App de gestão para barbearia (agendamento, agenda, estoque e caixa)",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "ensure:sqlite": "node scripts/ensure-sqlite.js",
    "seed": "node prisma/seed.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "node scripts/ensure-sqlite.js && prisma migrate deploy",
    "setup": "prisma migrate dev --name init && node prisma/seed.js",
    "setup:prod": "node scripts/ensure-sqlite.js && prisma migrate deploy && node prisma/seed.js",
    "postinstall": "prisma generate && node scripts/ensure-sqlite.js && prisma migrate deploy && node prisma/seed.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@parse/node-apn": "^8.1.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.20.1",
    "prisma": "^6.2.1",
    "session-file-store": "^1.5.0",
    "web-push": "^3.6.7"
  }
}
