<%/* Spec 13: link inválido, usado, revogado, vencido ou de pessoa inativa.
     A MESMA tela para todos os motivos (não diz qual). Também serve para o
     aviso de "muitas tentativas" (titulo/texto vindos do limite). */%>
<main class="cv-ac">
  <div class="cv-ac-wrap">
    <%- include('_acesso-marca') %>
    <% if (typeof aviso !== 'undefined' && aviso) { %>
      <h1 class="cv-ac-titulo">Muitas tentativas</h1>
      <p class="cv-ac-sub" role="alert">Muitas tentativas, aguarde alguns minutos.</p>
    <% } else { %>
      <h1 class="cv-ac-titulo">Este link não vale mais</h1>
      <p class="cv-ac-sub">Ele pode ter vencido ou já ter sido usado. Peça um novo link abaixo, responda o e-mail que você recebeu ou escreva para <%= suporte %>.</p>
    <% } %>
    <div class="cv-ac-acoes">
      <a href="/esqueci-senha" class="cv-ac-btn">Pedir novo link</a>
      <a href="/login" class="cv-ac-btn cv-ac-btn--texto">Ir para o login</a>
    </div>
  </div>
</main>
