<%/* Login da equipe (v3, redesign/v3/acesso, Dani). Formulário comum (POST
     /login) que funciona sem JS; com JS (cv-acesso.js) ele envia com
     Accept: application/json, mostra o erro sem recarregar e, no sucesso, o
     M1 curto "Tudo certo" (decisão da Kalany). Abertura M8 uma vez por sessão. */%>
<%
  var _f = (typeof flash !== 'undefined' && flash) ? flash : null;
  var _erro = _f && _f.tipo === 'erro' ? _f.texto : null;
  var _ok = _f && _f.tipo !== 'erro' ? _f.texto : null;
  var _email = (_f && _f.email) || '';
%>
<section class="ac-tela ac-tela--login" id="login" aria-labelledby="login-t">
  <%- include('_obj', { obId: 'login-t', obTitulo: 'Bem-vindo de volta.', obSub: 'Entre para acessar a agenda, o caixa e a equipe da sua barbearia.' }) %>
  <div class="ac-corpo">
    <h2 class="ac-form-t" data-cascata>Entrar</h2>
    <% if (_ok) { %><p class="ac-ok" role="status"><%= _ok %></p><% } %>
    <div class="ac-erro" id="login-erro" role="alert"<% if (!_erro) { %> hidden<% } %>><svg class="cv-ic cv-ic--18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg><span><%= _erro || 'E-mail ou senha inválidos.' %></span></div>
    <form class="ac-form" id="f-login" action="/login" method="post" novalidate data-acesso="login">
      <div class="cv-campo" data-cascata>
        <label for="l-email">E-mail</label>
        <input class="cv-entrada" id="l-email" name="email" type="email" inputmode="email" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="next" placeholder="voce@barbearia.com" value="<%= _email %>" required<% if (_erro) { %> aria-invalid="true" aria-describedby="login-erro"<% } %>>
      </div>
      <div class="cv-campo" data-cascata>
        <label for="l-senha">Senha</label>
        <div class="ac-senha">
          <input class="cv-entrada" id="l-senha" name="senha" type="password" autocomplete="current-password" enterkeyhint="go" placeholder="Sua senha" required<% if (_erro) { %> aria-invalid="true" aria-describedby="login-erro" autofocus<% } %>>
          <button class="ac-mostrar" type="button" data-mostrar aria-controls="l-senha" aria-pressed="false" hidden>Mostrar</button>
        </div>
      </div>
      <div class="ac-linha" data-cascata>
        <label class="ac-check"><input type="checkbox" name="manterConectado" value="1"><span class="caixa" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><span>Manter conectado</span></label>
        <a class="ac-link" href="/esqueci-senha">Esqueci minha senha</a>
      </div>
      <button class="cv-btn cv-btn--largo ac-btn" type="submit" id="btn-entrar" data-cascata data-ocupado="Entrando"><span class="ac-poste" aria-hidden="true"><i></i></span><span class="rot">Entrar</span></button>
    </form>
    <p class="ac-rodape" data-cascata><a href="/termos">Termos de uso</a><span aria-hidden="true">·</span><a href="/privacidade">Privacidade</a></p>
  </div>
</section>
