<%/* App do cliente: a barbearia e os serviços (v3). */%>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup"><a href="/conta" style="color:inherit">Voltar</a> · <%= local %></p><h1><%= barbearia.nome %></h1></div></header>
<% if (servicos.length === 0) { %>
  <div class="cv-secao" style="margin-top:16px"><div class="cv-cartao cv-vazio" role="status"><h2>Sem serviços ainda</h2><p>Esta barbearia ainda não cadastrou serviços.</p></div></div>
<% } else { %>
  <p class="cc-meta">Toque para escolher. Pode ser mais de um.</p>
  <form method="GET" action="/conta/b/<%= barbearia.slug %>/agendar" id="form-svc" class="cv-secao" style="margin-top:12px">
    <div class="cc-servicos">
      <% servicos.forEach(function (s) { %>
        <button type="button" class="cc-serv" aria-pressed="false" data-id="<%= s.id %>" data-valor="<%= s.valor %>" onclick="toggleSvc(this)">
          <span class="txt"><b><%= s.nome %></b><small><%= s.duracaoMin %> min · <%= fmtBRL(s.valor) %></small></span>
          <span class="marca" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></span>
        </button>
      <% }) %>
    </div>
    <input type="hidden" name="servicos" id="servicos-input" />
  </form>
  <div class="cc-barra" id="actionbar" hidden>
    <span class="info"><b id="sel-total">R$ 0,00</b><span id="sel-count">0 serviços</span></span>
    <button type="submit" form="form-svc" class="cv-btn" onclick="prepararEnvio()">Agendar horário</button>
  </div>
<% } %>
<script>
  var selecionados = [];
  function brl(c) { return (c / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }
  function toggleSvc(el) {
    var id = el.dataset.id, i = selecionados.indexOf(id);
    if (i >= 0) selecionados.splice(i, 1); else selecionados.push(id);
    el.setAttribute('aria-pressed', String(i < 0));
    var bar = document.getElementById('actionbar'); if (!bar) return;
    if (!selecionados.length) { bar.hidden = true; return; }
    var total = 0; document.querySelectorAll('.cc-serv[aria-pressed="true"]').forEach(function (e) { total += Number(e.dataset.valor); });
    document.getElementById('sel-count').textContent = selecionados.length + (selecionados.length === 1 ? ' serviço' : ' serviços');
    document.getElementById('sel-total').textContent = brl(total);
    bar.hidden = false;
  }
  function prepararEnvio() { document.getElementById('servicos-input').value = selecionados.join(','); }
</script>
