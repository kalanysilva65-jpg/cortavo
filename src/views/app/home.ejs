<%/* App do cliente: início e busca de barbearias (v3). */%>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup"><%= busca ? 'Busca' : 'São Paulo' %></p><h1><%= busca ? 'Buscar barbearia' : 'Barbearias perto de você' %></h1></div></header>
<% if (busca) { %>
  <form method="GET" action="/conta/busca" class="cv-busca" role="search"><span class="cv-oculto">Buscar barbearia</span><%- include('../partials/icone', { cvIc: 'busca' }) %><input class="cv-entrada" type="search" name="q" value="<%= termo %>" placeholder="Nome da barbearia" autofocus /></form>
  <p class="cc-meta"><%= barbearias.length %> <%= barbearias.length === 1 ? 'resultado' : 'resultados' %></p>
<% } %>
<section class="cv-secao" style="margin-top:14px" aria-label="Barbearias">
  <% if (barbearias.length === 0) { %>
    <div class="cv-cartao cv-vazio" role="status"><h2>Nenhuma barbearia encontrada</h2><p>Tente outro nome.</p></div>
  <% } else { %>
    <ul class="cv-lista">
      <% barbearias.forEach(function (b) { %>
        <li><a class="cv-linha" href="/conta/b/<%= b.slug %>">
          <span class="cv-avatar" aria-hidden="true"><%= String(b.nome).replace(/^Barbearia\s+/i, '').charAt(0).toUpperCase() %></span>
          <span class="corpo"><span class="t"><%= b.nome %></span><span class="s"><%= b.local %></span></span>
          <span class="cv-etq<%= b.abertaHoje ? ' cv-etq--preta' : ' cv-etq--listra' %>"><%= b.abertaHoje ? 'Aberta hoje' : 'Fechada hoje' %></span>
        </a></li>
      <% }) %>
    </ul>
  <% } %>
</section>
