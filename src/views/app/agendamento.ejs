<%/* App do cliente: agendamento confirmado (v3). Sem pagamento no app. */%>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup"><a href="/conta/agendamentos" style="color:inherit">Voltar</a></p><h1>Agendamento confirmado</h1></div></header>
<div class="cv-secao" style="margin-top:16px">
  <section class="cv-objeto cv-gravada" aria-label="Agendamento">
    <span style="display:block;font-size:14px;font-weight:600;color:var(--c-sobre-objeto-2)"><%= dataExtenso %> · <%= ag.horaInicio %></span>
    <b style="display:block;margin-top:6px;font-size:22px;font-weight:800;letter-spacing:-.02em"><%= ag.itens.map(function (i) { return i.servico.nome; }).join(' + ') %></b>
  </section>
  <div class="cv-cartao" style="margin-top:12px">
    <ul class="cc-linhas">
      <li><span>Barbearia</span><b><%= ag.barbearia.nome %></b></li>
      <li><span>Profissional</span><b><%= ag.usuario.nome %></b></li>
      <li><span>Pagamento</span><b>Na barbearia</b></li>
      <li><span>Total</span><b><%= fmtBRL(ag.valorTotal) %></b></li>
    </ul>
  </div>
  <a href="/conta/agendamentos" class="cv-btn cv-btn--2 cv-btn--largo" style="margin-top:14px">Ver meus agendamentos</a>
</div>
