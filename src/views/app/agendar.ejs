<%
  function urlCom(over) {
    var q = { servicos: servicosStr, barbeiro: barbeiro ? barbeiro.id : '', data: dataSel || '' };
    Object.assign(q, over);
    return '/conta/b/' + barbearia.slug + '/agendar?' + new URLSearchParams(q).toString();
  }
%>
<%/* App do cliente: barbeiro, dia e horário (v3). Mesmos campos e rota. */%>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup"><a href="/conta/b/<%= barbearia.slug %>" style="color:inherit">Voltar</a> · Agendar horário</p><h1><%= servicos.map(function (s) { return s.nome; }).join(' + ') %></h1></div></header>
<p class="cc-meta"><%= duracaoTotal %> min · <%= fmtBRL(valorTotal) %></p>

<section class="cv-secao" style="margin-top:16px" aria-labelledby="cc-prof">
  <div class="cv-secao-cab"><h2 id="cc-prof">Profissional</h2></div>
  <div class="cc-pessoas">
    <% barbeiros.forEach(function (b) { %>
      <a class="cc-pessoa" href="<%= urlCom({ barbeiro: b.id, data: '' }) %>"<% if (barbeiro && b.id === barbeiro.id) { %> aria-current="true"<% } %>>
        <span class="foto"><% if (b.fotoUrl) { %><img src="<%= b.fotoUrl %>" alt="" /><% } else { %><%= String(b.nome).charAt(0).toUpperCase() %><% } %></span>
        <span class="nome"><%= b.nome %></span>
      </a>
    <% }) %>
  </div>
</section>

<% if (!barbeiro) { %>
  <div class="cv-secao" style="margin-top:16px"><div class="cv-cartao"><p class="cv-texto-apoio" style="margin:0">Esta barbearia ainda não tem profissionais disponíveis.</p></div></div>
<% } else if (datas.length === 0) { %>
  <div class="cv-secao" style="margin-top:16px"><div class="cv-cartao"><p class="cv-texto-apoio" style="margin:0">Sem dias disponíveis para agendar com <%= barbeiro.nome %>.</p></div></div>
<% } else { %>
  <section class="cv-secao" aria-labelledby="cc-dia">
    <div class="cv-secao-cab"><h2 id="cc-dia"><%= mesLabel %></h2></div>
    <div class="cc-dias">
      <% datas.forEach(function (d) { %><a class="cc-dia" href="<%= urlCom({ data: d.iso }) %>"<% if (d.iso === dataSel) { %> aria-current="date"<% } %>><small><%= d.dow %></small><b><%= d.n %></b></a><% }) %>
    </div>
  </section>
  <form method="POST" action="/conta/b/<%= barbearia.slug %>/agendar" id="form-hora">
    <input type="hidden" name="servicos" value="<%= servicosStr %>" />
    <input type="hidden" name="barbeiro" value="<%= barbeiro.id %>" />
    <input type="hidden" name="data" value="<%= dataSel %>" />
    <input type="hidden" name="hora" id="hora-input" />
    <% function grade(titulo, lista) { %>
      <% if (lista.length) { %>
        <section class="cv-secao" aria-label="<%= titulo %>"><div class="cv-secao-cab"><h2><%= titulo %></h2></div>
          <div class="cc-horas">
            <% lista.forEach(function (h) { %><% if (h.livre) { %><button type="button" class="cc-hora" aria-pressed="false" data-hora="<%= h.hora %>"><%= h.hora %></button><% } else { %><button type="button" class="cc-hora" disabled aria-label="<%= h.hora %>, ocupado"><%= h.hora %></button><% } %><% }) %>
          </div>
        </section>
      <% } %>
    <% } %>
    <%- grade('Manhã', manha) %>
    <%- grade('Tarde', tarde) %>
  </form>
  <div class="cc-barra">
    <span class="info"><b><%= fmtBRL(valorTotal) %></b><span id="quando-label">Escolha um horário</span></span>
    <button type="submit" form="form-hora" class="cv-btn" id="btn-confirmar" disabled>Confirmar</button>
  </div>
  <script>
    document.querySelectorAll('.cc-hora:not([disabled])').forEach(function (el) {
      el.addEventListener('click', function () {
        document.querySelectorAll('.cc-hora[aria-pressed="true"]').forEach(function (e) { e.setAttribute('aria-pressed', 'false'); });
        el.setAttribute('aria-pressed', 'true');
        document.getElementById('hora-input').value = el.dataset.hora;
        document.getElementById('quando-label').textContent = 'Às ' + el.dataset.hora;
        document.getElementById('btn-confirmar').disabled = false;
      });
    });
    document.getElementById('form-hora').addEventListener('submit', function (e) { if (!document.getElementById('hora-input').value) e.preventDefault(); });
  </script>
<% } %>
