<% var lista = aba === 'passados' ? passados : proximos; %>
<%/* App do cliente: agendamentos (v3). */%>
<header class="cv-cab"><div class="cv-cab-txt"><h1>Agendamentos</h1></div><div class="cv-cab-acoes"><%- include('../partials/logo-c', { cvTam: 40 }) %></div></header>
<div class="cv-secao" style="margin-top:16px">
  <nav class="cv-seg cc-seg" aria-label="Agendamentos"><a href="/conta/agendamentos" aria-pressed="<%= aba !== 'passados' %>"<% if (aba !== 'passados') { %> aria-current="page"<% } %>>Próximos</a><a href="/conta/agendamentos?aba=passados" aria-pressed="<%= aba === 'passados' %>"<% if (aba === 'passados') { %> aria-current="page"<% } %>>Anteriores</a></nav>
</div>
<section class="cv-secao" style="margin-top:14px" aria-label="Lista">
  <% if (lista.length === 0) { %>
    <div class="cv-cartao cv-vazio" role="status"><h2><%= aba === 'passados' ? 'Nada por aqui' : 'Sem horários marcados' %></h2><p><%= aba === 'passados' ? 'Nenhum agendamento anterior.' : 'Você não tem agendamentos próximos.' %></p></div>
  <% } else { %>
    <ul class="cv-lista cv-lista--sem-ic">
      <% lista.forEach(function (ag) { %>
        <li><a class="cv-linha" href="/conta/agendamento/<%= ag.id %>"><span class="corpo"><span class="t"><%= ag.barbearia.nome %></span><span class="s"><%= ag.servicosLabel %> · <%= ag.quando %></span></span><% if (ag.concluido) { %><span class="cv-etq">Concluído</span><% } %><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a></li>
      <% }) %>
    </ul>
  <% } %>
</section>
