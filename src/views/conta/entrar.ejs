<%/* Conta do cliente: entrar (v3). */%>
<h1>Entrar</h1>
<p class="sub">Entre na sua conta para ver e marcar horários.</p>
<form method="POST" action="/conta/entrar" class="cv-cartao">
  <div class="cv-campo"><label for="email">E-mail</label><input class="cv-entrada" type="email" id="email" name="email" placeholder="seu@email.com" autocomplete="username" required autofocus /></div>
  <div class="cv-campo"><label for="senha">Senha</label><input class="cv-entrada" type="password" id="senha" name="senha" autocomplete="current-password" required /></div>
  <button class="cv-btn cv-btn--largo" type="submit">Entrar</button>
</form>
<p class="rodape"><a href="/conta/cadastro">Não tem conta? Criar conta</a></p>
