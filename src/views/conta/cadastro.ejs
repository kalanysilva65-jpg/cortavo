<%/* Conta do cliente: criar conta (v3). */%>
<h1>Criar conta</h1>
<p class="sub">Para marcar e acompanhar seus horários.</p>
<form method="POST" action="/conta/cadastro" class="cv-cartao">
  <div class="cv-campo"><label for="nome">Nome</label><input class="cv-entrada" type="text" id="nome" name="nome" placeholder="Seu nome" autocomplete="name" required autofocus /></div>
  <div class="cv-campo"><label for="email">E-mail</label><input class="cv-entrada" type="email" id="email" name="email" placeholder="seu@email.com" autocomplete="email" required /></div>
  <div class="cv-campo"><label for="telefone">Telefone <span style="font-weight:400;color:var(--c-apoio)">(opcional)</span></label><input class="cv-entrada" type="tel" id="telefone" name="telefone" placeholder="(11) 90000-0000" autocomplete="tel" /></div>
  <div class="cv-campo"><label for="senha">Senha</label><input class="cv-entrada" type="password" id="senha" name="senha" minlength="6" autocomplete="new-password" required /><span class="cv-ajuda">No mínimo 6 caracteres.</span></div>
  <button class="cv-btn cv-btn--largo" type="submit">Criar conta</button>
</form>
<p class="rodape"><a href="/conta/entrar">Já tenho conta</a></p>
