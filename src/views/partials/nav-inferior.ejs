<%
  // Navbar v3 (fatia F1, spec 12 §1): 5 seções FIXAS para todos os papéis,
  // em qualquer combinação de permissões. O que muda é o conteúdo dentro de
  // cada seção, nunca a barra. Substitui as barras "suave", "nova" e "antiga"
  // e as listas TELAS_*_PATHS. Os itens que moravam no menu (cadastros,
  // equipe, secretária...) estão na tela Mais (painel/mais.ejs), com o mesmo
  // filtro de permissão e de plano.
  //
  // Cada tela do painel pertence a uma seção; a seção ativa ganha
  // aria-current e a lente (M5). Caminho que não está listado cai em "Mais",
  // que é onde moram os cadastros e as configurações.
  var SECOES_NAV = {
    agenda: ['/painel/agenda', '/painel/horarios'],
    // Caixa, Relatórios, Comissões e Metas moram no Mais (seção Dinheiro,
    // Kalany 2026-10-10); a Gestão é só a tela dos números do período.
    gestao: ['/painel/gestao'],
  };
  function secaoDe(caminho) {
    var c = String(caminho || '').toLowerCase().replace(/\/+$/, '') || '/painel';
    if (c === '/painel') return 'inicio';
    var achou = 'mais';
    Object.keys(SECOES_NAV).forEach(function (s) {
      SECOES_NAV[s].forEach(function (p) { if (c === p || c.indexOf(p + '/') === 0) achou = s; });
    });
    return achou;
  }
  var secaoAtual = secaoDe(typeof currentPath !== 'undefined' ? currentPath : '');
  var ITENS_NAV = [
    { s: 'inicio', href: '/painel', nome: 'Início', ic: 'inicio' },
    { s: 'agenda', href: '/painel/agenda', nome: 'Agenda', ic: 'agenda' },
    null, // o "+" (Novo) fica no meio
    { s: 'gestao', href: '/painel/gestao', nome: 'Gestão', ic: 'gestao' },
    { s: 'mais', href: '/painel/mais', nome: 'Mais', ic: 'menu' },
  ];
%>
<nav class="cv-navbar" aria-label="Seções do painel" data-secao="<%= secaoAtual %>">
  <span class="cv-lente" aria-hidden="true"></span>
  <% ITENS_NAV.forEach(function (it) { %>
    <% if (!it) { %>
      <%/* Novo (M4): o "+" abre a folha com as ações liberadas. Sem JS ele
           continua sendo um link para o novo agendamento, a única ação que
           todo papel sempre tem. */%>
      <a class="cv-mais" id="btn-novo" href="/painel/agenda?abrir=agendamento" aria-label="Novo"><%- include('icone', { cvIc: 'mais' }) %></a>
    <% } else { %>
      <a class="cv-nav-item" href="<%= it.href %>" data-nav="<%= it.s %>"<% if (it.s === secaoAtual) { %> aria-current="page"<% } %>><%- include('icone', { cvIc: it.ic }) %><span><%= it.nome %></span></a>
    <% } %>
  <% }) %>
</nav>

<%
  // Folha Novo (fatia F2, M4): só as ações que este usuário pode fazer, com o
  // mesmo filtro das telas de destino. "Agendamento" aparece sempre.
  // Cada ação abre a tela que já faz aquilo, com a folha dela aberta
  // (?abrir=..., cv-casca.js), reaproveitando as rotas e validações de hoje.
  // Chaves do B1 (pode): clientes, caixa_lancar, horarios. Admin pode tudo.
  var _acessa = (typeof podeAcessar === 'function') ? podeAcessar : function () { return true; };
  var _adm = (typeof ehAdmin !== 'undefined') && !!ehAdmin;
  var _chave = function (k, href) { return _adm || ((typeof pode === 'function') ? pode(k) : (href ? _acessa(href) : false)); };
  var ACOES_NOVO = [
    { ic: 'novoAg', t: 'Agendamento', s: 'Cliente, serviço e horário', href: '/painel/agenda?abrir=agendamento', ok: true },
    { ic: 'clienteMais', t: 'Cliente', s: 'Cadastrar contato', href: '/painel/clientes?abrir=cliente', ok: _chave('clientes', '/painel/clientes') },
    { ic: 'lancamento', t: 'Lançamento', s: 'Entrada ou saída no caixa', href: '/painel/caixa?abrir=lancamento', ok: _chave('caixa_lancar') },
    { ic: 'bloqueio', t: 'Bloqueio', s: 'Fechar um horário', href: '/painel/agenda?abrir=bloqueio', ok: _chave('horarios', '/painel/horarios') },
  ].filter(function (a) { return a.ok; });
%>
<div class="cv-veu" aria-hidden="true"></div>
<section class="cv-folha" id="folha-novo" role="dialog" aria-modal="true" aria-labelledby="folha-novo-titulo">
  <div class="cv-folha-zona">
    <div class="cv-puxador" aria-hidden="true"></div>
    <div class="cv-folha-cab">
      <h2 id="folha-novo-titulo" tabindex="-1" data-foco style="outline:none">Novo</h2>
      <button class="cv-redondo cv-redondo--leve" type="button" data-fechar aria-label="Fechar"><%- include('icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button>
    </div>
  </div>
  <div class="cv-folha-corpo">
    <div class="cv-acoes4">
      <% ACOES_NOVO.forEach(function (a, i) { %>
        <a class="cv-acao<%= i === 0 ? ' cv-acao--principal' : '' %>" href="<%= a.href %>" data-cascata><%- include('icone', { cvIc: a.ic }) %><span><b><%= a.t %></b><small><%= a.s %></small></span></a>
      <% }) %>
    </div>
  </div>
</section>

<%
  // Menu lateral do PC (fatia F13): a navbar do celular aberta. Mesmas 5
  // seções e o mesmo Novo (com as mesmas ações filtradas, num popover em
  // vidro), mais os itens do Mais, lidos da mesma peça que a tela Mais usa
  // (mais-listas.ejs). Só aparece a partir de 1024 px (cv-pc.css); abaixo
  // disso fica escondido e a navbar continua sendo a única navegação.
  var _cam = String(typeof currentPath !== 'undefined' ? currentPath : '').replace(/\/+$/, '') || '/painel';
  var _PM = {};
%><%- include('mais-listas', { saida: _PM }) %><%
  // Sem subitens na Gestão do menu do PC: Caixa, Relatórios, Comissões e
  // Metas aparecem na seção Dinheiro, que vem do Mais (mais-listas.ejs).
  var SUB_GESTAO = [];
  var _iniBarb = String(_PM.nomeBarbearia || 'C').replace(/^Barbearia\s+(d[aeo]s?\s+|e\s+)?/i, '').charAt(0).toUpperCase();
  var _logoPc = (typeof marcaLogoUrl !== 'undefined' && marcaLogoUrl) ? marcaLogoUrl : null;
  var _ft = (typeof faixaTeste !== 'undefined' && faixaTeste) ? faixaTeste : null;
  var _ehAtual = function (href) { return _cam === href.split('#')[0]; };
  var _subAtual = SUB_GESTAO.some(function (x) { return _ehAtual(x.href); });
  // Um item só marcado: se a tela é um item do Mais (ex.: Horários), ele
  // ganha o destaque e a seção não.
  var _maisAtual = _PM.secoes.some(function (sec) { return sec.itens.some(function (it) { return it.href.indexOf('#') < 0 && _ehAtual(it.href); }); });
  var _secPc = (_subAtual || _maisAtual) ? '' : secaoAtual;
%>
<aside class="pc-menu" aria-label="Menu da barbearia">
  <div class="pc-marca">
    <span class="logo" aria-hidden="true"><% if (_logoPc) { %><img src="<%= _logoPc %>" alt="" /><% } else { %><span class="ini"><%= _iniBarb %></span><% } %></span>
    <span><b><%= _PM.nomeBarbearia %></b><small><%= _adm && _PM.plano ? 'Plano ' + _PM.plano.nome : _PM.papelTxt %></small></span>
  </div>
  <button class="cv-btn pc-novo" type="button" id="pc-novo" aria-haspopup="menu" aria-expanded="false" aria-controls="pc-pop"><%- include('icone', { cvIc: 'mais', cvCls: 'cv-ic--20' }) %>Novo<kbd aria-hidden="true">N</kbd></button>
  <div class="pc-pop" id="pc-pop" role="menu" aria-label="Novo" hidden>
    <% ACOES_NOVO.forEach(function (a, i) { %>
      <a role="menuitem" class="<%= i === 0 ? 'principal' : '' %>" href="<%= a.href %>"><span class="q"><%- include('icone', { cvIc: a.ic, cvCls: 'cv-ic--20' }) %></span><span><b><%= a.t %></b><small><%= a.s %></small></span></a>
    <% }) %>
  </div>
  <nav class="pc-nav" aria-label="Seções do painel">
    <a class="pc-item" href="/painel"<% if (_secPc === 'inicio') { %> aria-current="page"<% } %>><%- include('icone', { cvIc: 'inicio' }) %>Início</a>
    <a class="pc-item" href="/painel/agenda"<% if (_secPc === 'agenda') { %> aria-current="page"<% } %>><%- include('icone', { cvIc: 'agenda' }) %>Agenda</a>
    <a class="pc-item" href="/painel/gestao"<% if (_secPc === 'gestao') { %> aria-current="page"<% } %>><%- include('icone', { cvIc: 'gestao' }) %>Gestão</a>
    <% if (SUB_GESTAO.length) { %>
      <div class="pc-sub">
        <% SUB_GESTAO.forEach(function (x) { %><a class="pc-item" href="<%= x.href %>"<% if (_ehAtual(x.href)) { %> aria-current="page"<% } %>><%= x.t %></a><% }) %>
      </div>
    <% } %>
    <% _PM.secoes.forEach(function (sec) { if (!sec.itens.length) return; %>
      <div class="pc-grupo"><%= sec.t %></div>
      <% sec.itens.forEach(function (it) { %>
        <a class="pc-item<%= it.cadeadoPlano ? ' bloq' : '' %>" href="<%= it.href %>"<% if (_ehAtual(it.href) && it.href.indexOf('#') < 0) { %> aria-current="page"<% } %><% if (it.cadeadoPlano) { %> aria-label="<%= it.t %> (fora do plano)"<% } %>><%- include('icone', { cvIc: it.ic }) %><span class="t"><%= it.t %></span><% if (it.cadeadoPlano) { %><span class="cv-cadeado"><%- include('icone', { cvIc: 'cadeado' }) %><%= it.cadeadoPlano === 'Barbearia + IA' ? '+ IA' : it.cadeadoPlano %></span><% } %></a>
      <% }) %>
    <% }) %>
    <div class="pc-grupo">Conta</div>
    <% _PM.conta.forEach(function (it) { %>
      <a class="pc-item" href="<%= it.href %>"><%- include('icone', { cvIc: it.ic }) %><span class="t"><%= it.t %></span></a>
    <% }) %>
  </nav>
  <div class="pc-rodape">
    <% if (_ft) { %>
      <a class="pc-teste" href="/painel/meu-plano"><b><%= _ft.dias > 0 ? _ft.dias : '0' %></b><span><%= _ft.dias > 0 ? (_ft.dias === 1 ? 'dia de teste' : 'dias de teste') : 'O teste terminou' %></span></a>
    <% } %>
    <a class="pc-usuario" href="/painel/perfil" aria-label="Meu perfil: <%= _PM.nome %>">
      <span class="cv-avatar cv-avatar--p" aria-hidden="true"><% if (typeof usuarioFotoUrl !== 'undefined' && usuarioFotoUrl) { %><img src="<%= usuarioFotoUrl %>" alt="" /><% } else { %><%= _PM.iniciais %><% } %></span>
      <span><b><%= _PM.nome %></b><small><%= _PM.papelTxt %></small></span>
    </a>
    <form method="POST" action="/logout"><button class="pc-item pc-sair" type="submit"><%- include('icone', { cvIc: 'sair' }) %>Sair</button></form>
  </div>
</aside>
