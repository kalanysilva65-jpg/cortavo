<%/* Secretária de IA (redesign v3, F8; mockup redesign/v3/prints/13).
     Estado no topo (objeto preto), depois WhatsApp (conectar um número pela
     conta da Cortavo ou o perfil do número conectado), atendimento automático,
     ajustes e, no fim, a Zona de risco com o Desconectar (confirmação por
     DESCONECTAR conferida no servidor). Mesmos campos, IDs e rotas de antes;
     estilos em public/css/cv-secretaria.css. */%>
<%
  var semSecretaria = typeof planoCortavo !== 'undefined' && planoCortavo && planoCortavo.tetos.secretaria === 0;
  var estado = semSecretaria ? 'Fora do plano' : !whatsapp.conectado ? 'Sem WhatsApp conectado' : iaPausada ? 'Pausada' : 'Atendendo agora';
  var final4 = whatsapp.numero ? String(whatsapp.numero).replace(/\D/g, '').slice(-4) : '';
%>
<header class="cv-cab">
  <div class="cv-cab-txt">
    <a class="cv-cx-voltar" href="/painel/mais"><%- include('../partials/icone', { cvIc: 'esquerda', cvCls: 'cv-ic--20' }) %>Mais</a>
    <h1>Secretária</h1>
  </div>
</header>

<div class="cv-secao" style="margin-top:12px">
  <section class="cv-objeto cv-gravada cv-sec-estado" aria-label="Estado da secretária">
    <div class="cv-sec-estado-linha">
      <span class="rot cv-sec-pulso" data-estado="<%= estado === 'Atendendo agora' ? 'on' : 'off' %>"><i aria-hidden="true"></i><%= estado %></span>
      <% if (final4) { %><span class="rot">WhatsApp final <%= final4 %></span><% } %>
    </div>
    <% var U = (typeof usoSecretaria !== 'undefined' && usoSecretaria && !usoSecretaria.desligado && usoSecretaria.teto) ? usoSecretaria : null; %>
    <% if (U && !semSecretaria) { var pU = Math.min(1, U.respostas / U.teto); %>
      <div class="cv-sec-uso"><span class="cv-num cv-num--g"><span class="int"><%= U.respostas %></span><span class="de"> de <%= U.teto %></span></span><span class="rot">respostas usadas no mês</span>
        <span class="cv-sec-barra" role="progressbar" aria-valuemin="0" aria-valuemax="<%= U.teto %>" aria-valuenow="<%= U.respostas %>" aria-label="Respostas usadas no mês"><b style="transform:scaleX(<%= pU.toFixed(3) %>)"></b></span></div>
    <% } %>
    <p class="cv-sec-estado-txt">
      <% if (semSecretaria) { %>A secretária de IA não está no seu plano. As mensagens chegam em Conversas para você responder. Disponível no plano Barbearia + IA. Fale com a Cortavo.
      <% } else if (!whatsapp.conectado) { %>Conecte um número abaixo para a secretária responder e agendar no WhatsApp.
      <% } else if (iaPausada) { %>Ela não responde sozinha. As mensagens chegam em Conversas para você responder.
      <% } else { %>Ela responde as mensagens novas e marca na agenda.<% } %>
    </p>
    <% if (ehDono) { %><a class="cv-sec-testar" href="/painel/secretaria/teste">Testar a conversa<%- include('../partials/icone', { cvIc: 'direita', cvCls: 'cv-ic--16' }) %></a><% } %>
  </section>
</div>

<%/* Conectar um número pela conta da CORTAVO (a cobrança da Meta cai no
     cartão da Cortavo). O código de SMS ou ligação o cliente digita AQUI. */%>
<% if (!whatsapp.conectado && numeroCortavo.disponivel) { %>
<section class="cv-secao" aria-labelledby="sec-conectar">
  <div class="cv-secao-cab"><h2 id="sec-conectar">Conectar um número ao Cortavo</h2></div>
  <div class="cv-cartao" id="svNum">
    <p class="cv-texto-apoio">O número vai funcionar pela conta de WhatsApp da Cortavo, e a Cortavo paga as mensagens para a Meta. Enquanto estiver conectado, ele <strong>não funciona no app do WhatsApp do celular</strong>. Se for o número que você já usa, faça backup das conversas e <strong>apague a conta no WhatsApp Business do celular antes</strong>. Ou use um chip novo só para a secretária. Se você sair da Cortavo, o número é liberado para você.</p>
    <div id="svNumPasso1">
      <div class="cv-campo"><label for="svNumTel">Número do WhatsApp</label><input id="svNumTel" class="cv-entrada" type="tel" inputmode="tel" placeholder="(11) 99999-9999" autocomplete="off" /></div>
      <div class="cv-campo"><label for="svNumNome">Nome que aparece para os clientes</label><input id="svNumNome" class="cv-entrada" value="<%= numeroCortavo.nomeSugerido %>" maxlength="60" autocomplete="off" /></div>
      <div class="cv-sec-botoes">
        <button type="button" class="cv-btn" data-metodo="SMS" onclick="svNumPedir('SMS')">Receber código por SMS</button>
        <button type="button" class="cv-btn cv-btn--2" data-metodo="VOICE" onclick="svNumPedir('VOICE')">Receber por ligação</button>
      </div>
    </div>
    <div id="svNumPasso2" hidden>
      <p class="cv-texto-apoio">Enviamos um código de 6 dígitos para <strong id="svNumExibe"></strong>. Digite abaixo:</p>
      <div class="cv-campo"><label for="svNumCodigo">Código</label><input id="svNumCodigo" class="cv-entrada cv-entrada--num" inputmode="numeric" maxlength="7" placeholder="000000" autocomplete="one-time-code" /></div>
      <div class="cv-sec-botoes">
        <button type="button" class="cv-btn" onclick="svNumVerificar()">Confirmar e ativar</button>
        <button type="button" class="cv-btn cv-btn--2" onclick="svNumReenviar('VOICE')">Receber por ligação</button>
        <button type="button" class="cv-btn cv-btn--texto" onclick="svNumReenviar('SMS')">Reenviar SMS</button>
      </div>
    </div>
    <p class="cv-erro" id="svNumErro" role="alert" hidden></p>
  </div>
  <script>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      function erro(t) { var e = $('svNumErro'); e.textContent = t || ''; e.hidden = !t; }
      function ocupado(on) { document.querySelectorAll('#svNum button').forEach(function (b) { b.disabled = on; }); }
      async function post(url, corpo) {
        var r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) });
        var j = await r.json().catch(function () { return {}; });
        if (!r.ok || !j.ok) throw new Error(j.erro || 'Falha. Tente de novo.');
        return j;
      }
      window.svNumPedir = async function (metodo) {
        erro(''); ocupado(true);
        try {
          var j = await post('/painel/secretaria/whatsapp/numero/codigo', { numero: $('svNumTel').value, nomeExibicao: $('svNumNome').value, metodo: metodo });
          $('svNumExibe').textContent = j.exibicao;
          $('svNumPasso1').hidden = true; $('svNumPasso2').hidden = false;
          $('svNumCodigo').focus();
        } catch (e) { erro(e.message); } finally { ocupado(false); }
      };
      window.svNumReenviar = async function (metodo) {
        erro(''); ocupado(true);
        try { await post('/painel/secretaria/whatsapp/numero/reenviar', { metodo: metodo }); erro(''); if (window.Cortavo) window.Cortavo.aviso({ titulo: metodo === 'VOICE' ? 'Você vai receber uma ligação' : 'Código reenviado por SMS' }); }
        catch (e) { erro(e.message); } finally { ocupado(false); }
      };
      window.svNumVerificar = async function () {
        erro(''); ocupado(true);
        try { await post('/painel/secretaria/whatsapp/numero/verificar', { codigo: $('svNumCodigo').value }); location.reload(); }
        catch (e) { erro(e.message); ocupado(false); }
      };
    })();
  </script>
</section>
<% } %>

<%/* Perfil do WhatsApp (foto, sobre, descrição...). Funciona mesmo que o nome
     de exibição ainda esteja em análise ou tenha sido recusado pela Meta. */%>
<% if (whatsapp.conectado) { %>
<section class="cv-secao" aria-labelledby="sec-perfil">
  <div class="cv-secao-cab"><h2 id="sec-perfil">Perfil do WhatsApp</h2></div>
  <div class="cv-cartao" id="svPerfilWa">
    <p class="cv-texto-apoio">É o que o cliente vê ao tocar no nome da barbearia na conversa. Não precisa entrar no WhatsApp para mudar.</p>
    <p class="cv-texto-apoio" id="svPwNome" hidden></p>
    <div class="cv-sec-foto">
      <img id="svPwImg" alt="Foto do perfil do WhatsApp" hidden />
      <label class="cv-btn cv-btn--2 cv-btn--p">Escolher foto<input type="file" id="svPwFoto" accept="image/*" hidden /></label>
      <span class="cv-ajuda" id="svPwFotoNome">Foto quadrada, JPG ou PNG.</span>
    </div>
    <div class="cv-campo"><label for="svPwSobre">Frase curta (Sobre)</label><input id="svPwSobre" class="cv-entrada" maxlength="139" placeholder="Barbearia, corte, barba e estilo…" autocomplete="off" /></div>
    <div class="cv-campo"><label for="svPwDesc">Descrição</label><textarea id="svPwDesc" class="cv-entrada cv-sec-area" rows="3" maxlength="512" placeholder="Fale da barbearia, horários, diferenciais…"></textarea></div>
    <div class="cv-campo"><label for="svPwEnd">Endereço</label><input id="svPwEnd" class="cv-entrada" maxlength="256" autocomplete="off" /></div>
    <div class="cv-campo"><label for="svPwEmail">E-mail</label><input id="svPwEmail" class="cv-entrada" type="email" maxlength="128" autocomplete="off" spellcheck="false" /></div>
    <div class="cv-campo"><label for="svPwSite">Site ou Instagram</label><input id="svPwSite" class="cv-entrada" maxlength="256" placeholder="https://…" autocomplete="off" spellcheck="false" /></div>
    <button type="button" class="cv-btn cv-btn--largo" id="svPwSalvar" onclick="svPwSalvar()" style="margin-top:16px">Salvar perfil</button>
    <p class="cv-ajuda" id="svPwMsg" role="status" hidden></p>
  </div>
  <script>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      function msg(t, ruim) { var e = $('svPwMsg'); e.textContent = t || ''; e.hidden = !t; e.classList.toggle('cv-erro', !!ruim); }
      var NOMES = { APPROVED: 'aprovado', PENDING_REVIEW: 'em análise pela Meta', DECLINED: 'recusado pela Meta', AVAILABLE_WITHOUT_REVIEW: 'liberado' };
      fetch('/painel/secretaria/whatsapp/perfil').then(function (r) { return r.json(); }).then(function (j) {
        if (!j.ok) { msg(j.erro || 'Não consegui carregar o perfil.', true); return; }
        var p = j.perfil;
        $('svPwSobre').value = (p.sobre || '').trim(); $('svPwDesc').value = p.descricao; $('svPwEnd').value = p.endereco;
        $('svPwEmail').value = p.email; $('svPwSite').value = (p.sites && p.sites[0]) || '';
        if (p.fotoUrl) { $('svPwImg').src = p.fotoUrl; $('svPwImg').hidden = false; }
        if (p.nome) {
          var n = $('svPwNome'); n.hidden = false;
          n.innerHTML = 'Nome de exibição: <strong></strong>, ' + (NOMES[p.nomeStatus] || 'situação desconhecida') + '.' + (p.nomeStatus === 'DECLINED' ? ' A foto e a secretária funcionam normalmente; o cliente vê o número no lugar do nome.' : '');
          n.querySelector('strong').textContent = p.nome;
        }
      }).catch(function () { msg('Falha de rede ao carregar o perfil.', true); });
      $('svPwFoto').addEventListener('change', function () {
        var f = this.files && this.files[0];
        if (f) { $('svPwFotoNome').textContent = f.name; $('svPwImg').src = URL.createObjectURL(f); $('svPwImg').hidden = false; }
      });
      window.svPwSalvar = function () {
        var fd = new FormData();
        fd.append('sobre', $('svPwSobre').value); fd.append('descricao', $('svPwDesc').value); fd.append('endereco', $('svPwEnd').value);
        fd.append('email', $('svPwEmail').value); fd.append('site', $('svPwSite').value);
        var f = $('svPwFoto').files && $('svPwFoto').files[0]; if (f) fd.append('foto', f);
        $('svPwSalvar').disabled = true; msg('Salvando…');
        fetch('/painel/secretaria/whatsapp/perfil', { method: 'POST', body: fd }).then(function (r) { return r.json(); }).then(function (j) {
          if (j.ok) msg('Perfil salvo no WhatsApp. A foto pode levar alguns minutos para aparecer.'); else msg(j.erro || 'Não consegui salvar.', true);
        }).catch(function () { msg('Falha de rede.', true); }).then(function () { $('svPwSalvar').disabled = false; });
      };
    })();
  </script>
</section>
<% } %>

<%/* Liga e desliga da IA por barbearia. Pausada: as mensagens chegam em
     Conversas, mas a IA não responde sozinha. Plano sem secretária (teto 0)
     não mostra "Reativar IA"; o servidor também recusa (2.3). */%>
<section class="cv-secao" aria-labelledby="sec-auto">
  <div class="cv-secao-cab"><h2 id="sec-auto">Atendimento automático</h2></div>
  <div class="cv-cartao">
    <% if (semSecretaria) { %>
      <p class="cv-texto-apoio">A secretária de IA <strong>não está no seu plano</strong>. As mensagens chegam em Conversas para você responder. <span class="cv-cadeado"><%- include('../partials/icone', { cvIc: 'cadeado' }) %>Plano Barbearia + IA</span></p>
    <% } else if (iaPausada) { %>
      <p class="cv-texto-apoio">A IA está <strong>pausada</strong>: ela não responde sozinha. As mensagens chegam em Conversas para você responder.</p>
      <form method="POST" action="/painel/secretaria/ia/pausar"><button type="submit" class="cv-btn cv-btn--largo" style="margin-top:12px">Reativar IA</button></form>
    <% } else { %>
      <p class="cv-texto-apoio">A IA <strong>responde automaticamente</strong> as mensagens novas. Pause quando quiser atender só você (o número segue conectado).</p>
      <form method="POST" action="/painel/secretaria/ia/pausar"><button type="submit" class="cv-btn cv-btn--2 cv-btn--largo" style="margin-top:12px"><%- include('../partials/icone', { cvIc: 'pausa', cvCls: 'cv-ic--18' }) %>Pausar IA</button></form>
    <% } %>
  </div>
</section>

<%/* A barbearia (admin) vê só a antecedência do lembrete. O resto é técnico e
     fica com o dono do sistema (o controller também ignora). */%>
<section class="cv-secao" aria-labelledby="sec-ajustes">
  <div class="cv-secao-cab"><h2 id="sec-ajustes">Como ela atende</h2></div>
<% if (!ehDono) { %>
  <form method="POST" action="/painel/secretaria" class="cv-cartao">
    <div class="cv-campo"><label for="sec-antec">Lembrete antes do horário, em minutos</label><input id="sec-antec" class="cv-entrada" name="lembreteAntecedencia" value="<%= cfg.lembreteAntecedencia %>" inputmode="numeric" placeholder="60" autocomplete="off" /></div>
    <button type="submit" class="cv-btn cv-btn--2 cv-btn--largo" style="margin-top:16px">Salvar</button>
  </form>
<% } else { %>
  <form method="POST" action="/painel/secretaria" class="cv-cartao">
    <fieldset class="cv-campo cv-sec-grupo">
      <legend class="cv-rotulo">Como a barbearia agenda</legend>
      <label class="cv-sec-opt"><input type="radio" name="modo" value="cortavo" <%= cfg.modo === 'cortavo' ? 'checked' : '' %> /><span><strong>Pelo Cortavo</strong>: a secretária marca de verdade na agenda.</span></label>
      <label class="cv-sec-opt"><input type="radio" name="modo" value="terceiros" <%= cfg.modo === 'terceiros' ? 'checked' : '' %> /><span><strong>Em outro app</strong> (ex.: AppBarber): a secretária manda o link ou anota o pedido.</span></label>
    </fieldset>
    <div class="cv-campo"><label for="sec-link">Link de agendamento, no modo "outro app"</label><input id="sec-link" class="cv-entrada" name="link" value="<%= cfg.link %>" placeholder="https://…" inputmode="url" autocomplete="off" spellcheck="false" /></div>
    <div class="cv-campo"><label for="sec-regras">Regras da barbearia (limites que a atendente nunca cruza)</label><textarea id="sec-regras" class="cv-entrada cv-sec-area" name="regras" rows="4" placeholder="Não marcar com menos de 2h de antecedência; não dar desconto…"><%= cfg.regras %></textarea></div>
    <div class="cv-cx-duas" style="margin-top:16px">
      <div class="cv-campo"><label for="sec-teto">Teto WhatsApp/mês</label><input id="sec-teto" class="cv-entrada" name="tetoMes" value="<%= cfg.tetoMes %>" inputmode="numeric" placeholder="1500" autocomplete="off" /></div>
      <div class="cv-campo"><label for="sec-cop">Teto copiloto/mês</label><input id="sec-cop" class="cv-entrada" name="copilotoTetoMes" value="<%= cfg.copilotoTetoMes %>" inputmode="numeric" placeholder="200" autocomplete="off" /></div>
    </div>
    <div class="cv-campo"><label for="sec-priv">Link da política de privacidade (enviado no 1º contato, LGPD)</label><input id="sec-priv" class="cv-entrada" name="privacidadeLink" value="<%= cfg.privacidadeLink %>" placeholder="https://…" inputmode="url" autocomplete="off" spellcheck="false" /></div>
    <label class="cv-sec-opt" style="margin-top:16px"><input type="checkbox" name="lembretesAtivos" value="1" <%= cfg.lembretesAtivos ? 'checked' : '' %> /><span>Enviar um lembrete ao cliente antes do horário (mensagem de template: exige o template aprovado na Meta e o WhatsApp conectado).</span></label>
    <div class="cv-cx-duas" style="margin-top:16px">
      <div class="cv-campo"><label for="sec-tpl">Nome do template aprovado</label><input id="sec-tpl" class="cv-entrada" name="lembreteTemplate" value="<%= cfg.lembreteTemplate %>" placeholder="lembrete_agendamento" autocomplete="off" spellcheck="false" /></div>
      <div class="cv-campo"><label for="sec-antec2">Antecedência (min)</label><input id="sec-antec2" class="cv-entrada" name="lembreteAntecedencia" value="<%= cfg.lembreteAntecedencia %>" inputmode="numeric" placeholder="60" autocomplete="off" /></div>
    </div>
    <button type="submit" class="cv-btn cv-btn--2 cv-btn--largo" style="margin-top:16px">Salvar</button>
  </form>
<% } %>
</section>

<% if (whatsapp.conectado) { %>
<section class="cv-secao" aria-labelledby="sec-risco">
  <div class="cv-secao-cab"><h2 id="sec-risco">Zona de risco</h2></div>
  <form method="POST" action="/painel/secretaria/whatsapp/desconectar" class="cv-cartao">
    <b class="cv-sec-risco-tit">Desconectar o número<%= whatsapp.numero ? ' ' + whatsapp.numero : '' %></b>
    <p class="cv-texto-apoio">A secretária para de atender e o número é liberado na Meta para voltar ao app do WhatsApp. As conversas que estão no Cortavo continuam aqui. Dúvidas: <%= typeof suporteCortavo !== 'undefined' ? suporteCortavo : 'cortavo.app@gmail.com' %>.</p>
    <div class="cv-campo"><label for="sec-confirma">Para confirmar, digite DESCONECTAR</label><input id="sec-confirma" class="cv-entrada" name="confirmacao" autocomplete="off" spellcheck="false" required pattern="[Dd][Ee][Ss][Cc][Oo][Nn][Ee][Cc][Tt][Aa][Rr]" /></div>
    <button type="submit" class="cv-btn cv-btn--perigo cv-btn--largo" style="margin-top:16px"><%- include('../partials/icone', { cvIc: 'sair', cvCls: 'cv-ic--18' }) %>Desconectar</button>
  </form>
</section>
<% } %>
