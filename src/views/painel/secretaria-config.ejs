<%/* Configuração da secretária de IA (design suave). Estilos em sv-secretaria.css. */%>
<div class="sv-tela sv-sec">

  <div class="sv-sec-topo sv-reveal">
    <div>
      <div class="sv-titulo">Secretária</div>
      <div class="sv-sec-sub">Como a IA atende seus clientes</div>
    </div>
    <a href="/painel" class="sv-sec-fechar" title="Início" aria-label="Voltar ao início">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </a>
  </div>

  <% if (ehDono) { %>
  <a href="/painel/secretaria/teste" class="sv-sec-testar sv-reveal">
    <span>💬 Testar a conversa</span>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
  </a>
  <% } %>

  <%/* Estado do WhatsApp da barbearia. (A conexão por coexistência foi retirada:
       não funciona no Brasil. Conectar = bloco "Conectar um número ao Cortavo".) */%>
  <div class="sv-cartao sv-sec-wa sv-reveal">
    <div class="sv-sec-rot">WhatsApp da barbearia</div>
    <% if (whatsapp.conectado) { %>
      <p class="sv-sec-wa-ok">✅ Conectado<%= whatsapp.numero ? ' — ' + whatsapp.numero : '' %>. A secretária atende neste número.</p>
      <form method="POST" action="/painel/secretaria/whatsapp/desconectar">
        <p class="sv-sec-hint">Desconectar o WhatsApp desta barbearia? A secretária para de atender e o número é liberado na Meta para voltar ao app do WhatsApp. As conversas que estão no Cortavo continuam aqui.</p>
        <label class="sv-sec-campo"><span class="sv-sec-rot">Para confirmar, digite DESCONECTAR</span>
          <input name="confirmacao" autocomplete="off" required pattern="[Dd][Ee][Ss][Cc][Oo][Nn][Ee][Cc][Tt][Aa][Rr]" />
        </label>
        <button type="submit" class="sv-sec-wa-desc">Desconectar</button>
      </form>
      <p class="sv-sec-hint">Para voltar a usar este número no app do WhatsApp, desconecte aqui. Dúvidas: <%= typeof suporteCortavo !== 'undefined' ? suporteCortavo : 'cortavo.app@gmail.com' %>.</p>
    <% } %>

    <%/* Conectar um número pela conta da CORTAVO (a cobrança da Meta cai no
         cartão da Cortavo). O código de SMS/ligação o cliente digita AQUI. */%>
    <% if (!whatsapp.conectado && numeroCortavo.disponivel) { %>
      <div class="sv-sec-num" id="svNum">
        <div class="sv-sec-rot">Conectar um número ao Cortavo</div>
        <p class="sv-sec-hint">O número vai funcionar pela conta de WhatsApp da Cortavo, e a Cortavo paga as mensagens para a Meta. Enquanto estiver conectado, ele <strong>não funciona no app do WhatsApp do celular</strong>. Se for o número que você já usa, faça backup das conversas e <strong>apague a conta no WhatsApp Business do celular antes</strong>. Ou use um chip novo só para a secretária. Se você sair da Cortavo, o número é liberado para você.</p>

        <div id="svNumPasso1">
          <label class="sv-sec-campo"><span class="sv-sec-rot">Número do WhatsApp</span>
            <input id="svNumTel" inputmode="tel" placeholder="(11) 99999-9999" autocomplete="off" />
          </label>
          <label class="sv-sec-campo"><span class="sv-sec-rot">Nome que aparece para os clientes</span>
            <input id="svNumNome" value="<%= numeroCortavo.nomeSugerido %>" maxlength="60" autocomplete="off" />
          </label>
          <div class="sv-sec-linha">
            <button type="button" class="sv-sec-wa-btn" data-metodo="SMS" onclick="svNumPedir('SMS')">Receber código por SMS</button>
            <button type="button" class="sv-sec-wa-desc" data-metodo="VOICE" onclick="svNumPedir('VOICE')">Receber por ligação</button>
          </div>
        </div>

        <div id="svNumPasso2" hidden>
          <p class="sv-sec-hint">Enviamos um código de 6 dígitos para <strong id="svNumExibe"></strong>. Digite abaixo:</p>
          <label class="sv-sec-campo"><span class="sv-sec-rot">Código</span>
            <input id="svNumCodigo" inputmode="numeric" maxlength="7" placeholder="000000" autocomplete="one-time-code" />
          </label>
          <div class="sv-sec-linha">
            <button type="button" class="sv-sec-wa-btn" onclick="svNumVerificar()">Confirmar e ativar</button>
            <button type="button" class="sv-sec-wa-desc" onclick="svNumReenviar('VOICE')">Receber por ligação</button>
            <button type="button" class="sv-sec-wa-desc" onclick="svNumReenviar('SMS')">Reenviar SMS</button>
          </div>
        </div>

        <p class="sv-sec-wa-erro" id="svNumErro" hidden></p>
      </div>
      <script>
        (function () {
          var $ = function (id) { return document.getElementById(id); };
          function erro(t) { var e = $('svNumErro'); e.textContent = t || ''; e.hidden = !t; }
          function ocupado(on) {
            document.querySelectorAll('#svNum button').forEach(function (b) { b.disabled = on; });
          }
          async function post(url, corpo) {
            var r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) });
            var j = await r.json().catch(function () { return {}; });
            if (!r.ok || !j.ok) throw new Error(j.erro || 'Falha. Tente de novo.');
            return j;
          }
          window.svNumPedir = async function (metodo) {
            erro(''); ocupado(true);
            try {
              var j = await post('/painel/secretaria/whatsapp/numero/codigo', { numero: $('svNumTel').value, nomeExibicao: $('svNumNome').value, metodo: metodo });
              $('svNumExibe').textContent = j.exibicao;
              $('svNumPasso1').hidden = true; $('svNumPasso2').hidden = false;
              $('svNumCodigo').focus();
            } catch (e) { erro(e.message); } finally { ocupado(false); }
          };
          window.svNumReenviar = async function (metodo) {
            erro(''); ocupado(true);
            try { await post('/painel/secretaria/whatsapp/numero/reenviar', { metodo: metodo }); erro(''); alert(metodo === 'VOICE' ? 'Você vai receber uma ligação com o código.' : 'Código reenviado por SMS.'); }
            catch (e) { erro(e.message); } finally { ocupado(false); }
          };
          window.svNumVerificar = async function () {
            erro(''); ocupado(true);
            try { await post('/painel/secretaria/whatsapp/numero/verificar', { codigo: $('svNumCodigo').value }); location.reload(); }
            catch (e) { erro(e.message); ocupado(false); }
          };
        })();
      </script>
    <% } %>
  </div>

  <%/* Perfil do WhatsApp (foto, sobre, descrição...). Funciona mesmo que o nome
       de exibição ainda esteja em análise ou tenha sido recusado pela Meta. */%>
  <% if (whatsapp.conectado) { %>
    <div class="sv-cartao sv-sec-wa sv-reveal" id="svPerfilWa">
      <div class="sv-sec-rot">Perfil do WhatsApp</div>
      <p class="sv-sec-hint">É o que o cliente vê ao tocar no nome da barbearia na conversa. Você não precisa entrar no WhatsApp para mudar.</p>
      <p class="sv-sec-hint" id="svPwNome" hidden></p>
      <div class="sv-pw-foto">
        <img id="svPwImg" alt="" hidden />
        <label class="sv-sec-wa-desc sv-pw-escolher">Escolher foto
          <input type="file" id="svPwFoto" accept="image/*" hidden />
        </label>
        <span class="sv-sec-hint" id="svPwFotoNome">Foto quadrada, JPG ou PNG.</span>
      </div>
      <label class="sv-sec-campo"><span class="sv-sec-rot">Frase curta (Sobre)</span>
        <input id="svPwSobre" maxlength="139" placeholder="Ex.: Barbearia — corte, barba e estilo" autocomplete="off" />
      </label>
      <label class="sv-sec-campo"><span class="sv-sec-rot">Descrição</span>
        <textarea id="svPwDesc" rows="3" maxlength="512" placeholder="Fale da barbearia, horários, diferenciais..."></textarea>
      </label>
      <label class="sv-sec-campo"><span class="sv-sec-rot">Endereço</span>
        <input id="svPwEnd" maxlength="256" autocomplete="off" />
      </label>
      <div class="sv-sec-linha">
        <label class="sv-sec-campo"><span class="sv-sec-rot">E-mail</span><input id="svPwEmail" type="email" maxlength="128" autocomplete="off" /></label>
        <label class="sv-sec-campo"><span class="sv-sec-rot">Site ou Instagram</span><input id="svPwSite" maxlength="256" placeholder="https://" autocomplete="off" /></label>
      </div>
      <div class="sv-sec-linha">
        <button type="button" class="sv-sec-wa-btn" id="svPwSalvar" onclick="svPwSalvar()">Salvar perfil</button>
      </div>
      <p class="sv-sec-hint" id="svPwMsg" hidden></p>
    </div>
    <script>
      (function () {
        var $ = function (id) { return document.getElementById(id); };
        function msg(t, ruim) { var e = $('svPwMsg'); e.textContent = t || ''; e.hidden = !t; e.style.color = ruim ? '#b91c1c' : ''; }
        var NOMES = { APPROVED: 'aprovado', PENDING_REVIEW: 'em análise pela Meta', DECLINED: 'recusado pela Meta', AVAILABLE_WITHOUT_REVIEW: 'liberado' };
        fetch('/painel/secretaria/whatsapp/perfil').then(function (r) { return r.json(); }).then(function (j) {
          if (!j.ok) { msg(j.erro || 'Não consegui carregar o perfil.', true); return; }
          var p = j.perfil;
          $('svPwSobre').value = (p.sobre || '').trim(); $('svPwDesc').value = p.descricao; $('svPwEnd').value = p.endereco;
          $('svPwEmail').value = p.email; $('svPwSite').value = (p.sites && p.sites[0]) || '';
          if (p.fotoUrl) { $('svPwImg').src = p.fotoUrl; $('svPwImg').hidden = false; }
          if (p.nome) {
            var n = $('svPwNome'); n.hidden = false;
            n.innerHTML = 'Nome de exibição: <strong></strong> — ' + (NOMES[p.nomeStatus] || 'situação desconhecida') + '.' + (p.nomeStatus === 'DECLINED' ? ' A foto e a secretária funcionam normalmente; o cliente vê o número no lugar do nome.' : '');
            n.querySelector('strong').textContent = p.nome;
          }
        }).catch(function () { msg('Falha de rede ao carregar o perfil.', true); });
        $('svPwFoto').addEventListener('change', function () {
          var f = this.files && this.files[0];
          if (f) { $('svPwFotoNome').textContent = f.name; $('svPwImg').src = URL.createObjectURL(f); $('svPwImg').hidden = false; }
        });
        window.svPwSalvar = function () {
          var fd = new FormData();
          fd.append('sobre', $('svPwSobre').value); fd.append('descricao', $('svPwDesc').value); fd.append('endereco', $('svPwEnd').value);
          fd.append('email', $('svPwEmail').value); fd.append('site', $('svPwSite').value);
          var f = $('svPwFoto').files && $('svPwFoto').files[0]; if (f) fd.append('foto', f);
          $('svPwSalvar').disabled = true; msg('Salvando...');
          fetch('/painel/secretaria/whatsapp/perfil', { method: 'POST', body: fd }).then(function (r) { return r.json(); }).then(function (j) {
            if (j.ok) msg('Perfil salvo no WhatsApp. A foto pode levar alguns minutos para aparecer.'); else msg(j.erro || 'Não consegui salvar.', true);
          }).catch(function () { msg('Falha de rede.', true); }).then(function () { $('svPwSalvar').disabled = false; });
        };
      })();
    </script>
  <% } %>

  <%/* Liga/desliga da IA por barbearia. Pausada: as mensagens ainda chegam na
       Caixa de entrada, mas a IA não responde sozinha (o dono atende na mão). */%>
  <div class="sv-cartao sv-sec-wa sv-reveal">
    <div class="sv-sec-rot">Atendimento automático</div>
    <%/* Fase 2.4: plano sem secretária (teto 0) não mostra "Reativar IA";
         o servidor também recusa (2.3). */%>
    <% var semSecretaria = typeof planoCortavo !== 'undefined' && planoCortavo && planoCortavo.tetos.secretaria === 0; %>
    <% if (semSecretaria) { %>
      <p class="sv-sec-hint">A secretária de IA <strong>não está no seu plano</strong>. As mensagens chegam em Conversas para você responder. Disponível no plano Barbearia + IA. Fale com a Cortavo.</p>
    <% } else if (iaPausada) { %>
      <p class="sv-sec-wa-pausada">⏸️ IA <strong>pausada</strong> — ela não responde sozinha. As mensagens ainda chegam na Caixa de entrada pra você responder.</p>
      <form method="POST" action="/painel/secretaria/ia/pausar">
        <button type="submit" class="sv-sec-wa-btn">Reativar IA</button>
      </form>
    <% } else { %>
      <p class="sv-sec-hint">A IA <strong>responde automaticamente</strong> as mensagens novas. Pause quando quiser atender só na mão (o número segue conectado).</p>
      <form method="POST" action="/painel/secretaria/ia/pausar">
        <button type="submit" class="sv-sec-wa-desc">Pausar IA</button>
      </form>
    <% } %>
  </div>

  <%/* Barbearia (admin) vê só: conectar WhatsApp, atendimento automático e a
       antecedência do lembrete. O resto é técnico e fica só com o dono do
       sistema (pedido do dono, 2026-09-30) — o controller também ignora. */%>
  <% if (!ehDono) { %>
  <form method="POST" action="/painel/secretaria" class="sv-cartao sv-sec-form sv-reveal">
    <label class="sv-sec-campo">
      <span class="sv-sec-rot">Lembrete antes do horário (minutos de antecedência)</span>
      <input name="lembreteAntecedencia" value="<%= cfg.lembreteAntecedencia %>" inputmode="numeric" placeholder="60" autocomplete="off" />
    </label>
    <button type="submit" class="sv-sec-salvar">Salvar</button>
  </form>
  <% } else { %>
  <form method="POST" action="/painel/secretaria" class="sv-cartao sv-sec-form sv-reveal">

    <div class="sv-sec-campo">
      <span class="sv-sec-rot">Como a barbearia agenda</span>
      <label class="sv-sec-opt">
        <input type="radio" name="modo" value="cortavo" <%= cfg.modo === 'cortavo' ? 'checked' : '' %> />
        <span><strong>Pelo Cortavo</strong> — a secretária marca de verdade na agenda.</span>
      </label>
      <label class="sv-sec-opt">
        <input type="radio" name="modo" value="terceiros" <%= cfg.modo === 'terceiros' ? 'checked' : '' %> />
        <span><strong>Em outro app</strong> (ex.: AppBarber) — a secretária manda o link ou anota o pedido.</span>
      </label>
    </div>

    <label class="sv-sec-campo">
      <span class="sv-sec-rot">Link de agendamento <span class="sv-sec-hint">(usado no modo “outro app”)</span></span>
      <input name="link" value="<%= cfg.link %>" placeholder="https://..." inputmode="url" autocomplete="off" />
    </label>

    <label class="sv-sec-campo">
      <span class="sv-sec-rot">Regras da sua barbearia <span class="sv-sec-hint">(limites que a atendente nunca cruza)</span></span>
      <textarea name="regras" rows="4" placeholder="Ex.: não marcar com menos de 2h de antecedência; não dar desconto; remarcação só com um atendente."><%= cfg.regras %></textarea>
    </label>

    <div class="sv-sec-linha">
      <label class="sv-sec-campo">
        <span class="sv-sec-rot">Teto WhatsApp/mês</span>
        <input name="tetoMes" value="<%= cfg.tetoMes %>" inputmode="numeric" placeholder="1500" autocomplete="off" />
      </label>
      <label class="sv-sec-campo">
        <span class="sv-sec-rot">Teto copiloto/mês</span>
        <input name="copilotoTetoMes" value="<%= cfg.copilotoTetoMes %>" inputmode="numeric" placeholder="200" autocomplete="off" />
      </label>
    </div>

    <label class="sv-sec-campo">
      <span class="sv-sec-rot">Link da política de privacidade <span class="sv-sec-hint">(enviado no 1º contato — LGPD)</span></span>
      <input name="privacidadeLink" value="<%= cfg.privacidadeLink %>" placeholder="https://..." inputmode="url" autocomplete="off" />
    </label>

    <div class="sv-sec-campo">
      <span class="sv-sec-rot">Lembretes automáticos (WhatsApp)</span>
      <label class="sv-sec-opt">
        <input type="checkbox" name="lembretesAtivos" value="1" <%= cfg.lembretesAtivos ? 'checked' : '' %> />
        <span>Enviar um lembrete ao cliente antes do horário. <span class="sv-sec-hint">(é mensagem de template — custo baixo por envio; exige o template aprovado na Meta e o WhatsApp conectado)</span></span>
      </label>
    </div>

    <div class="sv-sec-linha">
      <label class="sv-sec-campo">
        <span class="sv-sec-rot">Nome do template aprovado</span>
        <input name="lembreteTemplate" value="<%= cfg.lembreteTemplate %>" placeholder="ex.: lembrete_agendamento" autocomplete="off" />
      </label>
      <label class="sv-sec-campo">
        <span class="sv-sec-rot">Antecedência (min)</span>
        <input name="lembreteAntecedencia" value="<%= cfg.lembreteAntecedencia %>" inputmode="numeric" placeholder="60" autocomplete="off" />
      </label>
    </div>

    <button type="submit" class="sv-sec-salvar">Salvar</button>
  </form>
  <% } %>

</div>
