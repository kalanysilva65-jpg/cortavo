<%/* Fora do plano (fase 2.2; visual v3). Resposta do servidor quando a rota
     não está no plano da Cortavo. Sem botão de pagar (regra da Apple). O
     estado é a listra parada; só preto, branco e cinza. */%>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup">Fora do plano</p><h1><%= funcao.rotulo %></h1></div></header>
<div class="cv-secao" style="margin-top:16px">
  <div class="cv-cartao cv-vazio" role="main">
    <div class="marca" aria-hidden="true" style="width:64px;height:64px;border-radius:20px;margin:0 auto 14px;background:var(--listra-bloqueado);box-shadow:inset 0 0 0 .5px var(--c-fio-forte);display:grid;place-items:center"><%- include('../partials/icone', { cvIc: 'cadeado' }) %></div>
    <h2><%= funcao.rotulo %></h2>
    <p><%= texto %></p>
    <div class="acoes" style="display:grid;gap:8px">
      <% if (typeof ehAdmin !== 'undefined' && ehAdmin) { %><a class="cv-btn" href="/painel/meu-plano">Ver meu plano</a><% } %>
      <a class="cv-btn cv-btn--2" href="/painel">Voltar ao início</a>
    </div>
  </div>
</div>
