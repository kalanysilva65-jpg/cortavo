<%/* Logo e aparência (redesign v3; Dani, link.html#aparencia). Prévia do
     topo do agendamento, Trocar ou Adicionar logo, Posição (segmento), Tamanho
     (80 a 240 px), Salvar e Excluir logo com confirmação. Só admin.
     Mesmas rotas e campos (/painel/logo, multipart). */%>
<%
  var nome = (typeof barbeariaAtual !== 'undefined' && barbeariaAtual) ? barbeariaAtual.nome : 'Sua barbearia';
  var ini = nome.replace(/^Barbearia\s+(d[aeo]s?\s+|e\s+)?/i, '').charAt(0).toUpperCase();
%>
<header class="cv-cab">
  <div class="cv-cab-txt"><p class="cv-cab-sup"><a href="/painel/link" style="color:inherit">Link de agendamento</a></p><h1>Logo e aparência</h1></div>
</header>

<form class="lk-ap" method="POST" action="/painel/logo" enctype="multipart/form-data" id="lk-ap-form">
  <div class="cv-cartao">
    <p class="cv-rotulo" style="margin:0 0 10px">Prévia do topo do agendamento</p>
    <div class="lk-ap-previa" id="lk-ap-previa" data-alinh="<%= marca.logoAlinhamento %>" style="--tam:<%= marca.logoTamanho %>">
      <span class="lk-logo lk-logo--ap"><img id="lk-ap-img" src="<%= marca.logoUrl || '' %>" alt=""<% if (!marca.logoUrl) { %> hidden<% } %> /><span id="lk-ap-ini" aria-hidden="true"<% if (marca.logoUrl) { %> hidden<% } %>><%= ini %></span></span>
      <span class="lk-ap-nome"><b><%= nome %></b><small><%= (typeof horarioHoje !== 'undefined' && horarioHoje) ? horarioHoje.texto : 'Aberto hoje' %></small></span>
    </div>
    <p class="cv-ajuda lk-sem" id="lk-ap-sem"<% if (marca.logoUrl) { %> hidden<% } %>>Sem logo, o cliente vê a inicial e o nome da barbearia.</p>
    <label class="cv-btn cv-btn--2 cv-btn--largo lk-arquivo"><span><%= marca.logoUrl ? 'Trocar logo' : 'Adicionar logo' %></span><input type="file" name="logo" id="lk-ap-arquivo" accept="image/*" class="cv-oculto" /></label>
  </div>
  <div class="cv-cartao">
    <div class="cv-campo"><span class="cv-rotulo" id="ap-pos">Posição</span>
      <input type="hidden" name="alinhamento" id="lk-ap-alinh" value="<%= marca.logoAlinhamento %>" />
      <div class="cv-seg lk-seg" role="radiogroup" aria-labelledby="ap-pos" style="margin-top:6px">
        <% [['esquerda','Esquerda'],['centro','Centro'],['direita','Direita']].forEach(function (o) { %><button type="button" role="radio" aria-checked="<%= marca.logoAlinhamento === o[0] %>" aria-pressed="<%= marca.logoAlinhamento === o[0] %>" data-alinh="<%= o[0] %>"><%= o[1] %></button><% }) %>
      </div>
    </div>
    <div class="cv-campo"><label for="lk-ap-tam">Tamanho <b class="cv-num" id="lk-ap-tam-t"><%= marca.logoTamanho %></b> px</label><input type="range" id="lk-ap-tam" name="tamanho" min="80" max="240" step="4" value="<%= marca.logoTamanho %>" class="lk-faixa" /></div>
  </div>
  <button class="cv-btn cv-btn--largo" type="submit">Salvar</button>
</form>
<% if (marca.logoUrl) { %>
  <form method="POST" action="/painel/logo/remover" data-confirmar="Excluir a logo? O cliente passa a ver a inicial e o nome da barbearia." style="padding:0 var(--margem)">
    <button type="submit" class="cv-btn cv-btn--texto cv-btn--largo lk-excluir">Excluir logo</button>
  </form>
<% } %>

<script>
  (function () {
    var prev = document.getElementById('lk-ap-previa'), tam = document.getElementById('lk-ap-tam'), alinh = document.getElementById('lk-ap-alinh');
    tam.addEventListener('input', function () { document.getElementById('lk-ap-tam-t').textContent = tam.value; prev.style.setProperty('--tam', tam.value); });
    Array.prototype.forEach.call(document.querySelectorAll('.lk-seg [data-alinh]'), function (b) {
      b.addEventListener('click', function () {
        Array.prototype.forEach.call(document.querySelectorAll('.lk-seg [data-alinh]'), function (x) { var on = x === b; x.setAttribute('aria-checked', String(on)); x.setAttribute('aria-pressed', String(on)); });
        alinh.value = b.getAttribute('data-alinh'); prev.setAttribute('data-alinh', alinh.value);
      });
    });
    document.getElementById('lk-ap-arquivo').addEventListener('change', function () {
      var f = this.files && this.files[0]; if (!f) return;
      var img = document.getElementById('lk-ap-img'); img.src = URL.createObjectURL(f); img.hidden = false;
      document.getElementById('lk-ap-ini').hidden = true; document.getElementById('lk-ap-sem').hidden = true;
    });
  })();
</script>
