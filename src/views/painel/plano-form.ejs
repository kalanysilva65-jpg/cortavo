<%/* Plano em página inteira (/planos/novo e /:id/editar, para onde os erros
     de validação redirecionam), no v3. Mesmos campos e rotas. */%>
<% var marcados = plano && plano.servicos ? plano.servicos.map(function (x) { return x.servicoId; }) : []; %>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup"><a href="/painel/planos" style="color:inherit">Planos</a></p><h1><%= plano ? plano.nome : 'Novo plano' %></h1></div></header>
<div class="cv-secao" style="margin-top:16px">
  <form method="POST" class="cv-cartao cv-pl-form" action="<%= plano ? '/painel/planos/' + plano.id : '/painel/planos' %>">
    <div class="cv-campo"><label for="nome">Nome</label><input class="cv-entrada" id="nome" name="nome" value="<%= plano ? plano.nome : '' %>" required autofocus /></div>
    <div class="cv-campo"><label for="tipo">Tipo de uso</label><select class="cv-entrada" id="tipo" name="tipo"><option value="limitado"<%= plano && plano.tipo === 'limitado' ? ' selected' : '' %>>Limitado (número de usos)</option><option value="ilimitado"<%= plano && plano.tipo === 'ilimitado' ? ' selected' : '' %>>Ilimitado</option></select></div>
    <fieldset class="cv-campo"><legend class="cv-rotulo">Serviços inclusos e usos por mês</legend>
      <% servicos.forEach(function (s) { var ps = plano && plano.servicos ? plano.servicos.filter(function (x) { return x.servicoId === s.id; })[0] : null; %>
        <div class="cv-consumo-linha"><label class="cv-chave" style="flex:1;min-height:44px"><span><%= s.nome %></span><input type="checkbox" name="servicoIds" value="<%= s.id %>"<%= marcados.indexOf(s.id) !== -1 ? ' checked' : '' %> /></label><input class="cv-entrada cv-entrada--num" type="number" min="1" max="999" name="usosServ_<%= s.id %>" value="<%= ps && ps.usos ? ps.usos : 1 %>" aria-label="Usos de <%= s.nome %> por mês" /></div>
      <% }) %>
      <span class="cv-ajuda">Sem nenhum marcado, o plano vale para qualquer serviço.</span>
    </fieldset>
    <div class="cv-dupla" style="margin-top:14px">
      <div class="cv-campo" id="campo-usos"><label for="usos">Usos</label><input class="cv-entrada cv-entrada--num" id="usos" name="usos" type="number" min="1" value="<%= plano && plano.usos ? plano.usos : '' %>" /></div>
      <div class="cv-campo"><label for="validadeDias">Validade (dias)</label><input class="cv-entrada cv-entrada--num" id="validadeDias" name="validadeDias" type="number" min="1" value="<%= plano ? plano.validadeDias : 30 %>" /></div>
    </div>
    <div class="cv-campo"><label for="valor">Preço, em reais</label><input class="cv-entrada cv-entrada--num" id="valor" name="valor" type="number" step="0.01" min="0" inputmode="decimal" value="<%= plano ? (plano.valor / 100).toFixed(2) : '' %>" /><span class="cv-ajuda">Entra como entrada no caixa quando o cliente adquire o plano.</span></div>
    <button class="cv-btn cv-btn--largo cv-acao-fixa" type="submit"><%= plano ? 'Salvar' : 'Criar plano' %></button>
  </form>
</div>
<script>
  (function () { var t = document.getElementById('tipo'), u = document.getElementById('campo-usos'); function f() { u.hidden = t.value === 'ilimitado'; } t.addEventListener('change', f); f(); })();
  // Usos por serviço só aparecem com o serviço ligado (revisão Dani P3 #24).
  (function () { Array.prototype.forEach.call(document.querySelectorAll('.cv-consumo-linha'), function (l) { var c = l.querySelector('input[type=checkbox]'), n = l.querySelector('input[type=number]'); if (!c || !n) return; function f() { n.hidden = !c.checked; } c.addEventListener('change', f); f(); }); })();
</script>
