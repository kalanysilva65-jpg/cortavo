<%/* Equipe (redesign v3). Sem mockup próprio: o sistema da Dani aplicado
     com o mesmo rigor. Segmento Barbeiros / Histórico; a ficha do barbeiro
     sobe em folha, com o objeto preto dos números do mês; foto, nome público,
     descrição, acessos e comissão no mesmo formulário de sempre
     (/painel/equipe/:id, multipart). Mesmas rotas e campos. */%>
<%
  var PAPEL_LABEL = { admin: 'Administrador', funcionario: 'Barbeiro' };
  var dinheiro = function (c, tam) { return include('../partials/dinheiro', { cvC: c, cvTam: tam || 'p' }); };
  var fechar = include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' });
%>
<header class="cv-cab">
  <div class="cv-cab-txt"><p class="cv-cab-sup"><%= membros.length %> <%= membros.length === 1 ? 'pessoa' : 'pessoas' %></p><h1>Equipe</h1></div>
  <div class="cv-cab-acoes"><button class="cv-btn" type="button" data-abrir-folha="eq-folha-novo"><%- include('../partials/icone', { cvIc: 'clienteMais', cvCls: 'cv-ic--18' }) %>Novo</button></div>
</header>

<div class="cv-secao" style="margin-top:16px">
  <div class="cv-seg" role="tablist" aria-label="Equipe">
    <button type="button" role="tab" id="eq-aba-equipe" aria-controls="eq-painel-equipe" aria-selected="<%= aba === 'equipe' %>" aria-pressed="<%= aba === 'equipe' %>" data-aba="equipe">Barbeiros</button>
    <button type="button" role="tab" id="eq-aba-historico" aria-controls="eq-painel-historico" aria-selected="<%= aba === 'historico' %>" aria-pressed="<%= aba === 'historico' %>" data-aba="historico">Histórico</button>
  </div>
</div>

<section class="cv-secao" style="margin-top:14px" id="eq-painel-equipe" role="tabpanel" aria-labelledby="eq-aba-equipe"<% if (aba !== 'equipe') { %> hidden<% } %>>
  <% if (membros.length === 0) { %>
    <div class="cv-cartao cv-vazio" role="status"><h2>Ninguém na equipe ainda</h2><p>Cada barbeiro cadastrado aparece na agenda e no link de agendamento.</p><div class="acoes"><button class="cv-btn" type="button" data-abrir-folha="eq-folha-novo">Adicionar barbeiro</button></div></div>
  <% } else { %>
    <ul class="cv-lista">
      <% membros.forEach(function (m) { %>
        <li><button type="button" class="cv-linha" data-abrir-folha="eq-folha-<%= m.id %>">
          <span class="cv-avatar cv-avatar--claro" aria-hidden="true"><% if (m.fotoUrl) { %><img src="<%= m.fotoUrl %>" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" /><% } else { %><%= m.iniciais %><% } %></span>
          <span class="corpo"><span class="t"><%= m.nome %><% if (!m.ativo) { %> <span class="cv-etq cv-etq--listra">inativo</span><% } %></span><span class="s"><%= PAPEL_LABEL[m.papel] || m.papel %> · <%= m.comissaoPercentual %>% de comissão</span></span>
          <span class="fim"><b><%= m.stats.ocupacaoPct === null ? '—' : m.stats.ocupacaoPct + '%' %></b><small>ocupação</small></span>
        </button></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%/* Histórico: quem atendeu quem, de relance. A comissão por período fica em
     Comissões. */%>
<section class="cv-secao" style="margin-top:14px" id="eq-painel-historico" role="tabpanel" aria-labelledby="eq-aba-historico"<% if (aba !== 'historico') { %> hidden<% } %>>
  <% if (historico.length === 0) { %>
    <div class="cv-cartao cv-vazio" role="status"><h2>Nenhum atendimento concluído</h2><p>Aqui fica o histórico de atendimentos de cada barbeiro. Ele começa quando você conclui um atendimento na agenda.</p><div class="acoes"><a class="cv-btn cv-btn--2" href="/painel/agenda">Abrir a agenda</a></div></div>
  <% } else { %>
    <ul class="cv-lista cv-lista--sem-ic">
      <% historico.forEach(function (h) { %>
        <li><div class="cv-linha">
          <span style="width:52px;flex-shrink:0;font-variant-numeric:tabular-nums"><b style="display:block;font-size:15px"><%= h.hora %></b><small style="color:var(--c-apoio);font-size:12px"><%= fmtData(h.data).slice(0, 5) %></small></span>
          <span class="corpo"><span class="t"><%= h.cliente %></span><span class="s"><%= h.item %> · <%= h.barbeiro %></span></span>
          <span class="fim"><b><%- dinheiro(h.valor) %></b></span>
        </div></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%/* Novo barbeiro: só o nome (pedido do dono, 2026-07-28). O acesso por link
     é enviado pelo painel-mestre. */%>
<section class="cv-folha" id="eq-folha-novo" data-folha role="dialog" aria-modal="true" aria-labelledby="eq-novo-t">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="eq-novo-t" tabindex="-1" data-foco>Novo barbeiro</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- fechar %></button></div></div>
  <div class="cv-folha-corpo">
    <form method="POST" action="/painel/equipe">
      <div class="cv-campo"><label for="eq-novo-nome">Nome</label><input class="cv-entrada" id="eq-novo-nome" name="nome" placeholder="Nome completo" autocomplete="off" required /></div>
      <button type="submit" class="cv-btn cv-btn--largo">Adicionar</button>
    </form>
  </div>
</section>

<% membros.forEach(function (m) { %>
<section class="cv-folha" id="eq-folha-<%= m.id %>" data-folha role="dialog" aria-modal="true" aria-labelledby="eq-t-<%= m.id %>">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="eq-t-<%= m.id %>" tabindex="-1" data-foco><%= m.nome %></h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- fechar %></button></div></div>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= m.ativo ? (PAPEL_LABEL[m.papel] || m.papel) : 'Inativo' %> · <%= m.jornadaLabel %></p>
    <section class="cv-objeto cv-gravada" aria-label="Números do mês" style="margin-bottom:18px">
      <div class="cv-tres">
        <div><%- dinheiro(m.stats.faturado, 'm') %><span class="rot">faturamento</span></div>
        <div><span class="cv-num"><%= m.stats.atendimentos %></span><span class="rot">atendimentos</span></div>
        <div><span class="cv-num"><%= m.stats.ocupacaoPct === null ? '—' : m.stats.ocupacaoPct + '%' %></span><span class="rot">ocupação</span></div>
      </div>
    </section>

    <form method="POST" enctype="multipart/form-data" action="/painel/equipe/<%= m.id %>">
      <div class="cv-eq-foto">
        <label class="cv-eq-foto-img" for="eq-foto-<%= m.id %>"><% if (m.fotoUrl) { %><img src="<%= m.fotoUrl %>" alt="" /><% } else { %><%- include('../partials/icone', { cvIc: 'camera' }) %><% } %><span class="cv-oculto">Trocar foto</span></label>
        <div><input class="cv-oculto" id="eq-foto-<%= m.id %>" name="foto" type="file" accept="image/*" onchange="eqFotoEscolhida(this, <%= m.id %>)" /><b>Foto</b><small id="eq-foto-dica-<%= m.id %>">Toque na foto para trocar</small>
          <% if (m.fotoUrl) { %><button type="submit" class="cv-perigo-link" formaction="/painel/equipe/<%= m.id %>/foto/remover" formmethod="post" formnovalidate onclick="return confirm('Remover esta foto?')">Remover foto</button><% } %>
        </div>
      </div>
      <div class="cv-campo"><label for="eq-nome-<%= m.id %>">Nome</label><input class="cv-entrada" id="eq-nome-<%= m.id %>" name="nome" value="<%= m.nome %>" required /></div>
      <div class="cv-campo"><label for="eq-np-<%= m.id %>">Nome no agendamento público</label><input class="cv-entrada" id="eq-np-<%= m.id %>" name="nomePublico" maxlength="40" value="<%= m.nomePublico || '' %>" placeholder="<%= m.nome %>" autocomplete="off" /><span class="cv-ajuda">Como o cliente vê ao agendar. Em branco, usa o nome do cadastro.</span></div>
      <div class="cv-campo"><label for="eq-desc-<%= m.id %>">Descrição no agendamento</label><textarea class="cv-entrada" id="eq-desc-<%= m.id %>" name="descricao" rows="2" maxlength="120" placeholder="Ex.: Especialista em degradê e barba desenhada"><%= m.descricao || '' %></textarea></div>

      <div class="cv-campo">
        <span class="cv-rotulo">Como aparece no agendamento</span>
        <div class="cv-eq-prev<%= m.fotoUrl ? '' : ' sem-foto' %>" id="eq-prev-<%= m.id %>" data-pos="<%= m.fotoPos || '50% 50%' %>">
          <% if (m.fotoUrl) { %><img id="eq-prev-img-<%= m.id %>" src="<%= m.fotoUrl %>" alt="" style="object-position: <%= m.fotoPos || '50% 50%' %>" /><% } else { %><img id="eq-prev-img-<%= m.id %>" alt="" hidden /><span class="vazia" aria-hidden="true"><svg viewBox="0 0 64 64" width="96" height="96"><circle cx="32" cy="24" r="12" fill="#C9C9C9"/><path d="M8 64c0-14 11-22 24-22s24 8 24 22z" fill="#C9C9C9"/></svg></span><% } %>
          <span class="nome" aria-hidden="true"><b><%= m.nomePublico || m.nome %></b><small><%= m.descricao || 'Barbeiro' %></small></span>
        </div>
        <span class="cv-ajuda" id="eq-prev-dica-<%= m.id %>"<% if (!m.fotoUrl) { %> hidden<% } %>>Arraste a foto para enquadrar.</span>
        <input type="hidden" name="fotoPos" id="eq-fotopos-<%= m.id %>" value="<%= m.fotoPos || '50% 50%' %>" />
      </div>

      <div class="cv-campo"><label for="eq-com-<%= m.id %>">Comissão sobre serviços, em %</label><input class="cv-entrada cv-entrada--num" id="eq-com-<%= m.id %>" name="comissaoPercentual" type="number" min="0" max="100" step="0.1" inputmode="decimal" value="<%= m.comissaoPercentual %>" /><span class="cv-ajuda">A comissão de produto é por produto, na tela de Produtos.</span></div>

      <% if (m.papel === 'funcionario') { %>
        <fieldset class="cv-campo cv-eq-acessos"><legend class="cv-rotulo">O que este barbeiro pode acessar</legend>
          <input type="hidden" name="acessosForm" value="1" />
          <% modulosAcesso.forEach(function (mod) { %>
            <label class="cv-chave"><span><%= mod.rotulo %></span><input type="checkbox" name="acesso_<%= mod.chave %>" value="1" <%= m.bloqueados.has(mod.chave) ? '' : 'checked' %> /></label>
          <% }) %>
          <span class="cv-ajuda">A agenda dele está sempre liberada. Caixa, relatórios, metas e equipe são só do administrador.</span>
        </fieldset>
      <% } %>
      <button type="submit" class="cv-btn cv-btn--largo">Salvar alterações</button>
    </form>

    <div class="cv-folha-sec"><h3>Desempenho no mês</h3>
      <ul class="cv-linhas">
        <li><span>Comissão a receber</span><b><%- dinheiro(m.stats.comissaoReceber) %></b></li>
        <li><span>Ticket médio</span><b><%- dinheiro(m.stats.ticketMedio) %></b></li>
        <li><span>Clientes atendidos</span><b><%= m.stats.clientesAtendidos %></b></li>
        <li><span>Taxa de retorno</span><b><%= m.stats.taxaRetorno === null ? '—' : m.stats.taxaRetorno + '%' %></b></li>
        <li><span>Serviço mais feito</span><b><%= m.stats.servicoTop || '—' %></b></li>
        <li><span>Produtos vendidos</span><b><%= m.stats.produtosVendidos %></b></li>
      </ul>
    </div>

    <form method="POST" action="/painel/equipe/<%= m.id %>/toggle" class="cv-folha-acoes"<% if (m.ativo) { %> data-confirmar="Desativar <%= m.nome %>? Ele some da agenda e do link."<% } %>>
      <button type="submit" class="cv-btn cv-btn--2 cv-btn--largo"><%= m.ativo ? 'Desativar membro' : 'Ativar membro' %></button>
    </form>
  </div>
</section>
<% }) %>

<script>
  // Segmento Barbeiros / Histórico: as duas listas já vêm prontas.
  (function () {
    var abas = document.querySelectorAll('[data-aba]');
    Array.prototype.forEach.call(abas, function (b) {
      b.addEventListener('click', function () {
        Array.prototype.forEach.call(abas, function (x) { var on = x === b; x.setAttribute('aria-selected', String(on)); x.setAttribute('aria-pressed', String(on)); });
        document.getElementById('eq-painel-equipe').hidden = b.dataset.aba !== 'equipe';
        document.getElementById('eq-painel-historico').hidden = b.dataset.aba !== 'historico';
      });
    });
  })();
  function eqAbrirFolha(id) { if (window.cvAbrirFolha) window.cvAbrirFolha('eq-folha-' + id); }
  // Foto escolhida: avisa e atualiza a prévia do agendamento (enquadramento zerado).
  function eqFotoEscolhida(input, id) {
    var arq = input.files && input.files[0], dica = document.getElementById('eq-foto-dica-' + id);
    if (dica && arq) dica.textContent = 'Nova foto: ' + arq.name;
    if (!arq) return;
    var leitor = new FileReader();
    leitor.onload = function (ev) {
      var img = document.getElementById('eq-prev-img-' + id), box = document.getElementById('eq-prev-' + id);
      if (img) { img.src = ev.target.result; img.hidden = false; img.style.objectPosition = '50% 50%'; }
      if (box) { box.setAttribute('data-pos', '50% 50%'); var v = box.querySelector('.vazia'); if (v) v.remove(); box.classList.remove('sem-foto'); }
      document.getElementById('eq-fotopos-' + id).value = '50% 50%';
      document.getElementById('eq-prev-dica-' + id).hidden = false;
    };
    leitor.readAsDataURL(arq);
  }
  // Enquadramento por arraste (object-position), salvo em fotoPos.
  (function () {
    function limita(v) { return Math.max(0, Math.min(100, v)); }
    Array.prototype.forEach.call(document.querySelectorAll('.cv-eq-prev'), function (box) {
      var id = box.id.replace('eq-prev-', ''), img = document.getElementById('eq-prev-img-' + id), hid = document.getElementById('eq-fotopos-' + id);
      var m = /(\d+)%\s+(\d+)%/.exec(box.getAttribute('data-pos') || ''), px = m ? +m[1] : 50, py = m ? +m[2] : 50;
      var arr = false, sx = 0, sy = 0, spx = 0, spy = 0;
      function aplica() { var v = Math.round(px) + '% ' + Math.round(py) + '%'; if (img) img.style.objectPosition = v; if (hid) hid.value = v; }
      box.addEventListener('pointerdown', function (e) { if (!img || !img.getAttribute('src')) return; arr = true; sx = e.clientX; sy = e.clientY; spx = px; spy = py; e.stopPropagation(); try { box.setPointerCapture(e.pointerId); } catch (_) {} });
      box.addEventListener('pointermove', function (e) { if (!arr) return; var r = box.getBoundingClientRect(); px = limita(spx - (e.clientX - sx) / r.width * 100); py = limita(spy - (e.clientY - sy) / r.height * 100); aplica(); });
      function fim() { arr = false; }
      box.addEventListener('pointerup', fim); box.addEventListener('pointercancel', fim);
    });
  })();
</script>
