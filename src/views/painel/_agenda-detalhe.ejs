<%/* Miolo da folha de detalhe de UM atendimento (redesign v3, F4).

     Renderizado em dois momentos: junto da agenda (carga inicial) e sozinho,
     por GET /painel/agenda/:id/detalhe, quando a folha se redesenha depois de
     uma ação. Por isso recebe tudo explicitamente (ag, selo, dataStr,
     barbeiroSelecionado, diaNum, mesCurto, formasPagamento, servicos,
     maxParcelas) e não tem script: o comportamento mora em public/js/cv-agenda.js,
     por delegação nos atributos data-* (data-pagto, data-concluir, data-reabrir,
     data-faltou, data-cancelar, data-excluir, data-add-item, data-remover-item,
     data-item-valor, data-total-valor, data-total-auto, data-item-abas). */%>
<%
  var svcLabel = ag.itens.map(function (it) { return it.servico.nome; }).join(' + ') || 'Atendimento';
  var pagos = (ag.pagamentos || []).map(function (p) { return { forma: p.formaPagamento, valor: p.valor, parcelas: p.parcelas }; });
  // Sem divisão gravada, mas com a forma antiga: mostra como uma parte só.
  if (!pagos.length && ag.formaPagamento) pagos = [{ forma: ag.formaPagamento, valor: ag.valorTotal, parcelas: 1 }];
  function _rotuloForma(v) { var a = formasPagamento.filter(function (f) { return f.valor === v; })[0]; return a ? a.label : v; }
  function _reais(c) { return ((c || 0) / 100).toFixed(2).replace('.', ','); }
  // Total ajustado à mão: a soma dos itens fica na legenda, com atalho para voltar a segui-la.
  var somaItens = ag.itens.reduce(function (s, it) { return s + (it.valorUnitario || 0) * it.quantidade; }, 0);
  var totalAjustado = !!ag.totalManual;
  var aberto = ag.status === 'agendado';
  var EST = { 'Concluído': 'check', 'Faltou': 'faltou', 'Cancelado': 'fechar' };
  var _telefone = (typeof fmtTelefone === 'function') ? fmtTelefone(ag.clienteTelefone) : ag.clienteTelefone;
  var _svcOpts = servicos.filter(function (s) { return !s.ehProduto; }).map(function (s) { return { id: s.id, label: s.nome + ', R$ ' + _reais(s.valor) }; });
  var _prodOpts = servicos.filter(function (s) { return s.ehProduto; }).map(function (s) { return { id: s.id, label: s.nome + ', R$ ' + _reais(s.valor) }; });
%>
<div class="cv-ag-det-cab">
  <h2 id="agm-tit-<%= ag.id %>" tabindex="-1" data-foco><%= ag.clienteNome %></h2>
  <span class="cv-etiqueta<%= selo === 'Agora' ? ' cv-etiqueta--preta' : '' %>"><% if (EST[selo]) { %><%- include('../partials/icone', { cvIc: EST[selo], cvCls: 'cv-ic--16' }) %><% } %><%= selo %></span>
</div>
<p class="cv-ag-det-sub"><%= diaNum %> <%= mesCurto %>, <%= ag.horaInicio %></p>

<ul class="cv-lista cv-lista--sem-ic cv-ag-det-info">
  <li><div class="cv-linha"><span class="corpo"><span class="s">Serviço</span><span class="t"><%= svcLabel %></span></span></div></li>
  <% if (ag.clientePlanoId) { %>
    <li><div class="cv-linha"><span class="corpo"><span class="s">Plano</span><span class="t">Pelo plano<% if (ag.clientePlano && ag.clientePlano.plano) { %> <%= ag.clientePlano.plano.nome %><% } %>, sem custo do serviço coberto</span></span><%- include('../partials/icone', { cvIc: 'check', cvCls: 'cv-ic--18' }) %></div></li>
  <% } %>
  <li><div class="cv-linha"><span class="corpo"><span class="s">Barbeiro</span><span class="t"><%= ag.usuario.nome %></span></span></div></li>
  <li><div class="cv-linha"><span class="corpo"><span class="s">Contato</span><span class="t"><%= _telefone %></span></span></div></li>
</ul>

<section class="cv-objeto cv-gravada cv-ag-det-total" aria-label="Total a receber">
  <span class="rot">Total a receber</span>
  <label class="cv-ag-total-edit"><span class="moeda" aria-hidden="true">R$</span><input type="text" inputmode="decimal" data-total-valor value="<%= _reais(ag.valorTotal) %>" aria-label="Total a receber, em reais" /></label>
  <p class="rot cv-ag-det-total-sub">
    <% if (totalAjustado) { %>Valor combinado. Os itens somam <%= fmtBRL(somaItens) %>. <button type="button" class="cv-ag-link-claro" data-total-auto>Usar a soma</button>
    <% } else { %><%= svcLabel %>, com <%= ag.usuario.nome.split(' ')[0] %><% } %>
  </p>

  <% if (aberto) { %>
    <%/* A divisão é montada pelo script; "Concluir" manda tudo junto. A forma
         é obrigatória para concluir, menos em atendimento de valor zero. */%>
    <div class="cv-ag-pagto" data-pagto data-ag="<%= ag.id %>" data-total="<%= ag.valorTotal %>" data-max-parcelas="<%= maxParcelas %>"
         data-formas='<%- JSON.stringify(formasPagamento).replace(/'/g, "&#39;") %>' data-parcelaveis='["credito"]' data-inicial='<%- JSON.stringify(pagos) %>'>
      <div class="cv-ag-pagto-topo"><span class="rot">Pagamento</span><span class="cv-ag-pagto-saldo" data-saldo aria-live="polite"></span></div>
      <div class="cv-ag-pagto-linhas" data-linhas></div>
      <button type="button" class="cv-ag-link-claro" data-add>Dividir em outra forma</button>
    </div>
    <button type="button" class="cv-btn cv-btn--largo cv-ag-concluir" data-concluir>Concluir atendimento</button>
  <% } else { %>
    <% if (ag.status === 'concluido' && pagos.length) { %>
      <ul class="cv-ag-pagos">
        <% pagos.forEach(function (p) { %><li><span><%= _rotuloForma(p.forma) %><%= p.parcelas > 1 ? ', ' + p.parcelas + 'x' : '' %></span><b><%= fmtBRL(p.valor) %></b></li><% }) %>
      </ul>
    <% } %>
    <button type="button" class="cv-btn cv-btn--2 cv-btn--largo cv-ag-reabrir" data-reabrir><%= ag.status === 'concluido' ? 'Concluído. Reabrir' : (selo + '. Reabrir') %></button>
  <% } %>
</section>

<section class="cv-ag-det-itens" aria-labelledby="agm-itens-<%= ag.id %>">
  <h3 id="agm-itens-<%= ag.id %>">Itens</h3>
  <%/* O preço muda só neste atendimento (desconto, cortesia); o catálogo fica igual.
       O campo é o valor UNITÁRIO; com quantidade maior que 1, o total da linha aparece ao lado. */%>
  <ul class="cv-lista cv-lista--sem-ic">
    <% ag.itens.forEach(function (it) { %>
      <li><div class="cv-linha cv-ag-item">
        <span class="corpo"><span class="t"><%= it.servico.nome %><%= it.quantidade > 1 ? ' ×' + it.quantidade : '' %></span><% if (it.quantidade > 1) { %><span class="s"><%= fmtBRL((it.valorUnitario || 0) * it.quantidade) %> no total</span><% } %></span>
        <label class="cv-ag-item-valor"><span aria-hidden="true">R$</span><input type="text" inputmode="decimal" data-item-valor="<%= it.id %>" value="<%= _reais(it.valorUnitario) %>" aria-label="Valor de <%= it.servico.nome %> neste atendimento" /></label>
        <button type="button" class="cv-redondo cv-redondo--leve" data-remover-item="<%= it.id %>" aria-label="Remover <%= it.servico.nome %>"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--16' }) %></button>
      </div></li>
    <% }) %>
    <% if (!ag.itens.length) { %><li><div class="cv-linha"><span class="corpo"><span class="s">Sem itens.</span></span></div></li><% } %>
  </ul>

  <div class="cv-seg cv-ag-abas" data-item-abas role="group" aria-label="Tipo de item">
    <button type="button" class="cv-ag-aba" data-aba="servico" aria-pressed="true">Serviços</button>
    <button type="button" class="cv-ag-aba" data-aba="produto" aria-pressed="false">Produtos</button>
  </div>
  <div class="cv-ag-add">
    <label class="cv-campo"><span class="cv-rotulo">Adicionar</span>
      <select class="cv-entrada" data-novo-servico data-opts-servico='<%- JSON.stringify(_svcOpts).replace(/'/g, "&#39;") %>' data-opts-produto='<%- JSON.stringify(_prodOpts).replace(/'/g, "&#39;") %>'>
        <option value="">Serviço…</option>
        <% _svcOpts.forEach(function (o) { %><option value="<%= o.id %>"><%= o.label %></option><% }) %>
      </select>
    </label>
    <label class="cv-campo cv-ag-qtd"><span class="cv-rotulo">Qtd</span><input type="number" value="1" min="1" class="cv-entrada" data-nova-qtd /></label>
    <button type="button" class="cv-btn cv-btn--2 cv-btn--p" data-add-item aria-label="Adicionar item"><%- include('../partials/icone', { cvIc: 'mais', cvCls: 'cv-ic--18' }) %></button>
  </div>
</section>

<section class="cv-ag-risco" aria-labelledby="agm-risco-<%= ag.id %>">
  <h3 id="agm-risco-<%= ag.id %>">Zona de risco</h3>
  <div class="cv-ag-risco-acoes">
    <% if (aberto) { %><button type="button" class="cv-btn cv-btn--2 cv-btn--p" data-faltou><%- include('../partials/icone', { cvIc: 'faltou', cvCls: 'cv-ic--18' }) %>Faltou</button><% } %>
    <% if (ag.status !== 'cancelado') { %><button type="button" class="cv-btn cv-btn--2 cv-btn--p cv-ag-perigo" data-cancelar>Cancelar atendimento</button><% } %>
    <button type="button" class="cv-btn cv-btn--2 cv-btn--p cv-ag-perigo" data-excluir>Excluir</button>
  </div>
</section>
