<%/* Lista de conversas (v3). Usada na página e no /fragmento (atualização a
     cada 8 s). Auto-contida: define o próprio `inic`. */%>
<%
  function inic(nome) { var p = (nome || '?').trim().split(/\s+/); return ((p[0] || '?')[0] + (p[1] ? p[1][0] : '')).toUpperCase(); }
%>
<% if (!conversas || conversas.length === 0) { %>
  <div class="cv-cartao cv-vazio" role="status"><h2>Nenhuma conversa ainda</h2><p>Aqui chegam as mensagens dos clientes pelo WhatsApp da barbearia. Para começar, ligue o número na Secretária.</p><div class="acoes"><a class="cv-btn cv-btn--2" href="/painel/secretaria">Ligar o WhatsApp</a></div></div>
<% } else { %>
  <ul class="cv-lista">
    <% conversas.forEach(function (c) { %>
      <li data-item data-texto="<%= (c.nome || '').toLowerCase() %>"><a href="/painel/conversas?id=<%= c.id %>" class="cv-linha cv-cv-item">
        <span class="cv-avatar cv-avatar--claro" aria-hidden="true"><%= inic(c.nome) %></span>
        <span class="corpo"><span class="t"><%= c.nome %></span><span class="s"><%= c.previa %><% if (!c.iaAtiva) { %> · você assumiu<% } %></span></span>
        <span class="fim"><small><%= c.hora %></small><% if (c.naoLidas > 0) { %><span class="cv-cv-badge" aria-label="<%= c.naoLidas %> não lidas"><%= c.naoLidas %></span><% } %></span>
      </a></li>
    <% }) %>
  </ul>
<% } %>
