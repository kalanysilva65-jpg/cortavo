<%/* Perfil (redesign v3, F8): abre pelo cartão do topo da tela Mais.
     Foto (é o único lugar onde a pessoa troca a própria foto), conta, avisos
     no aparelho, backup (admin), a jornada editável (a mesma que o link de
     agendamento usa para oferecer horários) e Sair. Mesmos campos e IDs de
     antes; estilos em public/css/cv-secretaria.css (telas de ajustes). */%>
<%
  var cargo = ehDono ? 'Dono do sistema' : (usuario.papel === 'admin' ? 'Responsável' : 'Barbeiro');
  var partes = String(usuario.nome || '?').trim().split(/\s+/);
  var iniciais = ((partes[0] || '?')[0] + (partes.length > 1 ? partes[partes.length - 1][0] : '')).toUpperCase();
%>
<header class="cv-cab">
  <div class="cv-cab-txt">
    <a class="cv-cx-voltar" href="/painel/mais"><%- include('../partials/icone', { cvIc: 'esquerda', cvCls: 'cv-ic--20' }) %>Mais</a>
    <h1>Perfil</h1>
  </div>
</header>

<div class="cv-secao" style="margin-top:12px">
  <form method="POST" action="/painel/perfil/foto" enctype="multipart/form-data" class="cv-cartao cv-pf-cab">
    <label class="cv-pf-foto" title="Trocar a foto">
      <% if (usuarioFotoUrl) { %><img src="<%= usuarioFotoUrl %>" alt="Foto de <%= usuario.nome %>" /><% } else { %><span aria-hidden="true"><%= iniciais %></span><% } %>
      <input type="file" name="foto" accept="image/*" onchange="this.form.submit()" class="cv-oculto" aria-label="Trocar a foto" />
    </label>
    <div class="cv-pf-nome"><b><%= usuario.nome %></b><span><%= cargo %><%= barbeariaAtual ? ' na ' + barbeariaAtual.nome : '' %></span><span class="cv-ajuda">Toque na foto para trocar</span></div>
  </form>
  <% if (usuarioFotoUrl) { %>
    <form method="POST" action="/painel/perfil/foto/remover" class="cv-pf-remover">
      <button type="submit" class="cv-btn cv-btn--texto cv-btn--p" onclick="return confirm('Remover a sua foto de perfil?')">Remover foto</button>
    </form>
  <% } %>
</div>

<section class="cv-secao" aria-labelledby="pf-conta">
  <div class="cv-secao-cab"><h2 id="pf-conta">Conta</h2></div>
  <ul class="cv-lista cv-lista--sem-ic">
    <li><div class="cv-linha"><span class="corpo"><span class="s">Barbearia</span><span class="t"><%= barbeariaAtual ? barbeariaAtual.nome : '—' %></span></span></div></li>
    <li><div class="cv-linha"><span class="corpo"><span class="s">Função</span><span class="t"><%= cargo %></span></span></div></li>
    <% if (usuario.barbeariaId) { %><li><div class="cv-linha"><span class="corpo"><span class="s">Atendimentos concluídos</span><span class="t"><%= atendimentos %></span></span></div></li><% } %>
    <% if (ehAdmin && typeof planoCortavo !== 'undefined' && planoCortavo) { %>
      <li><a class="cv-linha" href="/painel/meu-plano"><span class="corpo"><span class="s">Meu plano</span><span class="t"><%= planoCortavo.nome %>, o que inclui e o uso do mês</span></span><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a></li>
      <li><a class="cv-linha" href="/painel/logo"><span class="corpo"><span class="s">Agendamento online</span><span class="t">Logo da barbearia no link</span></span><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a></li>
    <% } %>
  </ul>
</section>

<%/* Avisos no aparelho. A permissão só pode ser pedida a partir de um toque:
     por isso é um botão, não um interruptor que "já vem ligado". */%>
<section class="cv-secao" id="pf-avisos" aria-labelledby="pf-avisos-tit" hidden>
  <div class="cv-secao-cab"><h2 id="pf-avisos-tit">Avisos</h2><span class="cv-ajuda" id="pf-avisos-estado"></span></div>
  <div class="cv-cartao">
    <p class="cv-texto-apoio" id="pf-avisos-texto">Receba um aviso neste aparelho quando cair um agendamento novo na sua agenda.</p>
    <div class="cv-sec-botoes">
      <button type="button" class="cv-btn cv-btn--2" id="pf-avisos-ligar">Ativar avisos</button>
      <button type="button" class="cv-btn cv-btn--2" id="pf-avisos-testar" hidden>Enviar teste</button>
      <button type="button" class="cv-btn cv-btn--texto" id="pf-avisos-desligar" hidden>Desativar</button>
    </div>
  </div>
</section>

<% if (ehAdmin) { %>
  <%/* Backup manual (só admin: inclui financeiro e todos os clientes). O PDF é
       para ler e arquivar; o arquivo de dados é o que permite restaurar. */%>
  <section class="cv-secao" id="pf-backup" aria-labelledby="pf-backup-tit">
    <div class="cv-secao-cab"><h2 id="pf-backup-tit">Backup dos dados</h2></div>
    <div class="cv-cartao">
      <p class="cv-texto-apoio">Baixe uma cópia de todos os dados desta barbearia: clientes, agenda, caixa, catálogo, estoque e equipe. O <strong>PDF</strong> é para ler, imprimir e arquivar. O <strong>arquivo de dados</strong> é o que permite recuperar tudo caso algo se perca; guarde num lugar seguro.</p>
      <div class="cv-sec-botoes">
        <a class="cv-btn cv-btn--2" href="/painel/exportar/relatorio"><%- include('../partials/icone', { cvIc: 'exportar', cvCls: 'cv-ic--18' }) %>Abrir PDF</a>
        <a class="cv-btn cv-btn--texto" href="/painel/exportar/dados.json" download>Baixar dados (backup)</a>
      </div>
      <p class="cv-ajuda" style="margin-top:10px">Dica: faça pelo navegador (cortavo.com.br) para o download funcionar melhor.</p>
    </div>
  </section>
<% } %>

<% if (usuario.barbeariaId) { %>
  <%/* Jornada editável: é ela que o link de agendamento lê para oferecer
       horários. Os nomes dos campos (trabalha_<dia>, inicio_<dia>, fim_<dia>)
       são os que o horarioController espera. */%>
  <form method="POST" action="/painel/perfil/jornada" class="cv-secao" id="pf-jornada" aria-labelledby="pf-jornada-tit">
    <input type="hidden" name="retorno" value="perfil" />
    <div class="cv-secao-cab"><h2 id="pf-jornada-tit">Dias de trabalho</h2><span class="cv-ajuda" id="pf-conta-dias"><%= semana.dias ? semana.dias + ' dias' : 'nenhum dia' %></span></div>
    <div class="cv-pf-dias" role="group" aria-label="Dias em que você atende">
      <% jornada.forEach(function (d) { %>
        <label class="cv-pf-dia-caixa">
          <input type="checkbox" class="cv-oculto" name="trabalha_<%= d.dia %>" <%= d.trabalha ? 'checked' : '' %> onchange="pfAtualizarDia(this, <%= d.dia %>)" />
          <span class="sv-pf-dia cv-pf-dia <%= d.trabalha ? 'on' : '' %>"><%= d.label %></span>
        </label>
      <% }) %>
    </div>
    <ul class="cv-lista cv-lista--sem-ic cv-pf-horas">
      <% jornada.forEach(function (d) { %>
        <li><div class="cv-linha cv-pf-hora <%= d.trabalha ? '' : 'folga' %>" id="pf-hora-<%= d.dia %>">
          <span class="corpo"><span class="t"><%= d.label %></span></span>
          <input class="cv-entrada" type="time" name="inicio_<%= d.dia %>" value="<%= d.horaInicio %>" aria-label="Início <%= d.label %>" />
          <span class="cv-ajuda">às</span>
          <input class="cv-entrada" type="time" name="fim_<%= d.dia %>" value="<%= d.horaFim %>" aria-label="Fim <%= d.label %>" />
        </div></li>
      <% }) %>
    </ul>
    <p class="cv-ajuda" style="margin:10px 4px 0"><%= horarioTrabalho %></p>
    <section class="cv-objeto cv-gravada cv-pf-semana" aria-label="Sua semana"><span class="rot">Sua semana</span><b><%= semana.horas %></b><span class="rot"><%= semana.linha.replace(' · ', ', ') %></span></section>
    <button type="submit" class="cv-btn cv-btn--largo" style="margin-top:16px">Salvar jornada</button>
  </form>
<% } %>

<% if (ehDono) { %>
  <div class="cv-secao">
    <div class="cv-cartao cv-nota-dono">
      <span>Você está operando <strong><%= barbeariaAtual ? barbeariaAtual.nome : 'uma barbearia' %></strong> como dono do sistema.</span>
      <form method="POST" action="/mestre/sair"><button class="cv-btn cv-btn--2 cv-btn--p" type="submit"><%- include('../partials/icone', { cvIc: 'esquerda', cvCls: 'cv-ic--18' }) %>Voltar ao painel-mestre</button></form>
    </div>
  </div>
<% } %>

<div class="cv-secao">
  <form method="POST" action="/logout"><button class="cv-btn cv-btn--2 cv-btn--largo cv-pf-sair" type="submit"><%- include('../partials/icone', { cvIc: 'sair', cvCls: 'cv-ic--18' }) %>Sair da conta</button></form>
</div>

<script>
  // Marcar/desmarcar o dia reflete NA HORA no ladrilho e no cartão de horário
  // correspondente — sem isso o usuário só descobriria o efeito depois de
  // salvar. A contagem no topo acompanha pelo mesmo motivo.
  function pfAtualizarDia(input, dia) {
    var ladrilho = input.nextElementSibling;
    if (ladrilho) ladrilho.classList.toggle('on', input.checked);
    var cartao = document.getElementById('pf-hora-' + dia);
    if (cartao) cartao.classList.toggle('folga', !input.checked);
    var marcados = document.querySelectorAll('#pf-jornada input[type=checkbox]:checked').length;
    var conta = document.getElementById('pf-conta-dias');
    if (conta) conta.textContent = marcados ? marcados + (marcados === 1 ? ' dia' : ' dias') : 'nenhum dia';
  }
</script>

<script>
  // Avisos no aparelho (Web Push).
  //
  // A seção nasce escondida e só aparece se este navegador souber receber
  // avisos E o servidor tiver as chaves VAPID configuradas — oferecer um botão
  // que não tem como funcionar é pior do que não oferecer nada.
  //
  // A permissão só pode ser pedida a partir de um toque do usuário: navegador
  // nenhum concede no carregamento da página. Por isso "Ativar" é um botão de
  // verdade, e não um interruptor que tenta se ligar sozinho.
  (function () {
    var secao = document.getElementById('pf-avisos');
    if (!secao) return;

    var suportado = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
    if (!suportado) return;

    var btnLigar = document.getElementById('pf-avisos-ligar');
    var btnTestar = document.getElementById('pf-avisos-testar');
    var btnDesligar = document.getElementById('pf-avisos-desligar');
    var estado = document.getElementById('pf-avisos-estado');
    var texto = document.getElementById('pf-avisos-texto');
    var chavePublica = null;

    function base64ParaUint8(base64) {
      var pad = '='.repeat((4 - (base64.length % 4)) % 4);
      var b64 = (base64 + pad).replace(/-/g, '+').replace(/_/g, '/');
      var cru = atob(b64);
      var saida = new Uint8Array(cru.length);
      for (var i = 0; i < cru.length; i++) saida[i] = cru.charCodeAt(i);
      return saida;
    }

    function pintar(ligado) {
      estado.textContent = ligado ? 'ligados' : 'desligados';
      btnLigar.hidden = ligado;
      btnTestar.hidden = !ligado;
      btnDesligar.hidden = !ligado;
      texto.textContent = ligado
        ? 'Este aparelho vai avisar quando cair um agendamento novo na sua agenda.'
        : 'Receba um aviso neste aparelho quando cair um agendamento novo na sua agenda.';
    }

    function inscricaoAtual() {
      return navigator.serviceWorker.ready.then(function (reg) {
        return reg.pushManager.getSubscription();
      });
    }

    // Estado inicial: o navegador é a fonte da verdade sobre este aparelho.
    // O servidor sabe quantos aparelhos existem, mas não qual é este.
    fetch('/painel/notificacoes/chave', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (info) {
        if (!info.configurado) return; // servidor sem VAPID: seção segue escondida
        chavePublica = info.chave;
        secao.hidden = false;
        return inscricaoAtual().then(function (ins) {
          pintar(!!ins && Notification.permission === 'granted');
        });
      })
      .catch(function () { /* sem avisos: a seção só não aparece */ });

    btnLigar.addEventListener('click', function () {
      btnLigar.disabled = true;
      Notification.requestPermission()
        .then(function (permissao) {
          if (permissao !== 'granted') {
            // Negado é decisão do usuário; explicar onde reverter é mais útil
            // do que insistir (o navegador não pergunta duas vezes).
            texto.textContent =
              'Os avisos foram bloqueados para este site. Para reativar, libere as notificações nas configurações do navegador e volte aqui.';
            throw new Error('permissao negada');
          }
          return navigator.serviceWorker.ready;
        })
        .then(function (reg) {
          return reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: base64ParaUint8(chavePublica),
          });
        })
        .then(function (ins) {
          return fetch('/painel/notificacoes/inscrever', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ inscricao: ins.toJSON(), plataforma: 'web' }),
          });
        })
        .then(function (r) { if (!r.ok) throw new Error('falha ao registrar'); return r.json(); })
        .then(function () { pintar(true); })
        .catch(function () { /* o texto já explica */ })
        .then(function () { btnLigar.disabled = false; });
    });

    btnDesligar.addEventListener('click', function () {
      btnDesligar.disabled = true;
      inscricaoAtual()
        .then(function (ins) {
          if (!ins) return null;
          var endpoint = ins.endpoint;
          // Cancela nos dois lados: só no navegador deixaria o servidor
          // mandando para um endereço morto; só no servidor deixaria o
          // navegador achando que está inscrito.
          return ins.unsubscribe().then(function () {
            return fetch('/painel/notificacoes/cancelar', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ endpoint: endpoint }),
            });
          });
        })
        .then(function () { pintar(false); })
        .catch(function () { /* silêncio: o estado é repintado ao reabrir */ })
        .then(function () { btnDesligar.disabled = false; });
    });

    btnTestar.addEventListener('click', function () {
      btnTestar.disabled = true;
      var rotulo = btnTestar.textContent;
      fetch('/painel/notificacoes/testar', { method: 'POST', credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          btnTestar.textContent = j.entregues > 0 ? 'Enviado' : 'Nenhum aparelho';
        })
        .catch(function () { btnTestar.textContent = 'Falhou'; })
        .then(function () {
          setTimeout(function () { btnTestar.textContent = rotulo; btnTestar.disabled = false; }, 2200);
        });
    });
  })();
</script>
