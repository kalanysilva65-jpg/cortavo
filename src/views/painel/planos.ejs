<%/* Planos de assinatura (redesign v3). Sem mockup próprio: o sistema
     aplicado com rigor. O objeto preto é a receita recorrente (admin) ou o
     volume de planos (barbeiro, sem dinheiro). Cada plano é um cartão; dias e
     serviços viram chips (pressionado = vale), sem verde nem vermelho.
     Edição em folha, só para o admin. Mesmas rotas e campos. */%>
<%
  var ORDEM_SEMANA = [1, 2, 3, 4, 5, 6, 0];
  var NOME_DIA = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
  function _diasArr(d) { return String(d || '0,1,2,3,4,5,6').split(',').map(Number).filter(function (n) { return !isNaN(n); }); }
  var fechar = include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' });
  var dinheiro = function (c, tam) { return include('../partials/dinheiro', { cvC: c, cvTam: tam || 'p' }); };
%>
<header class="cv-cab">
  <div class="cv-cab-txt"><p class="cv-cab-sup">Cadastros</p><h1>Planos</h1></div>
  <% if (ehAdmin) { %><div class="cv-cab-acoes"><button class="cv-btn" type="button" data-abrir-folha="pl-folha-novo"><%- include('../partials/icone', { cvIc: 'mais', cvCls: 'cv-ic--18' }) %>Novo</button></div><% } %>
</header>

<div class="cv-secao" style="margin-top:16px">
  <section class="cv-objeto cv-gravada" aria-label="Resumo dos planos">
    <% if (ehAdmin) { %>
      <span class="rot" style="color:var(--c-sobre-objeto-2);font-size:14px;font-weight:600">Receita recorrente por mês</span>
      <div style="margin-top:6px"><%- dinheiro(resumo.mrr, 'g') %></div>
      <p style="margin:8px 0 0;font-size:14px;color:var(--c-sobre-objeto-2)"><%= resumo.assinantes %> <%= resumo.assinantes === 1 ? 'assinante' : 'assinantes' %><% if (resumo.assinantes) { %> · <%= fmtBRL(resumo.ticket) %> por assinante<% } %><% if (resumo.lider) { %> · <%= resumo.lider.nome %> lidera<% } %></p>
    <% } else { %>
      <span class="rot" style="color:var(--c-sobre-objeto-2);font-size:14px;font-weight:600">Planos ativos</span>
      <div style="margin-top:6px"><span class="cv-num cv-num--g"><%= resumo.ativos %></span></div>
      <p style="margin:8px 0 0;font-size:14px;color:var(--c-sobre-objeto-2)"><%= resumo.assinantes %> <%= resumo.assinantes === 1 ? 'assinante em dia' : 'assinantes em dia' %></p>
    <% } %>
  </section>
</div>

<section class="cv-secao" style="margin-top:14px" aria-label="Planos">
  <% if (planos.length === 0) { %>
    <div class="cv-cartao cv-vazio" role="status"><h2>Nenhum plano ainda</h2><p>Planos mensais fidelizam: o cliente paga por mês e marca pelo link usando o plano.</p></div>
  <% } else { %>
    <div class="cv-pl-lista">
      <% planos.forEach(function (p) {
           var ilim = p.tipo === 'ilimitado', dias = _diasArr(p.diasSemana);
           var comCota = !ilim && (p.servicos || []).some(function (x) { return x.usos; });
           var nomes = (p.servicos || []).map(function (x) { return (comCota && x.usos ? x.usos + 'x ' : '') + x.servico.nome; });
           var tag = ehAdmin ? 'button' : 'div'; %>
        <<%- tag %> class="cv-cartao cv-pl-card"<% if (ehAdmin) { %> type="button" data-abrir-folha="pl-folha-<%= p.id %>"<% } %>>
          <span class="topo"><span class="corpo"><b><%= p.nome %><% if (!p.ativo) { %> <span class="cv-etq cv-etq--listra">inativo</span><% } %></b><small><%= fmtBRL(p.valor) %> por mês · <%= ilim ? 'ilimitado' : (p.usos || 0) + ' usos por mês' %></small></span><span class="assin"><b><%= p.assinantes %></b><small><%= p.assinantes === 1 ? 'assinante' : 'assinantes' %></small></span></span>
          <span class="desc"><%= nomes.length ? nomes.join(' + ') : 'Qualquer serviço' %> · validade de <%= p.validadeDias %> dias</span>
          <span class="dias" aria-label="Dias: <%= ORDEM_SEMANA.filter(function (i) { return dias.indexOf(i) !== -1; }).map(function (i) { return NOME_DIA[i]; }).join(', ') %>"><% ORDEM_SEMANA.forEach(function (i) { %><i class="<%= dias.indexOf(i) !== -1 ? 'on' : '' %>" aria-hidden="true"><%= NOME_DIA[i].charAt(0) %></i><% }) %><% if (ehAdmin && p.assinantes) { %><em><%= fmtBRL(p.mrr) %> por mês</em><% } %></span>
        </<%- tag %>>
      <% }) %>
    </div>
  <% } %>
</section>

<% if (ehAdmin) { %>
<% function form(p) {
     var id = p ? p.id : 'novo', tipo = p ? p.tipo : 'limitado', dias = _diasArr(p ? p.diasSemana : null);
     var servIds = p ? (p.servicos || []).map(function (x) { return x.servicoId; }) : []; %>
  <form method="POST" action="<%= p ? '/painel/planos/' + p.id : '/painel/planos' %>" class="cv-pl-form" data-plano="<%= id %>">
    <div class="cv-campo"><label for="nome-<%= id %>">Nome</label><input class="cv-entrada" id="nome-<%= id %>" name="nome" value="<%= p ? p.nome : '' %>" placeholder="Ex.: Corte mensal" required /></div>
    <div class="cv-campo"><span class="cv-rotulo" id="tipo-rot-<%= id %>">Tipo de uso</span>
      <input type="hidden" name="tipo" value="<%= tipo %>" data-tipo />
      <div class="cv-seg" role="group" aria-labelledby="tipo-rot-<%= id %>" style="margin-top:6px"><button type="button" data-valor="limitado" aria-pressed="<%= tipo === 'limitado' %>">Limitado</button><button type="button" data-valor="ilimitado" aria-pressed="<%= tipo === 'ilimitado' %>">Ilimitado</button></div>
    </div>
    <div class="cv-dupla" style="margin-top:14px">
      <div class="cv-campo"><label for="valor-<%= id %>">Preço por mês, em reais</label><input class="cv-entrada cv-entrada--num" id="valor-<%= id %>" name="valor" type="number" step="0.01" min="0" inputmode="decimal" value="<%= p ? (p.valor / 100).toFixed(2) : '' %>" placeholder="0,00" /></div>
      <div class="cv-campo" data-usos<% if (tipo === 'ilimitado') { %> hidden<% } %>><label for="usos-<%= id %>">Usos por mês</label><input class="cv-entrada cv-entrada--num" id="usos-<%= id %>" name="usos" type="number" min="1" inputmode="numeric" value="<%= p ? (p.usos || 1) : 1 %>" /></div>
    </div>
    <div class="cv-campo"><span class="cv-rotulo" id="dias-rot-<%= id %>">Dias em que o plano vale</span>
      <input type="hidden" name="diasSemana" value="<%= dias.join(',') %>" data-dias />
      <div class="cv-chips" role="group" aria-labelledby="dias-rot-<%= id %>" style="margin-top:6px"><% ORDEM_SEMANA.forEach(function (i) { %><button type="button" class="cv-chip" data-dia="<%= i %>" aria-pressed="<%= dias.indexOf(i) !== -1 %>"><span><%= NOME_DIA[i] %></span></button><% }) %></div>
    </div>
    <div class="cv-campo"><span class="cv-rotulo" id="serv-rot-<%= id %>">Serviços inclusos</span>
      <input type="hidden" name="servicoIds" value="<%= servIds.join(',') %>" data-servs />
      <div class="cv-chips" role="group" aria-labelledby="serv-rot-<%= id %>" style="margin-top:6px"><% servicos.forEach(function (s) { %><button type="button" class="cv-chip" data-serv="<%= s.id %>" aria-pressed="<%= servIds.indexOf(s.id) !== -1 %>"><span><%= s.nome %></span></button><% }) %></div>
      <div class="cv-pl-qtds">
        <% servicos.forEach(function (s) { var ps = p ? (p.servicos || []).filter(function (x) { return x.servicoId === s.id; })[0] : null; var on = servIds.indexOf(s.id) !== -1 && tipo === 'limitado'; %>
          <label class="cv-consumo-linha" data-serv-qtd="<%= s.id %>"<% if (!on) { %> hidden<% } %>><span><%= s.nome %>, usos por mês</span><input class="cv-entrada cv-entrada--num" type="number" min="1" max="999" name="usosServ_<%= s.id %>" value="<%= ps && ps.usos ? ps.usos : 1 %>" /></label>
        <% }) %>
      </div>
      <span class="cv-ajuda">Sem nenhum marcado, o plano vale para qualquer serviço. No limitado, defina os usos de cada serviço (ex.: 2 cortes e 4 barbas).</span>
    </div>
    <div class="cv-campo"><label for="validadeDias-<%= id %>">Validade, em dias</label><input class="cv-entrada cv-entrada--num" id="validadeDias-<%= id %>" name="validadeDias" type="number" min="1" inputmode="numeric" value="<%= p ? p.validadeDias : 30 %>" /></div>
    <button class="cv-btn cv-btn--largo" type="submit"><%= p ? 'Salvar alterações' : 'Adicionar' %></button>
  </form>
<% } %>

<section class="cv-folha" id="pl-folha-novo" data-folha role="dialog" aria-modal="true" aria-labelledby="pl-novo-t">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="pl-novo-t" tabindex="-1" data-foco>Novo plano</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- fechar %></button></div></div>
  <div class="cv-folha-corpo"><% form(null) %></div>
</section>
<% planos.forEach(function (p) { %>
<section class="cv-folha" id="pl-folha-<%= p.id %>" data-folha role="dialog" aria-modal="true" aria-labelledby="pl-t-<%= p.id %>">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="pl-t-<%= p.id %>" tabindex="-1" data-foco><%= p.nome %></h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- fechar %></button></div></div>
  <div class="cv-folha-corpo">
    <% form(p) %>
    <div class="cv-folha-acoes cv-dupla">
      <form method="POST" action="/painel/planos/<%= p.id %>/toggle"><button class="cv-btn cv-btn--2 cv-btn--largo" type="submit"><%= p.ativo ? 'Desativar' : 'Ativar' %></button></form>
      <form method="POST" action="/painel/planos/<%= p.id %>/remover" data-confirmar="Excluir este plano?"><button class="cv-btn cv-btn--2 cv-txt-perigo cv-btn--largo" type="submit">Excluir</button></form>
    </div>
  </div>
</section>
<% }) %>

<script>
  // Tipo, dias e serviços: o estado fica nos campos ocultos de sempre.
  Array.prototype.forEach.call(document.querySelectorAll('.cv-pl-form'), function (f) {
    var tipo = f.querySelector('[data-tipo]'), dias = f.querySelector('[data-dias]'), servs = f.querySelector('[data-servs]'), usos = f.querySelector('[data-usos]');
    function qtds() {
      var algum = false;
      Array.prototype.forEach.call(f.querySelectorAll('[data-serv-qtd]'), function (l) {
        var b = f.querySelector('[data-serv="' + l.getAttribute('data-serv-qtd') + '"]');
        var on = tipo.value === 'limitado' && b.getAttribute('aria-pressed') === 'true';
        l.hidden = !on; if (on) algum = true;
      });
      usos.hidden = tipo.value === 'ilimitado' || algum;
    }
    function lista(sel, attr) { return Array.prototype.filter.call(f.querySelectorAll(sel), function (b) { return b.getAttribute('aria-pressed') === 'true'; }).map(function (b) { return b.getAttribute(attr); }).join(','); }
    Array.prototype.forEach.call(f.querySelectorAll('.cv-seg [data-valor]'), function (b) { b.addEventListener('click', function () {
      Array.prototype.forEach.call(f.querySelectorAll('.cv-seg [data-valor]'), function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      tipo.value = b.getAttribute('data-valor'); qtds();
    }); });
    Array.prototype.forEach.call(f.querySelectorAll('[data-dia]'), function (b) { b.addEventListener('click', function () { b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); dias.value = lista('[data-dia]', 'data-dia'); }); });
    Array.prototype.forEach.call(f.querySelectorAll('[data-serv]'), function (b) { b.addEventListener('click', function () { b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); servs.value = lista('[data-serv]', 'data-serv'); qtds(); }); });
    qtds();
  });
</script>
<% } %>
