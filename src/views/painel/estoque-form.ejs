<%/* Formulário avulso do estoque (/painel/estoque/novo e /:id/editar), no v3.
     A tela de Estoque usa folhas; esta página fica para links antigos. */%>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup"><a href="/painel/estoque" style="color:inherit">Estoque</a></p><h1><%= item ? 'Editar item' : 'Novo item' %></h1></div></header>
<div class="cv-secao" style="margin-top:16px">
  <form method="POST" class="cv-cartao" action="<%= item ? '/painel/estoque/' + item.id : '/painel/estoque' %>">
    <div class="cv-campo"><label for="nome">Nome</label><input class="cv-entrada" id="nome" name="nome" value="<%= item ? item.nome : '' %>" required autofocus /></div>
    <div class="cv-campo" style="margin-top:14px"><label for="categoriaId">Categoria</label><select class="cv-entrada" id="categoriaId" name="categoriaId"><option value="">Sem categoria</option><% categorias.forEach(function (c) { %><option value="<%= c.id %>"<%= item && item.categoriaId === c.id ? ' selected' : '' %>><%= c.nome %></option><% }) %></select></div>
    <div class="cv-dupla" style="margin-top:14px">
      <div class="cv-campo"><label for="quantidade">Quantidade</label><input class="cv-entrada cv-entrada--num" id="quantidade" name="quantidade" type="number" min="0" value="<%= item ? item.quantidade : 0 %>" /></div>
      <div class="cv-campo"><label for="quantidadeMinima">Avisar em</label><input class="cv-entrada cv-entrada--num" id="quantidadeMinima" name="quantidadeMinima" type="number" min="0" value="<%= item ? item.quantidadeMinima : 0 %>" /></div>
    </div>
    <div class="cv-campo" style="margin-top:14px"><label for="valorGasto">Valor gasto na compra, em reais</label><input class="cv-entrada cv-entrada--num" id="valorGasto" name="valorGasto" type="number" step="0.01" min="0" value="<%= item ? (item.valorGasto / 100).toFixed(2) : '' %>" placeholder="0,00" /></div>
    <button class="cv-btn cv-btn--largo" type="submit" style="margin-top:18px">Salvar</button>
    <a class="cv-btn cv-btn--texto cv-btn--largo" href="/painel/estoque">Cancelar</a>
  </form>
</div>
