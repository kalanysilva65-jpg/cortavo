<%/* Clientes (redesign v3). Sem mockup próprio: aplica o sistema da Dani
     (assinatura.md, componentes) com o mesmo rigor das telas prontas.
     - Celular: busca + filtros, o objeto preto com os 3 números da carteira e
       a lista em cartão. Ficha do cliente e "Novo cliente" sobem em folha.
     - PC (>= 1024): a lista vira tabela; a ficha é a mesma folha.
     Rotas, campos e regras de sempre (clienteController). */%>
<% var dinheiro = function (c, tam) { return include('../partials/dinheiro', { cvC: c, cvTam: tam || 'p' }); }; %>
<header class="cv-cab">
  <div class="cv-cab-txt"><p class="cv-cab-sup"><%= resumo.total %> <%= resumo.total === 1 ? 'cliente' : 'clientes' %></p><h1>Clientes</h1></div>
  <div class="cv-cab-acoes"><button class="cv-btn" type="button" data-abrir-folha="cl-folha-novo"><%- include('../partials/icone', { cvIc: 'clienteMais', cvCls: 'cv-ic--18' }) %>Novo</button></div>
</header>

<div class="cv-secao" style="margin-top:16px">
  <section class="cv-objeto cv-gravada" aria-label="Resumo da carteira">
    <div class="cv-tres">
      <div><span class="cv-num"><%= resumo.total %></span><span class="rot">na base</span></div>
      <div><span class="cv-num"><%= resumo.sumidos %></span><span class="rot">sumidos há 30 dias</span></div>
      <div><span class="cv-num"><%= resumo.aniversariantes %></span><span class="rot">aniversário no mês</span></div>
    </div>
  </section>
</div>

<label class="cv-busca"><span class="cv-oculto">Buscar cliente</span><%- include('../partials/icone', { cvIc: 'busca' }) %><input class="cv-entrada" type="search" data-busca="cl" placeholder="Buscar por nome ou telefone" autocomplete="off" /></label>
<div class="cv-filtros" role="group" aria-label="Filtro" data-filtros-de="cl">
  <button type="button" class="cv-chip" data-filtro="todos" aria-pressed="true"><span>Todos</span></button>
  <button type="button" class="cv-chip" data-filtro="sumido" aria-pressed="false"><span>Sumidos</span></button>
  <button type="button" class="cv-chip" data-filtro="aniversario" aria-pressed="false"><span>Aniversariantes</span></button>
</div>

<section class="cv-secao" style="margin-top:14px" aria-label="Lista de clientes">
  <% if (clientes.length === 0) { %>
    <div class="cv-cartao cv-vazio" role="status">
      <h2>Nenhum cliente ainda</h2>
      <p>Quem marca pelo link entra aqui sozinho. Você também pode cadastrar alguém do balcão.</p>
      <div class="acoes"><button class="cv-btn" type="button" data-abrir-folha="cl-folha-novo"><%- include('../partials/icone', { cvIc: 'clienteMais', cvCls: 'cv-ic--20' }) %>Cadastrar cliente</button></div>
    </div>
  <% } else { %>
    <ul class="cv-lista cv-so-cel" id="cl-lista" data-lista="cl">
      <% clientes.forEach(function (c) { var filtros = (c.stats.sumido ? 'sumido ' : '') + (c.aniversarianteMes ? 'aniversario' : ''); %>
        <li data-item data-texto="<%= (c.nome + ' ' + c.telefone).toLowerCase() %>" data-filtros="<%= filtros %>">
          <button type="button" class="cv-linha" data-abrir-folha="cl-folha-<%= c.id %>">
            <span class="cv-avatar cv-avatar--claro" aria-hidden="true"><%= c.iniciais %></span>
            <span class="corpo">
              <span class="t"><%= c.nome %></span>
              <span class="s"><%= c.stats.servicoFavorito || 'Sem histórico' %> · <%= c.stats.ultimaVisitaLabel %><% if (c.stats.sumido) { %> · sumido<% } %><% if (c.aniversarianteMes) { %> · aniversário<% } %></span>
            </span>
            <span class="fim"><b><%- dinheiro(c.stats.totalGasto) %></b><small><%= c.selosFidelidade %> <%= c.selosFidelidade === 1 ? 'selo' : 'selos' %></small></span>
          </button>
        </li>
      <% }) %>
    </ul>
    <%/* PC: a mesma carteira em tabela (Dani, painel-pc "Clientes"). */%>
    <div class="cv-tabela" data-lista="cl">
      <table>
        <thead><tr><th>Cliente</th><th>Telefone</th><th>Última visita</th><th>Favorito</th><th class="dir">Visitas</th><th class="dir">Total gasto</th><th class="dir">Selos</th></tr></thead>
        <tbody>
          <% clientes.forEach(function (c) { var filtros = (c.stats.sumido ? 'sumido ' : '') + (c.aniversarianteMes ? 'aniversario' : ''); %>
            <tr data-item data-texto="<%= (c.nome + ' ' + c.telefone).toLowerCase() %>" data-filtros="<%= filtros %>" data-abrir-folha="cl-folha-<%= c.id %>">
              <td><button type="button" class="pessoa" data-abrir-folha="cl-folha-<%= c.id %>"><span class="cv-avatar cv-avatar--p cv-avatar--claro" aria-hidden="true"><%= c.iniciais %></span><span><b><%= c.nome %></b><% if (c.stats.sumido || c.aniversarianteMes) { %><small><%= c.stats.sumido ? 'Sumido' : '' %><%= c.stats.sumido && c.aniversarianteMes ? ' · ' : '' %><%= c.aniversarianteMes ? 'Aniversário no mês' : '' %></small><% } %></span></button></td>
              <td><%= fmtTelefone(c.telefone) %></td>
              <td><%= c.stats.ultimaVisitaLabel %></td>
              <td><%= c.stats.servicoFavorito || '—' %></td>
              <td class="dir"><%= c.stats.visitas %></td>
              <td class="dir"><b><%- dinheiro(c.stats.totalGasto) %></b></td>
              <td class="dir"><%= c.selosFidelidade %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="cv-texto-apoio" data-sem-resultado="cl" hidden style="padding:16px 4px">Nenhum cliente com essa busca ou filtro.</p>
  <% } %>
</section>

<%/* Novo cliente */%>
<section class="cv-folha" id="cl-folha-novo" data-folha role="dialog" aria-modal="true" aria-labelledby="cl-novo-t">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="cl-novo-t" tabindex="-1" data-foco>Novo cliente</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button></div></div>
  <div class="cv-folha-corpo">
    <form method="POST" action="/painel/clientes">
      <div class="cv-campo"><label for="cl-novo-nome">Nome</label><input class="cv-entrada" id="cl-novo-nome" name="nome" placeholder="Nome completo" autocomplete="off" required /></div>
      <div class="cv-campo"><label for="cl-novo-tel">Telefone</label><input class="cv-entrada" id="cl-novo-tel" name="telefone" type="tel" inputmode="tel" placeholder="(51) 99999-9999" required /></div>
      <div class="cv-campo"><label for="cl-novo-nascimento">Data de nascimento, opcional</label><input class="cv-entrada" id="cl-novo-nascimento" name="dataNascimento" type="date" /></div>
      <button type="submit" class="cv-btn cv-btn--largo">Cadastrar</button>
    </form>
  </div>
</section>

<%/* Ficha do cliente: uma folha por cliente. */%>
<% clientes.forEach(function (c) { %>
<section class="cv-folha" id="cl-folha-<%= c.id %>" data-folha role="dialog" aria-modal="true" aria-labelledby="cl-t-<%= c.id %>">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="cl-t-<%= c.id %>" tabindex="-1" data-foco><%= c.nome %></h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button></div></div>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= fmtTelefone(c.telefone) %> · última visita <%= c.stats.ultimaVisitaLabel %></p>
    <section class="cv-objeto cv-gravada" aria-label="Números do cliente" style="margin-bottom:18px">
      <div class="cv-tres">
        <div><%- dinheiro(c.stats.totalGasto, 'm') %><span class="rot">total gasto</span></div>
        <div><span class="cv-num"><%= c.stats.visitas %></span><span class="rot">visitas</span></div>
        <div><span class="cv-num"><%= c.stats.frequenciaDias !== null ? c.stats.frequenciaDias + ' d' : '—' %></span><span class="rot">frequência</span></div>
      </div>
    </section>
    <form method="POST" action="/painel/clientes/<%= c.id %>">
      <div class="cv-campo"><label for="cl-tel-<%= c.id %>">Telefone</label><input class="cv-entrada" id="cl-tel-<%= c.id %>" name="telefone" type="tel" inputmode="tel" value="<%= fmtTelefone(c.telefone) %>" required /></div>
      <div class="cv-campo"><label for="cl-nasc-<%= c.id %>">Data de nascimento</label><input class="cv-entrada" id="cl-nasc-<%= c.id %>" name="dataNascimento" type="date" value="<%= c.nascimentoIso %>" /></div>
      <div class="cv-campo"><label for="cl-obs-<%= c.id %>">Observações</label><input class="cv-entrada" id="cl-obs-<%= c.id %>" name="observacoes" placeholder="Adicionar observação" value="<%= c.observacoes || '' %>" /></div>
      <div class="cv-campo"><span class="cv-rotulo">Serviço e barbeiro preferidos</span><p style="margin:4px 0 0;font-size:15px"><%= c.stats.servicoFavorito || '—' %> · <%= c.stats.barbeiroFavorito || '—' %></p></div>
      <button type="submit" class="cv-btn cv-btn--largo">Salvar</button>
    </form>

    <% if (c.agendamentos.length > 0) { %>
      <div class="cv-folha-sec"><h3>Histórico</h3>
        <ul class="cv-linhas">
          <% c.agendamentos.slice(0, 8).forEach(function (ag) { %>
            <li><span><%= fmtData(ag.data) %> · <%= ag.itens.length ? ag.itens.map(function (it) { return it.servico.nome; }).join(', ') : '—' %></span><b><%- dinheiro(ag.valorTotal) %></b></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="cv-folha-sec"><h3>Plano</h3>
      <% if (c.assinaturas.length) { %>
        <ul class="cv-linhas">
          <% c.assinaturas.forEach(function (a) { %>
            <li>
              <span><b style="font-weight:600;color:var(--c-tinta)"><%= a.plano.nome %></b> <span class="cv-etq<%= a.vigente ? ' cv-etq--preta' : '' %>"><%= a.vigente ? 'ativo' : 'inativo' %></span><br><%= a.usosLabel %> · até <%= a.validadeLabel %><% if (a.diasLabel) { %> · <%= a.diasLabel %><% } %></span>
              <form method="POST" action="/painel/clientes/planos/<%= a.id %>/remover" data-confirmar="Remover este plano do cliente?"><button type="submit" class="cv-redondo cv-redondo--leve" aria-label="Remover o plano <%= a.plano.nome %>"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button></form>
            </li>
          <% }) %>
        </ul>
      <% } else if (planosDisponiveis.length === 0) { %>
        <p class="cv-texto-apoio">Nenhum plano.</p>
      <% } %>
      <% if (planosDisponiveis.length > 0) { %>
        <form method="POST" action="/painel/clientes/<%= c.id %>/planos" class="cv-linha-form" style="margin-top:10px">
          <label class="cv-oculto" for="cl-plano-<%= c.id %>">Adicionar plano</label>
          <select class="cv-entrada" id="cl-plano-<%= c.id %>" name="planoId" required>
            <option value="">Adicionar plano…</option>
            <% planosDisponiveis.forEach(function (p) { %><option value="<%= p.id %>"><%= p.nome %> · <%= fmtBRL(p.valor) %></option><% }) %>
          </select>
          <input type="hidden" name="dataInicio" value="<%= hojeIso %>" />
          <button type="submit" class="cv-btn cv-btn--2 cv-btn--p">Adicionar</button>
        </form>
      <% } %>
    </div>

    <div class="cv-folha-acoes">
      <form method="POST" action="/painel/clientes/<%= c.id %>/remover" data-confirmar="Excluir este cliente?"><button type="submit" class="cv-perigo-link">Excluir cliente</button></form>
    </div>
  </div>
</section>
<% }) %>

<script>
  // ?abrir=cliente (Novo da navbar) chama clAbrirFolha('novo'), via cv-casca.
  function clAbrirFolha(id) {
    var ir = function () { if (window.cvAbrirFolha) window.cvAbrirFolha('cl-folha-' + id); };
    if (window.cvAbrirFolha) ir(); else document.addEventListener('DOMContentLoaded', ir);
  }
</script>
