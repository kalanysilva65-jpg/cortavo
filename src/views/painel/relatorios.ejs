<%/* Relatórios (redesign v3). Sem mockup próprio: o sistema aplicado com
     rigor e a mesma gramática da Gestão. Período em segmento (sem vidro: o
     vidro de período é só o da Gestão), o objeto preto com o faturamento,
     quatro cartões-resumo, mais vendidos, formas de pagamento e clientes.
     Cada cartão abre a folha de detalhe (os mesmos dados de antes). Números
     com "R$" e centavos pequenos. Mesmas rotas e parâmetros. */%>
<%
  var fechar = include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' });
  var dinheiro = function (c, tam) { return include('../partials/dinheiro', { cvC: c, cvTam: tam || 'p' }); };
  function variacao(v) { return v === null || v === undefined ? '' : '<span class="cv-delta' + (v < 0 ? ' cv-delta--cai' : '') + '">' + (v >= 0 ? '+' : '') + v + '% vs anterior</span>'; }
  function cab(id, titulo) { return '<div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="' + id + '-t" tabindex="-1" data-foco>' + titulo + '</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar">' + fechar + '</button></div></div>'; }
  function barra(w, escura) { return '<span class="cv-rl-trilho"><b style="width:' + w + (String(w).indexOf('%') === -1 ? '%' : '') + (escura === false ? ';background:var(--d-3)' : '') + '"></b></span>'; }
  var PER = [['hoje', 'Hoje'], ['semana', 'Semana'], ['mes', 'Mês'], ['ano', 'Ano']];
%>
<header class="cv-cab">
  <div class="cv-cab-txt"><p class="cv-cab-sup"><%= relPeriodLabel %></p><h1>Relatórios</h1></div>
  <%/* Exportar continua sendo o print do navegador. */%>
  <div class="cv-cab-acoes"><button type="button" class="cv-redondo cv-redondo--leve" onclick="window.print()" aria-label="Exportar ou imprimir"><%- include('../partials/icone', { cvIc: 'exportar', cvCls: 'cv-ic--18' }) %></button></div>
</header>

<div class="cv-secao" style="margin-top:16px">
  <nav class="cv-seg cv-rl-per" aria-label="Período">
    <% PER.forEach(function (p) { %><a href="/painel/relatorios?periodo=<%= p[0] %>" aria-pressed="<%= periodo === p[0] %>"<% if (periodo === p[0]) { %> aria-current="page"<% } %>><%= p[1] %></a><% }) %>
    <button type="button" aria-pressed="<%= periodo === 'custom' %>" aria-controls="rel-custom" onclick="relCustomToggle()" aria-label="Escolher datas"><%- include('../partials/icone', { cvIc: 'calendario', cvCls: 'cv-ic--18' }) %></button>
  </nav>
  <form id="rel-custom" class="cv-cartao cv-rl-custom" method="GET" action="/painel/relatorios"<% if (periodo !== 'custom') { %> hidden<% } %>>
    <input type="hidden" name="periodo" value="custom" />
    <div class="cv-dupla">
      <div class="cv-campo"><label for="rel-de">De</label><input class="cv-entrada" id="rel-de" type="date" name="de" value="<%= deStr %>" required /></div>
      <div class="cv-campo"><label for="rel-ate">Até</label><input class="cv-entrada" id="rel-ate" type="date" name="ate" value="<%= ateStr %>" required /></div>
    </div>
    <div class="cv-chips" style="flex-wrap:wrap;margin:10px 0 0;padding:0"><% relCustomShortcuts.forEach(function (sh) { %><button type="button" class="cv-chip" onclick="relAtalho('<%= sh.de %>','<%= sh.ate %>')"><span><%= sh.label %></span></button><% }) %></div>
    <button type="submit" class="cv-btn cv-btn--largo" style="margin-top:12px">Aplicar período</button>
  </form>
</div>

<div class="cv-secao" style="margin-top:14px">
  <button type="button" class="cv-objeto cv-gravada cv-rl-fat" data-abrir-folha="agm-fat">
    <span class="rot">Faturamento do período</span>
    <span class="num"><%- dinheiro(faturamento, 'g') %></span>
    <%- variacao(variacaoFaturamento) %>
    <span class="cv-tres">
      <span><%- dinheiro(servicosValor) %><span class="rot">serviços</span></span>
      <span><%- dinheiro(produtosValor) %><span class="rot">produtos</span></span>
      <span><span class="cv-num"><%= atendimentos %></span><span class="rot">atendimentos</span></span>
    </span>
  </button>
</div>

<div class="cv-secao cv-rl-grade" style="margin-top:12px">
  <button type="button" class="cv-cartao cv-resumo" data-abrir-folha="agm-ticket"><span class="rot">Ticket médio</span><%- dinheiro(ticketMedio, 'm') %><%- variacao(variacaoTicket) %></button>
  <button type="button" class="cv-cartao cv-resumo" data-abrir-folha="agm-ocupacao"><span class="rot">Agenda ocupada</span><span class="cv-num cv-num--m"><%= ocupacaoPct %><span class="de">%</span></span></button>
  <button type="button" class="cv-cartao cv-resumo" data-abrir-folha="agm-lucro"><span class="rot">Lucro estimado</span><%- dinheiro(lucro, 'm') %><%- variacao(variacaoLucro) %></button>
  <button type="button" class="cv-cartao cv-resumo" data-abrir-folha="agm-gastos"><span class="rot">Gastos</span><%- dinheiro(gastos, 'm') %></button>
</div>

<section class="cv-secao" aria-labelledby="rl-mais">
  <div class="cv-secao-cab"><h2 id="rl-mais">Serviços mais vendidos</h2><a href="#" data-abrir-folha="agm-produtos">Ver tudo</a></div>
  <div class="cv-cartao">
    <% if (topServices.length) { %>
      <ul class="cv-rl-barras">
        <% topServices.forEach(function (sv) { %><li><span class="linha"><span><%= sv.name %></span><b><%= sv.pct %>%</b></span><%- barra(sv.w) %></li><% }) %>
      </ul>
    <% } else { %><p class="cv-texto-apoio" style="margin:0">Nenhum serviço concluído neste período.</p><% } %>
  </div>
</section>

<section class="cv-secao" aria-labelledby="rl-pag">
  <div class="cv-secao-cab"><h2 id="rl-pag">Formas de pagamento</h2><a href="#" data-abrir-folha="agm-pagamentos">Ver tudo</a></div>
  <div class="cv-cartao">
    <% if (formasPagamento.length) { %>
      <div class="cv-rl-pilha" role="img" aria-label="<%= formasPagamento.map(function (f) { return f.label + ' ' + f.pct + '%'; }).join(', ') %>"><% formasPagamento.forEach(function (f, i) { %><i style="flex:<%= Math.max(8, f.pct) %>;background:var(--d-<%= Math.min(i + 1, 4) %>)"></i><% }) %></div>
      <ul class="cv-linhas" style="margin-top:10px"><% formasPagamento.forEach(function (f, i) { %><li><span><i class="cv-rl-ponto" style="background:var(--d-<%= Math.min(i + 1, 4) %>)"></i><%= f.label %></span><b><%- dinheiro(f.valor) %> · <%= f.pct %>%</b></li><% }) %></ul>
    <% } else { %><p class="cv-texto-apoio" style="margin:0">Nenhum recebimento com forma de pagamento registrada.</p><% } %>
  </div>
</section>

<section class="cv-secao" aria-labelledby="rl-cli">
  <div class="cv-secao-cab"><h2 id="rl-cli">Clientes</h2><a href="#" data-abrir-folha="agm-clientes">Ver tudo</a></div>
  <button type="button" class="cv-cartao cv-rl-cli" data-abrir-folha="agm-clientes"><span class="cv-num cv-num--m"><%= clientesNovos %></span><span>clientes novos no período, contra <b><%= clientesRecorrentes %></b> que já eram da casa.</span></button>
</section>

<%/* ======================= Folhas de detalhe ======================= */%>
<section class="cv-folha cv-rl-folha" id="agm-fat" data-folha role="dialog" aria-modal="true" aria-labelledby="agm-fat-t">
  <%- cab('agm-fat', 'Faturamento') %>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= relPeriodLabel %> · <%= fmtBRL(servicosValor) %> em serviços e <%= fmtBRL(produtosValor) %> em produtos</p>
    <div class="cv-rl-heroi"><%- dinheiro(faturamento, 'g') %></div>
    <div class="cv-folha-sec"><h3>O que foi vendido</h3>
      <% if (!relVendasRows.length) { %><p class="cv-texto-apoio">Nenhuma venda registrada neste período.</p><% } %>
      <ul class="cv-linhas">
        <% relVendasRows.forEach(function (vr) { %>
          <li class="cv-rl-sanfona"><details><summary><span><b style="font-weight:600;color:var(--c-tinta)"><%= vr.name %></b><br><%= vr.kind %> · <%= vr.qtyLabel %></span><b><%- dinheiro(vr.valor) %></b></summary>
            <ul class="cv-linhas cv-rl-det"><% vr.entries.forEach(function (ev) { %><li><span><%= ev.when %> · <%= ev.who %></span><b><%= fmtBRL(ev.valor) %></b></li><% }) %><% if (vr.more) { %><li><span><%= vr.more %></span></li><% } %></ul>
          </details></li>
        <% }) %>
      </ul>
    </div>
    <% if (barberPerf.length) { %>
      <div class="cv-folha-sec"><h3>Por barbeiro</h3>
        <ul class="cv-rl-barras"><% barberPerf.forEach(function (bp) { %><li><span class="linha"><span><%= bp.name %></span><b><%- dinheiro(bp.valor) %></b></span><%- barra(bp.pct) %><small><%= bp.qtd %> atendimentos · ticket <%= fmtBRL(bp.ticket) %></small></li><% }) %></ul>
      </div>
    <% } %>
    <% if (slotHistory.length) { %>
      <div class="cv-folha-sec"><h3>Últimos atendimentos</h3>
        <ul class="cv-linhas"><% slotHistory.forEach(function (sh) { %><li><span><b style="font-weight:600;color:var(--c-tinta)"><%= sh.time %></b> <%= sh.day %> · <%= sh.client %><br><%= sh.service %> · <%= sh.barber %></span><b><%- dinheiro(sh.valor) %></b></li><% }) %></ul>
      </div>
    <% } %>
  </div>
</section>

<section class="cv-folha cv-rl-folha" id="agm-produtos" data-folha role="dialog" aria-modal="true" aria-labelledby="agm-produtos-t">
  <%- cab('agm-produtos', 'Mais vendidos') %>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= relPeriodLabel %></p>
    <div class="cv-folha-sec"><h3>Serviços</h3>
      <% if (!topServices.length) { %><p class="cv-texto-apoio">Nenhum serviço no período.</p><% } %>
      <ul class="cv-linhas"><% topServices.forEach(function (sv) { %><li><span><b style="font-weight:800;color:var(--c-tinta)"><%= sv.qtd %>×</b> <%= sv.name %></span><b><%= fmtBRL(sv.valor) %> · <%= sv.pct %>%</b></li><% }) %></ul>
    </div>
    <div class="cv-folha-sec"><h3>Produtos</h3>
      <% if (!relProdutosRows.length) { %><p class="cv-texto-apoio">Nenhum produto vendido no período.</p><% } %>
      <ul class="cv-linhas"><% relProdutosRows.forEach(function (pr) { %><li><span><b style="font-weight:800;color:var(--c-tinta)"><%= pr.qty %>×</b> <%= pr.name %></span><b><%= fmtBRL(pr.valor) %></b></li><% }) %>
        <li><span>Total em produtos · <%= relProdutosTotalQty %> un</span><b><%- dinheiro(produtosValorTotal) %></b></li></ul>
    </div>
  </div>
</section>

<section class="cv-folha cv-rl-folha" id="agm-ticket" data-folha role="dialog" aria-modal="true" aria-labelledby="agm-ticket-t">
  <%- cab('agm-ticket', 'Ticket médio') %>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= fmtBRL(faturamento) %> em <%= atendimentos %> atendimentos</p>
    <div class="cv-rl-heroi"><%- dinheiro(ticketMedio, 'g') %><%- variacao(variacaoTicket) %></div>
    <div class="cv-folha-sec"><h3>Por atendimento e por cliente</h3>
      <ul class="cv-rl-barras">
        <li><span class="linha"><span>Por atendimento · <%= atendimentos %></span><b><%- dinheiro(ticketPorTipo.atendimento) %></b></span><%- barra(ticketPorTipo.atendW) %></li>
        <li><span class="linha"><span>Por cliente · <%= clientesData.unicos %> únicos</span><b><%- dinheiro(ticketPorTipo.cliente) %></b></span><%- barra(ticketPorTipo.clienteW, false) %></li>
      </ul>
    </div>
    <div class="cv-folha-sec"><h3>Com produto e só serviço</h3>
      <ul class="cv-rl-barras">
        <li><span class="linha"><span>Com produto · <%= ticketData.comQtd %></span><b><%- dinheiro(ticketData.com) %></b></span><%- barra(ticketData.comW) %></li>
        <li><span class="linha"><span>Só serviço · <%= ticketData.semQtd %></span><b><%- dinheiro(ticketData.sem) %></b></span><%- barra(ticketData.semW, false) %></li>
      </ul>
    </div>
    <div class="cv-cartao cv-rl-insight"><span class="cv-num cv-num--m"><%= ticketData.comPct %><span class="de">%</span></span><p>dos atendimentos levaram algum produto. Nesses, o ticket foi <%= fmtBRL(ticketData.delta) %> maior.</p></div>
    <% if (barberPerf.length) { %>
      <div class="cv-folha-sec"><h3>Por barbeiro</h3><ul class="cv-linhas"><% barberPerf.forEach(function (bp) { %><li><span><%= bp.name %><br><%= bp.qtd %> atendimentos · <%= fmtBRL(bp.valor) %></span><b><%- dinheiro(bp.ticket) %></b></li><% }) %></ul></div>
    <% } %>
  </div>
</section>

<section class="cv-folha cv-rl-folha" id="agm-ocupacao" data-folha role="dialog" aria-modal="true" aria-labelledby="agm-ocupacao-t">
  <%- cab('agm-ocupacao', 'Ocupação') %>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= ocupData.sub %> · <%= ocupData.livres %></p>
    <div class="cv-rl-heroi"><span class="cv-num cv-num--g"><%= ocupData.pct %><span class="de">%</span></span></div>
    <div class="cv-folha-sec">
      <div class="cv-seg" role="tablist" aria-label="Mapa" style="margin-bottom:12px"><button type="button" role="tab" data-mapa="dia" aria-pressed="true" aria-selected="true" onclick="relMapa('dia')">Por hora</button><button type="button" role="tab" data-mapa="semana" aria-pressed="false" aria-selected="false" onclick="relMapa('semana')">Dia × hora</button></div>
      <div id="rel-mapa-dia"><ul class="cv-rl-barras cv-rl-horas"><% ocupSlots.forEach(function (sl) { %><li><span class="linha"><span><%= sl.hour %></span><b><%= sl.label %></b></span><%- barra(sl.w) %></li><% }) %></ul></div>
      <div id="rel-mapa-semana" hidden>
        <div class="cv-rl-mapa" style="--cols:<%= ocupGrid.days.length %>">
          <span></span><% ocupGrid.days.forEach(function (d) { %><span class="dia"><%= d %></span><% }) %>
          <% ocupGrid.rows.forEach(function (row) { %><span class="hora"><%= row.hour %></span><% row.cells.forEach(function (c) { %><i style="background:<%= c.bg %>"></i><% }) %><% }) %>
        </div>
        <div class="cv-legenda-graf" style="margin-top:10px"><span><i class="q" style="background:#191919"></i>Lotado</span><span><i class="q" style="background:#393939"></i>Cheio</span><span><i class="q" style="background:#9C9C9C"></i>Vago</span><span><i class="q" style="background:#EBEBEB"></i>Vazio</span></div>
      </div>
    </div>
    <div class="cv-cartao cv-rl-insight"><% if (ocupInsight.temDados) { %><b>Pico às <%= ocupInsight.peak %></b><% if (ocupInsight.temBuraco) { %><b class="fraca">Buracos às <%= ocupInsight.gap %></b><% } %><p>Puxar clientes para os horários vagos vale mais que abrir novos horários no pico.</p><% } else { %><b>Sem movimento</b><p>Ainda não há atendimentos suficientes neste período para apontar pico e buraco.</p><% } %></div>
    <% if (ocupPorBarbeiro.length) { %>
      <div class="cv-folha-sec"><h3>Por barbeiro</h3><ul class="cv-rl-barras"><% ocupPorBarbeiro.forEach(function (ob) { %><li><span class="linha"><span><%= ob.name %></span><b><%= ob.pct %>%</b></span><%- barra(ob.w) %><small><%= ob.sub %></small></li><% }) %></ul></div>
    <% } %>
    <div class="cv-folha-sec"><h3>Por dia da semana</h3>
      <div class="cv-rl-colunas"><% ocupWeekBars.forEach(function (wb) { %><div><span class="v"><%= wb.value %></span><i style="height:<%= wb.h %>px"></i><span class="l"><%= wb.label %></span></div><% }) %></div>
    </div>
  </div>
</section>

<section class="cv-folha cv-rl-folha" id="agm-pagamentos" data-folha role="dialog" aria-modal="true" aria-labelledby="agm-pagamentos-t">
  <%- cab('agm-pagamentos', 'Pagamentos') %>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= pagData.transacoes %> transações em <%= formasPagamento.length %> formas</p>
    <div class="cv-rl-heroi"><%- dinheiro(pagData.total, 'g') %></div>
    <% if (formasPagamento.length) { %>
      <div class="cv-folha-sec"><h3>Forma por forma</h3><ul class="cv-linhas"><% formasPagamento.forEach(function (f, i) { %><li><span><i class="cv-rl-ponto" style="background:var(--d-<%= Math.min(i + 1, 4) %>)"></i><b style="font-weight:600;color:var(--c-tinta)"><%= f.label %></b> · <%= f.pct %>%<br><%= f.qtd %> recebimentos · ticket <%= fmtBRL(f.ticket) %></span><b><%- dinheiro(f.valor) %></b></li><% }) %></ul></div>
      <div class="cv-folha-sec"><h3>Quando o dinheiro cai</h3>
        <ul class="cv-rl-barras">
          <li><span class="linha"><span>Na hora · Pix e dinheiro · <%= pagData.naHoraPct %>%</span><b><%- dinheiro(pagData.naHoraValor) %></b></span><%- barra(pagData.naHoraW) %></li>
          <li><span class="linha"><span>Depois · cartão · <%= pagData.depoisPct %>%</span><b><%- dinheiro(pagData.depoisValor) %></b></span><%- barra(pagData.depoisW, false) %></li>
        </ul>
      </div>
    <% } else { %><p class="cv-texto-apoio">Nenhum recebimento com forma de pagamento registrada neste período.</p><% } %>
  </div>
</section>

<section class="cv-folha cv-rl-folha" id="agm-clientes" data-folha role="dialog" aria-modal="true" aria-labelledby="agm-clientes-t">
  <%- cab('agm-clientes', 'Clientes') %>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= clientesData.total %> atendidos · <%= clientesData.novosPct %>% eram primeira vez</p>
    <div class="cv-rl-heroi"><span class="cv-num cv-num--g"><%= clientesData.novos %></span><span class="rot">clientes novos</span></div>
    <div class="cv-folha-sec"><h3>Novos e recorrentes</h3>
      <ul class="cv-rl-barras">
        <li><span class="linha"><span>Novos · <%= clientesData.novosPct %>% · <%= fmtBRL(clientesData.receitaNovos) %></span><b><%= clientesData.novos %></b></span><%- barra(clientesData.novosW) %></li>
        <li><span class="linha"><span>Recorrentes · <%= clientesData.recorrentesPct %>% · <%= fmtBRL(clientesData.receitaRecorrentes) %></span><b><%= clientesData.recorrentes %></b></span><%- barra(clientesData.recorrentesW, false) %></li>
      </ul>
    </div>
    <div class="cv-folha-sec"><h3>Veio uma vez e voltou</h3>
      <ul class="cv-rl-barras">
        <li><span class="linha"><span>Voltou (2 ou mais) · <%= clientesData.voltaramPct %>%</span><b><%= clientesData.voltaram %></b></span><%- barra(clientesData.voltaramW) %></li>
        <li><span class="linha"><span>Só uma vez · <%= clientesData.umaVezPct %>%</span><b><%= clientesData.umaVez %></b></span><%- barra(clientesData.umaVezW, false) %></li>
      </ul>
      <p class="cv-texto-apoio" style="margin-top:10px"><b><%= clientesData.unicos %></b> clientes únicos · <b><%= clientesData.visitas %></b> atendimentos · <%= clientesData.mediaVisitas.toFixed(1).replace('.', ',') %> por cliente</p>
    </div>
    <div class="cv-cartao cv-rl-insight"><span class="cv-num cv-num--m"><%= clientesData.recorrentesPct %><span class="de">%</span></span><p>de quem passou aqui no período já era da casa. Cliente que volta custa menos que cliente novo: vale medir isso todo mês.</p></div>
  </div>
</section>

<section class="cv-folha cv-rl-folha" id="agm-lucro" data-folha role="dialog" aria-modal="true" aria-labelledby="agm-lucro-t">
  <%- cab('agm-lucro', 'Lucro') %>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= fmtBRL(faturamento) %> faturados menos <%= fmtBRL(gastos) %> de gastos</p>
    <div class="cv-rl-heroi"><%- dinheiro(lucro, 'g') %><%- variacao(variacaoLucro) %></div>
    <div class="cv-folha-sec"><h3>A conta, passo a passo</h3>
      <ul class="cv-rl-barras"><% lucroCascata.forEach(function (cs) { %><li><span class="linha"><span><%= cs.label %> · <%= fmtBRL(cs.amount) %></span><b><%- dinheiro(cs.rest) %></b></span><%- barra(cs.w) %></li><% }) %></ul>
    </div>
    <div class="cv-cartao cv-rl-insight"><span class="cv-num cv-num--m"><%= margemPct %><span class="de">%</span></span><p>do faturamento vira lucro. <% if (breakEven !== null) { %>Ponto de equilíbrio: <%= breakEven %> atendimentos no ticket atual.<% } else { %>Sem atendimentos no período não dá para calcular o ponto de equilíbrio.<% } %></p></div>
  </div>
</section>

<section class="cv-folha cv-rl-folha" id="agm-gastos" data-folha role="dialog" aria-modal="true" aria-labelledby="agm-gastos-t">
  <%- cab('agm-gastos', 'Gastos') %>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub"><%= gastosPctFat %>% do faturamento</p>
    <div class="cv-rl-heroi"><%- dinheiro(gastos, 'g') %></div>
    <div class="cv-folha-sec"><h3>Por categoria</h3>
      <% if (!gastoRows.length) { %><p class="cv-texto-apoio">Nenhum gasto neste período.</p><% } %>
      <ul class="cv-linhas">
        <% gastoRows.forEach(function (gr) { %>
          <li class="cv-rl-sanfona"><details><summary><span><b style="font-weight:600;color:var(--c-tinta)"><%= gr.name %></b><br><%= gr.qtdLabel %> · <%= gr.pct %>% do total</span><b><%- dinheiro(gr.valor) %></b></summary>
            <ul class="cv-linhas cv-rl-det"><% gr.entries.forEach(function (ge) { %><li><span><%= ge.desc %> · <%= ge.date %></span><b><%= fmtBRL(ge.valor) %></b></li><% }) %></ul>
          </details></li>
        <% }) %>
        <li><span>Total do período</span><b><%- dinheiro(gastos) %></b></li>
      </ul>
    </div>
  </div>
</section>

<script>
  // Nomes de sempre (outras telas chamam abrirModal('fat') etc.).
  function abrirModal(id) { var ir = function () { if (window.cvAbrirFolha) cvAbrirFolha('agm-' + id); }; if (window.cvAbrirFolha) ir(); else document.addEventListener('DOMContentLoaded', ir); }
  function relCustomToggle() { var f = document.getElementById('rel-custom'); if (f) f.hidden = !f.hidden; }
  // Atalho só preenche as datas; o envio continua sendo o submit.
  function relAtalho(de, ate) { document.getElementById('rel-de').value = de; document.getElementById('rel-ate').value = ate; }
  function relMapa(qual) {
    document.getElementById('rel-mapa-semana').hidden = qual !== 'semana';
    document.getElementById('rel-mapa-dia').hidden = qual !== 'dia';
    Array.prototype.forEach.call(document.querySelectorAll('[data-mapa]'), function (b) { var on = b.getAttribute('data-mapa') === qual; b.setAttribute('aria-pressed', String(on)); b.setAttribute('aria-selected', String(on)); });
  }
</script>
