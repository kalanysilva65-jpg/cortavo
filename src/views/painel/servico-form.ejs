<%/* Serviço ou produto em página inteira (/servicos/novo e /:id/editar), no
     v3. É aqui que mora o preço por barbeiro; a tela de Serviços e produtos
     leva até ela por "Mais opções". Mesmos campos e rotas. */%>
<% var ehProd = !!(servico && servico.ehProduto); %>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup"><a href="/painel/<%= ehProd ? 'produtos' : 'servicos' %>" style="color:inherit">Serviços e produtos</a></p><h1><%= servico ? servico.nome : 'Novo serviço' %></h1></div></header>
<div class="cv-secao" style="margin-top:16px">
  <form method="POST" enctype="multipart/form-data" class="cv-cartao cv-pl-form" action="<%= servico ? '/painel/servicos/' + servico.id : '/painel/servicos' %>">
    <div class="cv-campo"><label for="nome">Nome</label><input class="cv-entrada" id="nome" name="nome" value="<%= servico ? servico.nome : '' %>" required autofocus /></div>
    <div class="cv-campo"><label for="descricao">Descrição <span style="font-weight:400;color:var(--c-apoio)">(opcional)</span></label><textarea class="cv-entrada" id="descricao" name="descricao" maxlength="1000" rows="4" placeholder="Ex.: Corte na tesoura e máquina, lavagem e finalização."><%= servico && servico.descricao ? servico.descricao : '' %></textarea><span class="cv-ajuda">No link de agendamento, aparece quando o cliente toca no serviço.</span></div>
    <div class="cv-dupla" style="margin-top:14px">
      <div class="cv-campo"><label for="valor">Preço, em reais</label><input class="cv-entrada cv-entrada--num" id="valor" name="valor" type="number" step="0.01" min="0" inputmode="decimal" value="<%= servico ? (servico.valor / 100).toFixed(2) : '' %>" required /></div>
      <div class="cv-campo"><label for="duracaoMin">Duração, em minutos</label><input class="cv-entrada cv-entrada--num" id="duracaoMin" name="duracaoMin" type="number" min="0" inputmode="numeric" value="<%= servico ? servico.duracaoMin : 0 %>" /></div>
    </div>
    <label class="cv-chave cv-chave-linha"><span>É um produto<small style="display:block;font-size:13px;color:var(--c-apoio)">Usa a comissão abaixo e não ocupa horário.</small></span><input type="checkbox" name="ehProduto" id="ehProduto"<%= ehProd ? ' checked' : '' %> /></label>
    <label class="cv-chave cv-chave-linha" id="campo-encaixe"<% if (ehProd) { %> hidden<% } %>><span>É um encaixe<small style="display:block;font-size:13px;color:var(--c-apoio)">Junto de outro serviço não soma tempo (ex.: sobrancelha durante o corte).</small></span><input type="checkbox" name="ehEncaixe" id="ehEncaixe"<%= servico && servico.ehEncaixe ? ' checked' : '' %> /></label>
    <div class="cv-campo" id="campo-comissao-produto"<% if (!ehProd) { %> hidden<% } %>><label for="comissaoPercentual">Comissão do produto, em %</label><input class="cv-entrada cv-entrada--num" id="comissaoPercentual" name="comissaoPercentual" type="number" min="0" max="100" step="0.1" value="<%= servico ? servico.comissaoPercentual : 10 %>" /></div>
    <% if (barbeiros && barbeiros.length > 1) { %>
      <%/* Preço por barbeiro (opcional): em branco usa o valor padrão. Regra única em services/precos.js. */%>
      <fieldset class="cv-campo" id="campo-precos-barbeiro"<% if (ehProd) { %> hidden<% } %>><legend class="cv-rotulo">Preço por barbeiro <span style="font-weight:400;color:var(--c-apoio)">(opcional)</span></legend>
        <span class="cv-ajuda">Em branco, usa o preço padrão. Preencha só para quem cobra diferente.</span>
        <% barbeiros.forEach(function (u) { %><label class="cv-consumo-linha"><span><%= u.nome %></span><input class="cv-entrada" id="pb-<%= u.id %>" name="precoBarbeiro_<%= u.id %>" type="number" step="0.01" min="0" inputmode="decimal" placeholder="padrão" value="<%= precosBarbeiro && precosBarbeiro[u.id] !== undefined ? (precosBarbeiro[u.id] / 100).toFixed(2) : '' %>" /></label><% }) %>
      </fieldset>
    <% } %>
    <div class="cv-campo"><label for="categoriaId">Categoria</label><select class="cv-entrada" id="categoriaId" name="categoriaId"><option value="">Sem categoria</option><% categorias.forEach(function (c) { %><option value="<%= c.id %>"<%= servico && servico.categoriaId === c.id ? ' selected' : '' %>><%= c.nome %></option><% }) %></select></div>
    <div class="cv-campo"><label for="foto">Foto <span style="font-weight:400;color:var(--c-apoio)">(opcional)</span></label>
      <% if (servico && servico.fotoUrl) { %><span class="cv-cat-mini" style="width:72px;height:72px;margin:6px 0"><img src="<%= servico.fotoUrl %>" alt="Foto atual" /></span><% } %>
      <input class="cv-entrada cv-cat-arquivo" id="foto" name="foto" type="file" accept="image/*" data-foto-mini />
      <span class="cv-ajuda">JPG, PNG ou WEBP, reduzida no próprio aparelho.<%= servico && servico.fotoUrl ? ' Enviar uma nova substitui a atual.' : '' %></span>
      <% if (servico && servico.fotoUrl) { %><button type="submit" class="cv-perigo-link" formaction="/painel/servicos/<%= servico.id %>/foto/remover" formmethod="post" formnovalidate onclick="return confirm('Remover esta foto?')">Remover foto</button><% } %>
    </div>
    <%- include('_consumo-estoque', { estoqueItens: estoqueItens, mapa: insumosMap || {} }) %>
    <button class="cv-btn cv-btn--largo cv-acao-fixa" type="submit"><%= servico ? 'Salvar alterações' : 'Criar serviço' %></button>
  </form>
  <% if (servico) { %>
    <div class="cv-dupla" style="margin-top:12px">
      <form method="POST" action="/painel/servicos/<%= servico.id %>/toggle"><button class="cv-btn cv-btn--2 cv-btn--largo" type="submit"><%= servico.ativo ? 'Desativar' : 'Ativar' %></button></form>
      <form method="POST" action="/painel/servicos/<%= servico.id %>/remover" data-confirmar="Excluir este item?"><button class="cv-btn cv-btn--2 cv-txt-perigo cv-btn--largo" type="submit">Excluir</button></form>
    </div>
  <% } %>
</div>
<script>
  (function () {
    var p = document.getElementById('ehProduto');
    function sync() { var e = p.checked; document.getElementById('campo-comissao-produto').hidden = !e; document.getElementById('campo-encaixe').hidden = e; var pb = document.getElementById('campo-precos-barbeiro'); if (pb) pb.hidden = e; }
    p.addEventListener('change', sync);
  })();
</script>
