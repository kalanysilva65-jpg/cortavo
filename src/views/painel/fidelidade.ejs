<%/* Fidelidade (redesign v3). Sem mockup próprio: o sistema aplicado com
     rigor. Objeto com os três números (clientes fiéis, cupons ativos,
     resgates no mês), cupons em lista, ranking com + selo e Resgatar.
     Novo cupom em folha. Mesmas rotas e campos. */%>
<% var fechar = include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }); %>
<header class="cv-cab">
  <div class="cv-cab-txt"><p class="cv-cab-sup">Atendimento</p><h1>Fidelidade</h1></div>
  <div class="cv-cab-acoes"><button class="cv-btn" type="button" data-abrir-folha="agm-novo"><%- include('../partials/icone', { cvIc: 'mais', cvCls: 'cv-ic--18' }) %>Cupom</button></div>
</header>

<div class="cv-secao" style="margin-top:16px">
  <section class="cv-objeto cv-gravada" aria-label="Resumo da fidelidade">
    <div class="cv-tres">
      <div><span class="cv-num"><%= fidClientesFieisCount %></span><span class="rot">clientes fiéis</span></div>
      <div><span class="cv-num"><%= fidCuponsAtivosCount %></span><span class="rot">cupons ativos</span></div>
      <div><span class="cv-num"><%= fidResgatesMes %></span><span class="rot">resgates no mês</span></div>
    </div>
  </section>
</div>

<section class="cv-secao" aria-labelledby="fid-cupons">
  <div class="cv-secao-cab"><h2 id="fid-cupons">Cupons e promoções</h2></div>
  <% if (cupons.length === 0) { %>
    <div class="cv-cartao"><p class="cv-texto-apoio" style="margin:0">Nenhum cupom ainda. Um cupom de aniversário costuma trazer o cliente de volta.</p></div>
  <% } else { %>
    <ul class="cv-lista cv-lista--sem-ic">
      <% cupons.forEach(function (cp) { %>
        <li><div class="cv-linha">
          <span class="corpo"><span class="t"><%= cp.nome %><% if (!cp.ativo) { %> <span class="cv-etq cv-etq--listra">inativo</span><% } %></span><span class="s"><%= cp.descricao ? cp.descricao + ' · ' : '' %>válido até <%= fmtData(cp.validade) %></span></span>
          <span class="cv-etq cv-etq--preta"><%= cp.desconto %></span>
          <form method="POST" action="/painel/fidelidade/cupons/<%= cp.id %>/remover" data-confirmar="Remover este cupom?"><button type="submit" class="cv-redondo cv-redondo--leve" aria-label="Remover o cupom <%= cp.nome %>"><%- fechar %></button></form>
        </div></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="cv-secao" aria-labelledby="fid-rank">
  <div class="cv-secao-cab"><h2 id="fid-rank">Clientes mais fiéis</h2></div>
  <% if (fidRanking.length === 0) { %>
    <div class="cv-cartao"><p class="cv-texto-apoio" style="margin:0">Nenhum cliente com selos ainda. Cada atendimento concluído pode virar um selo.</p></div>
  <% } else { %>
    <ul class="cv-lista">
      <% fidRanking.forEach(function (fc) { %>
        <li><div class="cv-linha cv-fid-linha">
          <span class="pos" aria-label="<%= fc.rank %>º"><%= fc.rank %></span>
          <span class="corpo"><span class="t"><%= fc.name %></span><span class="s"><%= fc.loyalty %> <%= fc.loyalty === 1 ? 'selo' : 'selos' %></span></span>
          <form method="POST" action="/painel/fidelidade/clientes/<%= fc.id %>/resgatar" data-confirmar="Resgatar <%= fc.loyalty %> selo(s) de <%= fc.name %>?"><button type="submit" class="cv-btn cv-btn--2 cv-btn--p">Resgatar</button></form>
          <form method="POST" action="/painel/fidelidade/clientes/<%= fc.id %>/selo"><button type="submit" class="cv-redondo cv-redondo--leve" aria-label="Adicionar um selo para <%= fc.name %>"><%- include('../partials/icone', { cvIc: 'mais', cvCls: 'cv-ic--18' }) %></button></form>
        </div></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="cv-folha" id="agm-novo" data-folha role="dialog" aria-modal="true" aria-labelledby="fid-novo-t">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="fid-novo-t" tabindex="-1" data-foco>Novo cupom</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- fechar %></button></div></div>
  <div class="cv-folha-corpo">
    <form method="POST" action="/painel/fidelidade/cupons">
      <div class="cv-campo"><label for="cupom-nome">Nome do cupom</label><input class="cv-entrada" id="cupom-nome" name="nome" required /></div>
      <div class="cv-campo"><label for="cupom-desc">Descrição <span style="font-weight:400;color:var(--c-apoio)">(opcional)</span></label><input class="cv-entrada" id="cupom-desc" name="descricao" /></div>
      <div class="cv-dupla" style="margin-top:14px">
        <div class="cv-campo"><label for="cupom-desconto">Desconto</label><input class="cv-entrada" id="cupom-desconto" name="desconto" placeholder="20% ou R$15" required /></div>
        <div class="cv-campo"><label for="cupom-validade">Válido até</label><input class="cv-entrada" id="cupom-validade" name="validade" type="date" value="<%= hojeIso %>" required /></div>
      </div>
      <button class="cv-btn cv-btn--largo" type="submit">Adicionar</button>
    </form>
  </div>
</section>

<script>
  function abrirModal(id) { var ir = function () { if (window.cvAbrirFolha) cvAbrirFolha('agm-' + id); }; if (window.cvAbrirFolha) ir(); else document.addEventListener('DOMContentLoaded', ir); }
</script>
