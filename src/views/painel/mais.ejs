<%/* Mais (redesign v3, fatia F1). Lista de seções no lugar da grade de
     ladrilhos: perfil no topo, o objeto do plano (só admin), e as listas
     Barbearia, Atendimento, Cadastros e Conta. Ícone de traço solto, sem
     quadradinho (assinatura.md). Mockup: redesign/v3/prints/12-mais-390.png.

     Mesmo filtro do menu antigo, item a item:
     - admin: só admin vê;
     - permissão do funcionário (podeAcessar): o que não foi liberado some;
     - plano da Cortavo (foraDoPlano): o admin vê o item com o cadeado e o
       nome do plano, como subtítulo; o barbeiro não vê o item (spec 12, R1).
     Nada de compra ou pagamento: o cadeado leva no máximo a "Meu plano". */%>
<%
  var fdp = (typeof foraDoPlano === 'function') ? foraDoPlano : function () { return null; };
  var pode = (typeof podeAcessar === 'function') ? podeAcessar : function () { return true; };
  var plano = (typeof planoCortavo !== 'undefined' && planoCortavo) ? planoCortavo : null;
  var tetos = (plano && plano.tetos) || {};
  // "Disponível no plano Barbearia. Fale com a Cortavo." -> "Barbearia"
  function nomeDoPlano(tranca) {
    var m = tranca && /plano (.+?)\./.exec(tranca.texto || '');
    return m ? m[1] : 'Barbearia';
  }
  // Monta o item já decidido: null = não aparece; .cadeado = nome do plano.
  function item(o) {
    if (o.admin && !ehAdmin) return null;
    if (o.href && o.href.indexOf('/painel/') === 0 && !pode(o.href.split('#')[0])) return null;
    var tranca = o.href ? fdp(o.href.split('#')[0]) : null;
    var cadeado = tranca ? nomeDoPlano(tranca) : (o.cadeado || null);
    if (cadeado && !ehAdmin) return null;
    o.cadeadoPlano = cadeado;
    return o;
  }
  function lista(itens) { return itens.map(item).filter(Boolean); }

  var nome = (usuario && usuario.nome) || '';
  var partes = nome.trim().split(/\s+/);
  var iniciais = ((partes[0] || '?').charAt(0) + (partes.length > 1 ? partes[partes.length - 1].charAt(0) : '')).toUpperCase();
  var nomeBarbearia = (typeof barbeariaAtual !== 'undefined' && barbeariaAtual) ? barbeariaAtual.nome : 'barbearia';
  var papelTxt = ehDono ? 'Dono do sistema' : ehAdmin ? 'Responsável' : 'Barbeiro';
  var semAssistente = (typeof iaAtiva !== 'undefined' && iaAtiva === false);

  var secoes = ehAdmin ? [
    { t: 'Barbearia', itens: lista([
      { href: '/painel/equipe', t: 'Equipe e permissões', s: 'Quem atende e o que cada um vê', ic: 'equipe', admin: true },
      { href: '/painel/horarios', t: 'Horários e bloqueios', s: 'Jornada da equipe, folgas e janela de agendamento', ic: 'relogio' },
      { href: '/painel/logo', t: 'Link de agendamento', s: 'Logo e aparência do seu link', ic: 'link', admin: true },
      { href: '/painel/meu-plano', t: 'Meu plano', s: 'O que inclui e quanto já usou', ic: 'plano', admin: true },
    ]) },
    { t: 'Atendimento', itens: lista([
      { href: '/painel/secretaria', t: 'Secretária de IA', s: 'Responde e agenda no WhatsApp', ic: 'secretaria', admin: true, cadeado: tetos.secretaria === 0 ? 'Barbearia + IA' : null },
      { href: '/painel/conversas', t: 'Conversas', s: 'O WhatsApp da barbearia', ic: 'conversa' },
      semAssistente ? null : { href: '/painel/ia', t: 'Assistente', s: 'Pergunte sobre a agenda e os números', ic: 'assistente', cadeado: tetos.assistente === 0 ? 'Barbearia' : null },
      { href: '/painel/fidelidade', t: 'Fidelidade', s: 'Selos e cupons dos clientes', ic: 'fidelidade', admin: true },
    ].filter(Boolean)) },
    { t: 'Cadastros', itens: lista([
      { href: '/painel/clientes', t: 'Clientes', s: 'Contatos e histórico', ic: 'cliente' },
      { href: '/painel/servicos', t: 'Serviços', s: 'Preço, tempo e foto opcional', ic: 'tesoura' },
      { href: '/painel/produtos', t: 'Produtos', s: 'O que a barbearia vende', ic: 'loja' },
      { href: '/painel/estoque', t: 'Estoque', s: 'Quantidades e mínimo de cada item', ic: 'estoque' },
      { href: '/painel/planos', t: 'Planos de assinatura', s: 'Pacotes mensais para os clientes', ic: 'cartao' },
    ]) },
  ] : [
    { t: 'Seu dia a dia', itens: lista([
      { href: '/painel/perfil#pf-jornada', t: 'Minha jornada', s: 'Dias e horários em que você atende', ic: 'relogio' },
      { href: '/painel/horarios', t: 'Bloqueios', s: 'Folgas e horários fechados', ic: 'bloqueio' },
      { href: '/painel/comissoes', t: 'Minha comissão', s: 'Quanto você fez no mês', ic: 'comissao' },
      { href: '/painel/conversas', t: 'Conversas', s: 'O WhatsApp da barbearia', ic: 'conversa' },
      (semAssistente || tetos.assistente === 0) ? null : { href: '/painel/ia', t: 'Assistente', s: 'Pergunte sobre a sua agenda', ic: 'assistente' },
    ].filter(Boolean)) },
    { t: 'Cadastros', itens: lista([
      { href: '/painel/clientes', t: 'Clientes', s: 'Contatos e histórico', ic: 'cliente' },
      { href: '/painel/servicos', t: 'Serviços', s: 'Preço e tempo de cada um', ic: 'tesoura' },
      { href: '/painel/produtos', t: 'Produtos', s: 'O que a barbearia vende', ic: 'loja' },
      { href: '/painel/estoque', t: 'Estoque', s: 'Quantidades de cada item', ic: 'estoque' },
      { href: '/painel/planos', t: 'Planos de assinatura', s: 'Pacotes mensais para os clientes', ic: 'cartao' },
    ]) },
  ];
  var conta = lista([
    { href: '/painel/perfil#pf-avisos', t: 'Notificações', s: 'Aviso de agendamento novo neste aparelho', ic: 'sino' },
    { href: '/painel/perfil#pf-backup', t: 'Exportar dados', s: 'Cópia em PDF e arquivo de backup', ic: 'exportar', admin: true },
    { href: 'mailto:' + (typeof suporteCortavo !== 'undefined' ? suporteCortavo : 'cortavo.app@gmail.com'), t: 'Ajuda', s: 'Fale com a Cortavo', ic: 'ajuda' },
  ]);
%>
<header class="cv-cab"><div class="cv-cab-txt"><h1>Mais</h1></div></header>

<div class="cv-secao" style="margin-top:16px">
  <a class="cv-cartao cv-toca cv-perfil" href="/painel/perfil" aria-label="Meu perfil: <%= nome %>">
    <span class="cv-avatar" aria-hidden="true"><% if (typeof usuarioFotoUrl !== 'undefined' && usuarioFotoUrl) { %><img src="<%= usuarioFotoUrl %>" alt="" /><% } else { %><%= iniciais %><% } %></span>
    <span class="corpo"><b><%= nome %></b><span><%= papelTxt %> na <%= nomeBarbearia %></span></span>
    <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
  </a>
</div>

<% if (ehAdmin && plano) { %>
  <div class="cv-secao" style="margin-top:12px">
    <a class="cv-objeto cv-gravada cv-toca cv-plano-obj" href="/painel/meu-plano">
      <span class="rot">Seu plano</span>
      <span class="linha"><span class="nome"><%= plano.nome %></span><span class="rot"><%= (typeof faixaTeste !== 'undefined' && faixaTeste) ? (faixaTeste.dias > 0 ? 'teste, ' + faixaTeste.dias + (faixaTeste.dias === 1 ? ' dia' : ' dias') : 'teste terminou') : 'ativo' %></span></span>
      <span class="rot rot--normal">O que inclui e quanto já usou</span>
    </a>
  </div>
<% } %>

<% secoes.forEach(function (sec) { if (!sec.itens.length) return; %>
  <section class="cv-secao" style="margin-top:28px" aria-labelledby="mais-<%= sec.t.replace(/\W+/g, '-').toLowerCase() %>">
    <div class="cv-secao-cab"><h2 id="mais-<%= sec.t.replace(/\W+/g, '-').toLowerCase() %>"><%= sec.t %></h2></div>
    <ul class="cv-lista">
      <% sec.itens.forEach(function (it) { %>
        <li><a class="cv-linha<%= it.cadeadoPlano ? ' bloqueada' : '' %>" href="<%= it.href %>"<% if (it.cadeadoPlano) { %> aria-label="<%= it.t %> (fora do plano)"<% } %>>
          <%- include('../partials/icone', { cvIc: it.ic }) %>
          <span class="corpo"><span class="t"><%= it.t %></span><% if (it.cadeadoPlano) { %><span class="s" style="margin-top:5px"><span class="cv-cadeado"><%- include('../partials/icone', { cvIc: 'cadeado' }) %>Plano <%= it.cadeadoPlano %></span></span><% } else if (it.s) { %><span class="s"><%= it.s %></span><% } %></span>
          <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a></li>
      <% }) %>
    </ul>
  </section>
<% }) %>

<% if (ehDono) { %>
  <div class="cv-secao" style="margin-top:28px">
    <div class="cv-cartao cv-nota-dono">
      <span>Você está operando <strong><%= nomeBarbearia %></strong> como dono do sistema.</span>
      <form method="POST" action="/mestre/sair"><button class="cv-btn cv-btn--2 cv-btn--p" type="submit"><%- include('../partials/icone', { cvIc: 'esquerda', cvCls: 'cv-ic--18' }) %>Voltar ao painel-mestre</button></form>
    </div>
  </div>
<% } %>

<section class="cv-secao" style="margin-top:28px" aria-labelledby="mais-conta">
  <div class="cv-secao-cab"><h2 id="mais-conta">Conta</h2></div>
  <ul class="cv-lista">
    <% conta.forEach(function (it) { %>
      <li><a class="cv-linha" href="<%= it.href %>">
        <%- include('../partials/icone', { cvIc: it.ic }) %>
        <span class="corpo"><span class="t"><%= it.t %></span><span class="s"><%= it.s %></span></span>
        <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </a></li>
    <% }) %>
    <li><form method="POST" action="/logout"><button class="cv-linha" type="submit">
      <%- include('../partials/icone', { cvIc: 'sair' }) %>
      <span class="corpo"><span class="t">Sair</span></span>
    </button></form></li>
  </ul>
</section>
