<%/* Comissões (redesign v3, F7). Mockup do barbeiro: redesign/v3/prints/11.
     - Barbeiro: "Minha comissão" (só a dele; o filtro é do servidor): objeto
       com o valor, de onde veio, ticket e ocupação, pagamentos ("Pago" com o C
       com check oficial; "Em aberto").
     - Admin: "Comissões" do período, uma linha por barbeiro com a situação
       (paga, parcial, aberta); a folha de cada um tem a % de serviço, foto,
       atendimentos e "Marcar como pago" (B5 do Beto, POST
       /painel/api/gestao/comissoes/baixa, com M1) e o Desfazer de cada baixa.
     Período: Hoje, Semana, Mês e datas (mesmos parâmetros de antes). */%>
<%
  function _milhar(n) { return String(Math.floor(Math.abs(n || 0))).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function _partes(c) { var v = Math.abs(c || 0) / 100; var s = v.toFixed(2).split('.'); return { int: _milhar(+s[0]), cent: ',' + s[1] }; }
  function _ddmm(iso) { var p = String(iso).slice(0, 10).split('-'); return p[2] + '/' + p[1]; }
  function _ini(n) { var p = String(n || '?').trim().split(/\s+/); return ((p[0] || '?')[0] + (p.length > 1 ? p[p.length - 1][0] : '')).toUpperCase(); }
  var SIT = { paga: 'Paga', parcial: 'Parte paga', aberta: 'Em aberto' };
  var sits = (typeof situacoes !== 'undefined' && situacoes) || {};
  var hist = (typeof pagamentosComissao !== 'undefined' && pagamentosComissao) || [];
  var qsBarb = ehAdmin ? '&barbeiro=' + barbeiroSelecionado : '';
  var euMesmo = !ehAdmin ? grupos[0] : null;
  var totalCom = _partes(totalGeralComissao);
%>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup"><%= nomePeriodo %></p><h1><%= ehAdmin ? 'Comissões' : 'Minha comissão' %></h1></div></header>

<div class="cv-secao" style="margin-top:16px">
  <nav class="cv-seg cv-cx-periodos" aria-label="Período">
    <a href="/painel/comissoes?inicio=<%= presetHoje.inicio %>&fim=<%= presetHoje.fim %><%= qsBarb %>" aria-current="<%= periodoAtivo === 'hoje' ? 'page' : 'false' %>">Hoje</a>
    <a href="/painel/comissoes?inicio=<%= presetSemana.inicio %>&fim=<%= presetSemana.fim %><%= qsBarb %>" aria-current="<%= periodoAtivo === 'semana' ? 'page' : 'false' %>">Semana</a>
    <a href="/painel/comissoes?inicio=<%= presetMes.inicio %>&fim=<%= presetMes.fim %><%= qsBarb %>" aria-current="<%= periodoAtivo === 'mes' ? 'page' : 'false' %>">Mês</a>
    <button type="button" class="cv-cx-cal" aria-current="<%= periodoAtivo === 'custom' ? 'page' : 'false' %>" aria-expanded="false" aria-controls="cm-custom" aria-label="Escolher datas<%= ehAdmin ? ' e barbeiro' : '' %>" onclick="var f=document.getElementById('cm-custom');f.hidden=!f.hidden;this.setAttribute('aria-expanded',String(!f.hidden))"><%- include('../partials/icone', { cvIc: 'calendario', cvCls: 'cv-ic--18' }) %></button>
  </nav>
  <form class="cv-cartao cv-cx-custom" id="cm-custom" method="GET" action="/painel/comissoes" hidden>
    <% if (ehAdmin) { %>
      <div class="cv-campo"><label for="cm-barbeiro">Barbeiro</label>
        <select class="cv-entrada" id="cm-barbeiro" name="barbeiro">
          <option value="todos">Todos</option>
          <% barbeiros.forEach(function (b) { %><option value="<%= b.id %>" <%= barbeiroSelecionado === String(b.id) ? 'selected' : '' %>><%= b.nome %></option><% }) %>
        </select>
      </div>
    <% } %>
    <div class="cv-cx-duas" style="margin-top:12px">
      <div class="cv-campo"><label for="cm-inicio">De</label><input class="cv-entrada" id="cm-inicio" type="date" name="inicio" value="<%= inicioStr %>" /></div>
      <div class="cv-campo"><label for="cm-fim">Até</label><input class="cv-entrada" id="cm-fim" type="date" name="fim" value="<%= fimStr %>" /></div>
    </div>
    <button type="submit" class="cv-btn cv-btn--2 cv-btn--largo" style="margin-top:12px">Ver</button>
  </form>
</div>

<% if (!ehAdmin) { %>
  <% if (!euMesmo) { %>
    <div class="cv-secao" style="margin-top:16px"><div class="cv-cartao cv-vazio"><h2>Sem comissão neste período</h2><p>A comissão aparece aqui assim que um atendimento seu for concluído.</p></div></div>
  <% } else { var g = euMesmo, eu = _partes(g.comissao), st = sits[g.barbeiro.id]; %>
    <div class="cv-secao" style="margin-top:14px">
      <section class="cv-objeto cv-gravada" aria-label="Sua comissão">
        <span class="rot">Comissão do período</span>
        <div style="margin-top:6px"><span class="cv-num cv-num--heroi" data-dig="<%= eu.int.length %>"><span class="moeda">R$</span><span class="int"><%= eu.int %></span><span class="cent"><%= eu.cent %></span></span></div>
        <span class="rot" style="display:block;margin-top:8px"><%= g.barbeiro.comissaoPercentual %>% nos serviços<%= g.produtoPct !== null ? ' e ' + g.produtoPct + '% nos produtos' : '' %></span>
      </section>
      <div class="cv-grade" style="margin-top:12px">
        <div class="cv-cartao"><div class="cv-resumo"><span class="rot">Atendimentos</span><span class="cv-cx-val"><%= g.qtd %></span></div></div>
        <div class="cv-cartao"><div class="cv-resumo"><span class="rot">Ticket médio</span><span class="cv-cx-val"><%= fmtBRL(g.ticketMedio) %></span></div></div>
      </div>
    </div>
    <section class="cv-secao" aria-labelledby="cm-origem">
      <div class="cv-secao-cab"><h2 id="cm-origem">De onde veio</h2></div>
      <ul class="cv-lista">
        <li><div class="cv-linha"><%- include('../partials/icone', { cvIc: 'tesoura' }) %><span class="corpo"><span class="t">Serviços</span><span class="s"><%= fmtBRL(g.servicosTotal) %> faturados</span></span><span class="fim"><b><%= fmtBRL(g.comissaoServicos) %></b></span></div></li>
        <li><div class="cv-linha"><%- include('../partials/icone', { cvIc: 'estoque' }) %><span class="corpo"><span class="t">Produtos</span><span class="s"><%= fmtBRL(g.produtosTotal) %> vendidos</span></span><span class="fim"><b><%= fmtBRL(g.comissaoProdutos) %></b></span></div></li>
      </ul>
    </section>
    <section class="cv-secao" aria-labelledby="cm-pag">
      <div class="cv-secao-cab"><h2 id="cm-pag">Pagamentos</h2></div>
      <ul class="cv-lista cv-cm-pagos">
        <% hist.forEach(function (p) { %>
          <li><div class="cv-linha cv-linha--quebra"><%- include('../partials/logo-c', { cvTam: 30 }) %><span class="corpo"><span class="t">Pago</span><span class="s">em <%= _ddmm(new Date(p.pagoEm).toISOString()) %>, de <%= _ddmm(p.de) %> a <%= _ddmm(p.ate) %></span></span><span class="fim"><b><%= fmtBRL(p.valor) %></b></span></div></li>
        <% }) %>
        <% if (!st || st.aPagar > 0) { %>
          <li><div class="cv-linha cv-linha--quebra"><%- include('../partials/icone', { cvIc: 'relogio' }) %><span class="corpo"><span class="t">Em aberto<%= st ? ': ' + fmtBRL(st.aPagar) : '' %></span><span class="s">O responsável marca como pago quando acertar com você</span></span></div></li>
        <% } %>
      </ul>
    </section>
  <% } %>
<% } else { %>
  <div class="cv-secao" style="margin-top:14px">
    <section class="cv-objeto cv-gravada" aria-label="Comissões do período">
      <span class="rot">Comissões do período</span>
      <div style="margin-top:6px"><span class="cv-num cv-num--heroi" data-dig="<%= totalCom.int.length %>"><span class="moeda">R$</span><span class="int"><%= totalCom.int %></span><span class="cent"><%= totalCom.cent %></span></span></div>
      <span class="rot" style="display:block;margin-top:8px">Faturado <%= fmtBRL(totalServicos + totalProdutos) %>, produtos com <%= comissaoProdutoPct %>% padrão</span>
    </section>
  </div>
  <section class="cv-secao" aria-labelledby="cm-equipe">
    <div class="cv-secao-cab"><h2 id="cm-equipe">Por barbeiro</h2></div>
    <% if (!grupos.length) { %>
      <div class="cv-cartao cv-vazio"><p>Nenhum barbeiro para mostrar.</p></div>
    <% } else { %>
      <ul class="cv-lista cv-cm-lista">
        <% grupos.forEach(function (g) { var st = sits[g.barbeiro.id]; %>
          <li><button type="button" class="cv-linha" onclick="cmAbrir(<%= g.barbeiro.id %>)">
            <span class="cv-avatar cv-avatar--claro" aria-hidden="true"><% if (g.barbeiro.fotoUrl) { %><img src="<%= g.barbeiro.fotoUrl %>" alt="" /><% } else { %><%= _ini(g.barbeiro.nome) %><% } %></span>
            <span class="corpo"><span class="t"><%= g.barbeiro.nome %></span><span class="s">Faturado <%= fmtBRL(g.faturadoTotal) %>, <%= g.barbeiro.comissaoPercentual %>%</span></span>
            <span class="cv-cm-dir"><b><%= fmtBRL(g.comissao) %></b><% if (st && g.comissao > 0) { %><span class="cv-etiqueta<%= st.situacao === 'paga' ? ' cv-etiqueta--preta' : '' %>"><%= SIT[st.situacao] %></span><% } %></span>
          </button></li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <% grupos.forEach(function (g) { var st = sits[g.barbeiro.id]; var hb = hist.filter(function (p) { return p.usuarioId === g.barbeiro.id; }); %>
  <section class="cv-folha cv-cm-folha" id="cm-folha-<%= g.barbeiro.id %>" role="dialog" aria-modal="true" aria-labelledby="cm-tit-<%= g.barbeiro.id %>">
    <div class="cv-folha-zona">
      <div class="cv-puxador" aria-hidden="true"></div>
      <div class="cv-folha-cab"><h2 id="cm-tit-<%= g.barbeiro.id %>" tabindex="-1" data-foco><%= g.barbeiro.nome %></h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button></div>
    </div>
    <div class="cv-folha-corpo">
      <div class="cv-cm-topo">
        <form method="POST" action="/painel/comissoes/<%= g.barbeiro.id %>/foto" enctype="multipart/form-data" class="cv-cm-foto">
          <input type="hidden" name="inicio" value="<%= inicioStr %>" /><input type="hidden" name="fim" value="<%= fimStr %>" /><input type="hidden" name="barbeiro" value="<%= barbeiroSelecionado %>" />
          <label class="cv-avatar" title="Trocar a foto"><% if (g.barbeiro.fotoUrl) { %><img src="<%= g.barbeiro.fotoUrl %>" alt="Foto de <%= g.barbeiro.nome %>" /><% } else { %><%= _ini(g.barbeiro.nome) %><% } %><input type="file" name="foto" accept="image/*" onchange="this.form.submit()" hidden /></label>
          <% if (g.barbeiro.fotoUrl) { %><button type="submit" class="cv-btn cv-btn--texto cv-btn--p" formaction="/painel/comissoes/<%= g.barbeiro.id %>/foto/remover" formmethod="post" formnovalidate onclick="return confirm('Remover a foto deste barbeiro?')">Remover foto</button><% } %>
        </form>
        <div class="cv-grade" style="flex:1">
          <div class="cv-cartao"><div class="cv-resumo"><span class="rot">Comissão</span><span class="cv-cx-val"><%= fmtBRL(g.comissao) %></span></div></div>
          <div class="cv-cartao"><div class="cv-resumo"><span class="rot">Ocupação</span><span class="cv-cx-val"><%= g.ocupacaoPct === null ? '—' : g.ocupacaoPct + '%' %></span></div></div>
        </div>
      </div>

      <section class="cv-objeto cv-cm-pagar" aria-label="Pagamento da comissão">
        <span class="rot">A pagar no período</span>
        <div class="cv-cm-pagar-num"><%= fmtBRL(st ? st.aPagar : g.comissao) %></div>
        <% if (st && st.pago) { %><span class="rot">Já pago: <%= fmtBRL(st.pago) %></span><% } %>
        <% if (!st || st.aPagar > 0) { %>
          <label class="cv-cm-check"><input type="checkbox" data-caixa checked /><span>Lançar a saída no caixa</span></label>
          <select class="cv-cm-forma" data-forma aria-label="Forma do pagamento"><option value="pix">Pix</option><option value="dinheiro">Dinheiro</option><option value="debito">Débito</option></select>
          <button type="button" class="cv-btn cv-btn--largo cv-cm-baixa" data-baixa="<%= g.barbeiro.id %>" data-de="<%= inicioStr %>" data-ate="<%= fimStr %>" data-nome="<%= g.barbeiro.nome.split(' ')[0] %>">Marcar como pago</button>
          <p class="cv-erro" data-erro hidden role="alert"></p>
        <% } else { %>
          <p class="cv-cm-pago"><%- include('../partials/logo-c', { cvTam: 30 }) %>Comissão do período paga.</p>
        <% } %>
      </section>
      <% if (hb.length) { %>
        <ul class="cv-lista cv-cm-pagos" style="margin-top:12px">
          <% hb.forEach(function (p) { %>
            <li><div class="cv-linha cv-linha--quebra"><%- include('../partials/logo-c', { cvTam: 30 }) %><span class="corpo"><span class="t">Pago em <%= _ddmm(new Date(p.pagoEm).toISOString()) %></span><span class="s"><%= _ddmm(p.de) %> a <%= _ddmm(p.ate) %><%= p.pagoPorNome ? ', por ' + p.pagoPorNome.split(' ')[0] : '' %></span></span><span class="fim"><b><%= fmtBRL(p.valor) %></b></span><button type="button" class="cv-btn cv-btn--texto cv-btn--p" data-desfazer-baixa="<%= p.id %>">Desfazer</button></div></li>
          <% }) %>
        </ul>
      <% } %>

      <form method="POST" action="/painel/comissoes/percentual/<%= g.barbeiro.id %>" class="cv-cm-pct">
        <input type="hidden" name="inicio" value="<%= inicioStr %>" /><input type="hidden" name="fim" value="<%= fimStr %>" /><input type="hidden" name="barbeiro" value="<%= barbeiroSelecionado %>" />
        <div class="cv-campo"><label for="cm-pct-<%= g.barbeiro.id %>">Comissão nos serviços, em %</label><input class="cv-entrada" id="cm-pct-<%= g.barbeiro.id %>" type="number" name="percentual" step="0.5" min="0" max="100" value="<%= g.barbeiro.comissaoPercentual %>" /></div>
        <p class="cv-ajuda">Nos produtos vale a % de cada produto<%= g.produtoPct !== null ? '; neste período deu ' + g.produtoPct + '%' : '' %>.</p>
        <button class="cv-btn cv-btn--2 cv-btn--largo" type="submit" style="margin-top:12px">Salvar a porcentagem</button>
      </form>

      <h3 class="cv-cm-h3">Atendimentos</h3>
      <% if (!g.atendimentos.length) { %>
        <p class="cv-texto-apoio">Nenhum atendimento concluído neste período.</p>
      <% } else { %>
        <ul class="cv-lista cv-lista--sem-ic">
          <% g.atendimentos.forEach(function (a) { %>
            <li><div class="cv-linha cv-linha--quebra"><span class="corpo"><span class="t"><%= a.ag.clienteNome %></span><span class="s"><%= a.itens.map(function (it) { return it.nome; }).join(' + ') %>, <%= a.ag.horaInicio %></span></span><span class="fim"><b><%= fmtBRL(a.servicosSub + a.produtosSub) %></b></span></div></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </section>
  <% }) %>
<% } %>
