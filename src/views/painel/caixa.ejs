<%/* Caixa (redesign v3, fatia F6). Mockup: redesign/v3/prints/10-caixa-390.png.
     Objeto-herói = o saldo do período; "Lançar" (cinza) e "Fechar caixa"
     (vidro preto, leva a /painel/caixa/fechar); formas de pagamento em pilha;
     composição; extrato. Nada saiu do que já existia: período personalizado,
     a receber, exclusão de lançamento, formas de pagamento.
     Permissões (B2): Lançar e Fechar com caixa_lancar; Excluir só admin.
     Estilos em public/css/cv-caixa.css; comportamento em public/js/cv-caixa.js.
     cxFolha('novo', true) continua global: a folha Novo da navbar abre o
     lançamento por ?abrir=lancamento. */%>
<%
  function _milhar(n) { return String(Math.floor(Math.abs(n || 0))).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function _partes(c) { var v = Math.abs(c || 0) / 100; var s = v.toFixed(2).split('.'); return { int: (c < 0 ? '−' : '') + _milhar(+s[0]), cent: ',' + s[1] }; }
  var _lancar = (typeof podeLancarCaixa === 'undefined' || podeLancarCaixa);
  var _saldo = _partes(resumoPeriodo.saldo);
  var _nEnt = (lancamentos || []).filter(function (l) { return l.tipo === 'entrada'; }).length;
  var _nSai = (lancamentos || []).length - _nEnt;
  var _totalFormas = formasPagamento.reduce(function (s, f) { return s + f.valorCentavos; }, 0) || 1;
  var _tons = ['var(--d-1)', 'var(--d-2)', 'var(--d-3)', 'var(--d-trilho)'];
  var _rotSaldo = { hoje: 'Saldo de hoje', semana: 'Saldo da semana', mes: 'Saldo do mês' }[periodoAtivo] || 'Saldo do período';
%>
<header class="cv-cab"><div class="cv-cab-txt"><p class="cv-cab-sup"><%= nomePeriodoSel %></p><h1>Caixa</h1></div></header>

<div class="cv-secao" style="margin-top:16px">
  <nav class="cv-seg cv-cx-periodos" aria-label="Período">
    <a href="/painel/caixa?inicio=<%= presetHoje.inicio %>&fim=<%= presetHoje.fim %>" aria-current="<%= periodoAtivo === 'hoje' ? 'page' : 'false' %>">Hoje</a>
    <a href="/painel/caixa?inicio=<%= presetSemana.inicio %>&fim=<%= presetSemana.fim %>" aria-current="<%= periodoAtivo === 'semana' ? 'page' : 'false' %>">Semana</a>
    <a href="/painel/caixa?inicio=<%= presetMes.inicio %>&fim=<%= presetMes.fim %>" aria-current="<%= periodoAtivo === 'mes' ? 'page' : 'false' %>">Mês</a>
    <button type="button" class="cv-cx-cal" aria-current="<%= periodoAtivo === 'custom' ? 'page' : 'false' %>" aria-expanded="false" aria-controls="cx-custom" aria-label="Escolher datas: <%= periodoCustomLabel %>" onclick="var f=document.getElementById('cx-custom');f.hidden=!f.hidden;this.setAttribute('aria-expanded',String(!f.hidden))"><%- include('../partials/icone', { cvIc: 'calendario', cvCls: 'cv-ic--18' }) %></button>
  </nav>
  <form class="cv-cartao cv-cx-custom" id="cx-custom" method="GET" action="/painel/caixa" hidden>
    <div class="cv-cx-duas">
      <div class="cv-campo"><label for="cx-inicio">De</label><input class="cv-entrada" id="cx-inicio" type="date" name="inicio" value="<%= inicioStr %>" /></div>
      <div class="cv-campo"><label for="cx-fim">Até</label><input class="cv-entrada" id="cx-fim" type="date" name="fim" value="<%= fimStr %>" /></div>
    </div>
    <div class="cv-chips cv-cx-atalhos">
      <% atalhosPeriodo.forEach(function (a) { %><button type="button" class="cv-chip" aria-pressed="false" data-inicio="<%= a.inicio %>" data-fim="<%= a.fim %>"><span><%= a.label %></span></button><% }) %>
    </div>
    <button type="submit" class="cv-btn cv-btn--2 cv-btn--largo">Ver este período</button>
  </form>
</div>

<div class="cv-secao" style="margin-top:14px">
  <section class="cv-objeto cv-gravada" aria-label="<%= _rotSaldo %>">
    <span class="rot"><%= _rotSaldo %></span>
    <div style="margin-top:6px"><span class="cv-num cv-num--heroi" data-dig="<%= _saldo.int.length %>"><span class="moeda">R$</span><span class="int"><%= _saldo.int %></span><span class="cent"><%= _saldo.cent %></span></span></div>
    <div class="cv-cx-es">
      <div><span class="rot">Entradas</span><b><%= fmtBRL(resumoPeriodo.entrou) %></b><span class="rot rot--p"><%= _nEnt %> <%= _nEnt === 1 ? 'lançamento' : 'lançamentos' %></span></div>
      <div><span class="rot">Saídas</span><b><%= fmtBRL(resumoPeriodo.saiu) %></b><span class="rot rot--p"><%= _nSai %> <%= _nSai === 1 ? 'lançamento' : 'lançamentos' %></span></div>
    </div>
  </section>
  <% if (_lancar) { %>
    <div class="cv-cx-acoes">
      <button type="button" class="cv-btn cv-btn--2 cv-cx-lancar" onclick="cxFolha('novo', true)"><%- include('../partials/icone', { cvIc: 'mais', cvCls: 'cv-ic--20' }) %>Lançar</button>
      <a class="cv-btn" href="/painel/caixa/fechar">Fechar caixa</a>
    </div>
  <% } %>
</div>

<% if (aReceber && aReceber.quantidade) { %>
  <div class="cv-secao" style="margin-top:12px">
    <a class="cv-cartao cv-toca cv-cx-receber" href="/painel/agenda">
      <%- include('../partials/icone', { cvIc: 'relogio' }) %>
      <span class="corpo"><b><%= fmtBRL(aReceber.valor) %> a receber</b><span><%= aReceber.quantidade %> <%= aReceber.quantidade === 1 ? 'atendimento aberto' : 'atendimentos abertos' %> na agenda</span></span>
      <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </a>
  </div>
<% } %>

<section class="cv-secao" aria-labelledby="cx-formas">
  <div class="cv-secao-cab"><h2 id="cx-formas">Por forma de pagamento</h2></div>
  <div class="cv-cartao">
    <% if (!formasPagamento.length) { %>
      <p class="cv-texto-apoio">Nenhuma entrada com forma de pagamento neste período.</p>
    <% } else { %>
      <div class="cv-pilha" role="img" aria-label="<%= formasPagamento.map(function (f) { return f.label + ' ' + Math.round(f.valorCentavos / _totalFormas * 100) + '%'; }).join(', ') %>"><% formasPagamento.slice(0, 4).forEach(function (f) { %><i style="width:<%= (f.valorCentavos / _totalFormas * 100).toFixed(1) %>%"></i><% }) %></div>
      <div class="cv-pilha-leg"><% formasPagamento.slice(0, 4).forEach(function (f, i) { %><div><i style="background:<%= _tons[i] %>"></i><span><%= f.curto || f.label %></span><b><%= fmtBRL(f.valorCentavos) %></b><span><%= Math.round(f.valorCentavos / _totalFormas * 100) %>%</span></div><% }) %></div>
    <% } %>
  </div>
</section>

<section class="cv-secao" aria-labelledby="cx-comp">
  <div class="cv-secao-cab"><h2 id="cx-comp">Composição</h2></div>
  <div class="cv-grade">
    <div class="cv-cartao"><div class="cv-resumo"><span class="rot">Serviços</span><span class="cv-cx-val"><%= fmtBRL(servicosValor) %></span></div></div>
    <div class="cv-cartao"><div class="cv-resumo"><span class="rot">Produtos</span><span class="cv-cx-val"><%= fmtBRL(produtosValor) %></span></div></div>
    <div class="cv-cartao"><div class="cv-resumo"><span class="rot">Comissão</span><span class="cv-cx-val"><%= fmtBRL(comissaoValor) %></span></div></div>
    <div class="cv-cartao"><div class="cv-resumo"><span class="rot">Saídas</span><span class="cv-cx-val"><%= fmtBRL(resumoPeriodo.saiu) %></span></div></div>
  </div>
</section>

<section class="cv-secao" aria-labelledby="cx-extrato">
  <div class="cv-secao-cab"><h2 id="cx-extrato"><%= extratoLabel %></h2></div>
  <% if (extrato.length === 0) { %>
    <div class="cv-cartao cv-vazio" style="padding:24px"><p>Nenhum lançamento neste período. Os atendimentos concluídos entram aqui sozinhos.</p></div>
  <% } else { %>
    <ul class="cv-lista cv-cx-extrato cv-so-cel">
      <% extrato.forEach(function (ex) { %>
        <li><div class="cv-linha cv-linha--quebra">
          <span class="cv-cx-quando"><b><%= ex.hora %></b><% if (ex.diaLabel) { %><small><%= ex.diaLabel %></small><% } %></span>
          <span class="corpo"><span class="t"><%= ex.descricao %></span><% if (ex.sub) { %><span class="s"><%= ex.sub %></span><% } %></span>
          <span class="fim"><b><%= ex.entrada ? '+' : '−' %>&nbsp;<%= fmtBRL(ex.valor) %></b></span>
          <% if (typeof podeRemoverCaixa === 'undefined' || podeRemoverCaixa) { %>
          <form method="POST" action="/painel/caixa/<%= ex.id %>/remover" onsubmit="return confirm('Excluir este lançamento?')">
            <input type="hidden" name="inicio" value="<%= inicioStr %>" />
            <input type="hidden" name="fim" value="<%= fimStr %>" />
            <button class="cv-redondo cv-redondo--leve" aria-label="Excluir o lançamento <%= ex.descricao %>"><%- include('../partials/icone', { cvIc: 'lixo', cvCls: 'cv-ic--16' }) %></button>
          </form>
          <% } %>
        </div></li>
      <% }) %>
    </ul>
    <%/* PC (>= 1024): o extrato em tabela (Dani, painel-pc "Caixa"). */%>
    <div class="cv-tabela">
      <table>
        <thead><tr><th>Quando</th><th>Descrição</th><th>Detalhe</th><th class="dir">Valor</th><% if (typeof podeRemoverCaixa === 'undefined' || podeRemoverCaixa) { %><th><span class="cv-oculto">Ações</span></th><% } %></tr></thead>
        <tbody>
          <% extrato.forEach(function (ex) { %>
            <tr style="cursor:default">
              <td><b><%= ex.hora %></b><% if (ex.diaLabel) { %> <span style="color:var(--c-apoio)"><%= ex.diaLabel %></span><% } %></td>
              <td><%= ex.descricao %></td>
              <td style="color:var(--c-apoio)"><%= ex.sub || '' %></td>
              <td class="dir"><b><%= ex.entrada ? '+' : '−' %>&nbsp;<%= fmtBRL(ex.valor) %></b></td>
              <% if (typeof podeRemoverCaixa === 'undefined' || podeRemoverCaixa) { %>
              <td class="dir"><form method="POST" action="/painel/caixa/<%= ex.id %>/remover" onsubmit="return confirm('Excluir este lançamento?')"><input type="hidden" name="inicio" value="<%= inicioStr %>" /><input type="hidden" name="fim" value="<%= fimStr %>" /><button class="cv-redondo cv-redondo--leve" aria-label="Excluir o lançamento <%= ex.descricao %>"><%- include('../partials/icone', { cvIc: 'lixo', cvCls: 'cv-ic--16' }) %></button></form></td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (extratoRestantes > 0) { %><p class="cv-cx-mais">E mais <%= extratoRestantes %> <%= extratoRestantes === 1 ? 'lançamento anterior' : 'lançamentos anteriores' %> neste período.</p><% } %>
  <% } %>
</section>

<% if (_lancar) { %>
<%/* Folha: novo lançamento (Entrada ou Saída, valor, descrição, forma, data). */%>
<section class="cv-folha cv-cx-folha" id="cx-folha-novo" role="dialog" aria-modal="true" aria-labelledby="cx-novo-tit">
  <div class="cv-folha-zona">
    <div class="cv-puxador" aria-hidden="true"></div>
    <div class="cv-folha-cab"><h2 id="cx-novo-tit" tabindex="-1" data-foco>Novo lançamento</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button></div>
  </div>
  <div class="cv-folha-corpo">
    <form method="POST" action="/painel/caixa" id="cx-form-novo">
      <input type="hidden" name="inicio" value="<%= inicioStr %>" />
      <input type="hidden" name="fim" value="<%= fimStr %>" />
      <input type="hidden" name="tipo" id="tipo-novo" value="entrada" />
      <div class="cv-seg" role="group" aria-label="Tipo de lançamento">
        <button type="button" data-tipo="entrada" aria-pressed="true">Entrada</button>
        <button type="button" data-tipo="saida" aria-pressed="false">Saída</button>
      </div>
      <div class="cv-campo"><label for="valor-novo">Valor, em reais</label><input class="cv-entrada cv-entrada--num" id="valor-novo" name="valor" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" required /></div>
      <div class="cv-campo"><label for="descricao-novo">Descrição</label><input class="cv-entrada" id="descricao-novo" name="descricao" placeholder="Aluguel, luz, corte do João…" maxlength="120" autocomplete="off" required /></div>
      <div class="cv-campo">
        <span class="cv-rotulo" id="rot-forma">Forma de pagamento, opcional</span>
        <input type="hidden" name="formaPagamento" id="formaPagamento-novo" />
        <div class="cv-chips cv-cx-formas" role="group" aria-labelledby="rot-forma">
          <% formasPagamentoOpcoes.forEach(function (f) { %><button type="button" class="cv-chip" aria-pressed="false" data-valor="<%= f.valor %>"><span><%= f.curto %></span></button><% }) %>
        </div>
        <span class="cv-ajuda" id="ajuda-forma" hidden>Saída em dinheiro entra na conferência da gaveta ao fechar o caixa.</span>
      </div>
      <div class="cv-campo"><label for="data-novo">Data</label><input class="cv-entrada" id="data-novo" name="data" type="date" value="<%= hojeIso %>" /></div>
      <button class="cv-btn cv-btn--largo" type="submit" style="margin-top:20px">Lançar</button>
    </form>
  </div>
</section>
<% } %>
