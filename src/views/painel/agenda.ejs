<%/* Agenda (redesign v3, fatia F4, reescrita sem a pilha antiga).
     Mockups: redesign/v3/prints/03-agenda-390.png e 04b-novo-agendamento-390.png.
     Cabeçalho com a data (abre a folha de mês) e "Bloquear", tira de dias,
     chips de barbeiro, a linha do dia (cv-tl) e as quatro folhas (mês,
     bloqueio, novo e detalhe) no componente .cv-folha.
     Estilos em public/css/cv-agenda.css; comportamento em public/js/cv-agenda.js. */%>
<%
  function _iniciais(nome) {
    var p = String(nome).trim().split(/\s+/);
    return p.length > 1 ? (p[0][0] + p[p.length - 1][0]).toUpperCase() : p[0].slice(0, 2).toUpperCase();
  }
  // Rótulo do selo da ficha. "Agora" é o atendimento da vez (o mesmo que sai
  // invertido); os demais abertos são "Confirmado", como na referência.
  function _selo(ag) {
    if (ag.status === 'cancelado') return 'Cancelado';
    if (ag.status === 'faltou') return 'Faltou';
    if (ag.status === 'concluido') return 'Concluído';
    return ag.id === proximoId ? 'Agora' : 'Confirmado';
  }
  var qsBarbeiro = ehAdmin ? '&barbeiro=' + barbeiroSelecionado : '';
  var mesCurto = mesLabel.toLowerCase().slice(0, 3);
%>

<%
  var _diaSemana = String(dataExtenso || '').split(',')[0];
  var _supData = _diaSemana.charAt(0).toUpperCase() + _diaSemana.slice(1) + ', ' + diaNum + ' de ' + String(mesLabel).toLowerCase();
  var _ehHoje = dataStr === dataHoje;
  var _agora = new Date();
  var _minAgora = _agora.getHours() * 60 + _agora.getMinutes();
  var _horaAgora = String(_agora.getHours()).padStart(2, '0') + ':' + String(_agora.getMinutes()).padStart(2, '0');
  function _minA(hhmm) { var p = String(hhmm).split(':'); return (+p[0]) * 60 + (+p[1]); }
  // Agenda de um barbeiro só: dá para mostrar os horários livres (cv-agenda.js).
  var _barbeiroUnico = ehAdmin ? (barbeiroSelecionado !== 'todos' ? barbeiroSelecionado : '') : String(usuario.id);
  var _nAtend = agendamentos.filter(function (a) { return a.status !== 'cancelado'; }).length;
  // Bloquear: admin sempre; barbeiro com "horarios" liberado (a própria agenda).
  var _podeBloquear = ehAdmin || (typeof pode === 'function' ? pode('horarios') : (typeof podeAcessar !== 'function' || podeAcessar('/painel/horarios')));
%>
<div class="cv-agenda">

  <header class="cv-cab">
    <div class="cv-cab-txt">
      <%/* A data abre a folha de mês, como antes. */%>
      <button type="button" class="cv-cab-sup cv-ag-data" onclick="abrirModal('mes')" aria-label="Escolher mês: <%= _supData %>"><%= _supData %><%- include('../partials/icone', { cvIc: 'baixo', cvCls: 'cv-ic--16' }) %></button>
      <h1>Agenda</h1>
    </div>
    <div class="cv-cab-acoes">
      <% if (_podeBloquear) { %>
        <button type="button" class="cv-btn cv-btn--2 cv-btn--p cv-ag-bloquear" onclick="abrirModal('bloqueio')"><%- include('../partials/icone', { cvIc: 'bloqueio', cvCls: 'cv-ic--18' }) %>Bloquear</button>
      <% } %>
    </div>
  </header>

  <div class="cv-secao" style="margin-top:18px">
    <%/* Tira de dias: o mês inteiro, rolável. O script do fim do arquivo traz o
         dia selecionado para o centro (cv-agenda.js). */%>
    <div class="cv-dias cv-dias--rola" id="cv-ag-dias" role="group" aria-label="Dia">
      <% faixaDias.forEach(function (d) { %>
        <a href="/painel/agenda?data=<%= d.iso %><%= qsBarbeiro %>" class="cv-dia <%= d.selecionado ? 'sel' : '' %>" aria-pressed="<%= d.selecionado ? 'true' : 'false' %>"<% if (d.selecionado) { %> aria-current="date"<% } %>>
          <small><%= d.ehHoje ? 'Hoje' : d.rotulo %></small><b><%= d.num %></b>
        </a>
      <% }) %>
    </div>

    <% if (ehAdmin) { %>
      <div class="cv-chips" style="margin-top:14px" role="group" aria-label="Barbeiro">
        <a href="/painel/agenda?data=<%= dataStr %>&barbeiro=todos" class="cv-chip" aria-pressed="<%= barbeiroSelecionado === 'todos' ? 'true' : 'false' %>"><span>Todos</span></a>
        <% barbeiros.forEach(function (b) { %>
          <a href="/painel/agenda?data=<%= dataStr %>&barbeiro=<%= b.id %>" class="cv-chip" aria-pressed="<%= barbeiroSelecionado === String(b.id) ? 'true' : 'false' %>" title="<%= b.nome %>"><span><%= b.nome.split(' ')[0] %></span></a>
        <% }) %>
      </div>
    <% } %>

    <p class="cv-ag-resumo" id="cv-ag-resumo" data-n="<%= _nAtend %>"><%= _nAtend ? _nAtend + (_nAtend === 1 ? ' atendimento' : ' atendimentos') : 'Nenhum atendimento marcado' %></p>

    <% if (agendamentos.length === 0 && bloqueios.length === 0) { %>
      <div class="cv-cartao cv-vazio cv-ag-vazio" style="padding:28px 24px">
        <h2 style="font-size:19px">Dia livre</h2>
        <p>Nenhum horário marcado. Os clientes podem marcar pelo link de agendamento.</p>
        <div class="acoes"><button type="button" class="cv-btn cv-btn--2" onclick="abrirModal('novo')"><%- include('../partials/icone', { cvIc: 'novoAg', cvCls: 'cv-ic--18' }) %>Novo agendamento</button></div>
      </div>
    <% } %>

    <%
      // Agendamentos e bloqueios dividem a mesma linha do tempo, pela hora.
      var eventos = [];
      agendamentos.forEach(function (ag) { eventos.push({ tipo: 'ag', ag: ag, ini: _minA(ag.horaInicio) }); });
      bloqueios.forEach(function (bl) { eventos.push({ tipo: 'bloq', bl: bl, ini: _minA(bl.horaInicio) }); });
      eventos.sort(function (a, b) { return a.ini - b.ini; });
      var _linhaPosta = !_ehHoje;
      // Estado escrito, nunca só cor. "Faltou" separado de "Cancelado" (spec 12).
      var ESTADOS = {
        concluido: { cls: 'feito', ic: 'check', txt: 'Concluído' },
        faltou: { cls: 'faltou', ic: 'faltou', txt: 'Faltou' },
        cancelado: { cls: 'cancelado', ic: 'fechar', txt: 'Cancelado' },
      };
    %>
    <div class="cv-tl" id="cv-ag-tl" data-barbeiro="<%= _barbeiroUnico %>" data-data="<%= dataStr %>" data-hoje="<%= _ehHoje ? '1' : '' %>" data-agora="<%= _minAgora %>">
      <% eventos.forEach(function (e) { %>
        <% if (!_linhaPosta && e.ini > _minAgora) { _linhaPosta = true; %>
          <div class="cv-agora-linha" data-min="<%= _minAgora %>" aria-label="Agora, <%= _horaAgora %>"><span><%= _horaAgora %></span><i></i></div>
        <% } %>
        <% if (e.tipo === 'ag') { var ag = e.ag; %>
          <%
            var servicosLabel = ag.itens.map(function (it) { return it.servico.nome; }).join(' + ') || 'Atendimento';
            var est = ESTADOS[ag.status] || (ag.id === proximoId ? { cls: 'proximo', txt: 'Agora' } : { cls: '', txt: 'Confirmado' });
          %>
          <div class="cv-tl-item" data-min="<%= e.ini %>">
            <span class="cv-tl-hora"><%= ag.horaInicio %></span>
            <button type="button" onclick="abrirModal(<%= ag.id %>)" class="cv-ag cv-toca <%= est.cls %>" aria-label="<%= ag.clienteNome %>, <%= ag.horaInicio %>, <%= est.txt %>. Abrir atendimento">
              <span class="cv-avatar cv-avatar--p<%= est.cls === 'proximo' ? ' cv-avatar--branco' : ' cv-avatar--claro' %>" aria-hidden="true"><%= _iniciais(ag.clienteNome) %></span>
              <span class="corpo">
                <span class="t"><%= ag.clienteNome %></span>
                <span class="s"><%= servicosLabel %><% if (mostrarBarbeiroNoCard) { %> com <%= ag.usuario.nome.split(' ')[0] %><% } %><% if (ag.clientePlanoId) { %> · <span class="cv-ag-plano-tag">Plano<% if (ag.clientePlano && ag.clientePlano.plano) { %> <%= ag.clientePlano.plano.nome %><% } %></span><% } %></span>
              </span>
              <span class="est"><% if (est.ic) { %><%- include('../partials/icone', { cvIc: est.ic, cvCls: 'cv-ic--16' }) %><% } %><%= est.txt %></span>
            </button>
          </div>
        <% } else { var bl = e.bl; %>
          <div class="cv-tl-item" data-min="<%= e.ini %>" data-fim="<%= _minA(bl.horaFim) %>">
            <span class="cv-tl-hora"><%= bl.horaInicio %></span>
            <div class="cv-ag bloqueado">
              <span class="etq" title="<%= bl.motivo || 'Bloqueado' %> até <%= bl.horaFim %>"><%- include('../partials/icone', { cvIc: 'bloqueio', cvCls: 'cv-ic--16' }) %><span><%= bl.motivo || 'Bloqueado' %> até <%= bl.horaFim %><% if (mostrarBarbeiroNoCard) { %> · <%= bl.usuario.nome.split(' ')[0] %><% } %></span></span>
              <% if (ehAdmin) { %>
                <form method="POST" action="/painel/agenda/bloqueios/<%= bl.id %>/remover" onsubmit="return confirm('Remover este bloqueio?')" class="cv-ag-bloq-rem">
                  <input type="hidden" name="retornoData" value="<%= dataStr %>" />
                  <input type="hidden" name="retornoBarbeiro" value="<%= barbeiroSelecionado %>" />
                  <button type="submit" class="cv-redondo" aria-label="Remover bloqueio das <%= bl.horaInicio %>"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--16' }) %></button>
                </form>
              <% } %>
            </div>
          </div>
        <% } %>
      <% }) %>
      <% if (!_linhaPosta && eventos.length) { %>
        <div class="cv-agora-linha" data-min="<%= _minAgora %>" aria-label="Agora, <%= _horaAgora %>"><span><%= _horaAgora %></span><i></i></div>
      <% } %>
    </div>
  </div>

</div>

<%/* ------------------------------------------------------------------------
     Folhas (M4). Uma aberta por vez, pelo Cortavo.folha (cv-movimento.js):
     sobe com mola, arrasta, fecha pelo véu, Esc ou "×". As funções globais
     abrirModal(id) e fecharModal() continuam existindo (cv-agenda.js), porque
     a folha Novo da navbar abre estas folhas por ?abrir=.
     --------------------------------------------------------------------- */%>

<%/* Folha: escolher mês (ano navegável + os 12 meses) */%>
<section class="cv-folha cv-ag-folha" id="agm-mes" role="dialog" aria-modal="true" aria-labelledby="agm-mes-tit">
  <div class="cv-folha-zona">
    <div class="cv-puxador" aria-hidden="true"></div>
    <div class="cv-folha-cab"><h2 id="agm-mes-tit" tabindex="-1" data-foco>Escolher mês</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button></div>
  </div>
  <div class="cv-folha-corpo">
    <div class="cv-ag-ano">
      <a class="cv-redondo cv-redondo--leve" href="/painel/agenda?data=<%= dataStr %><%= qsBarbeiro %>&anoPicker=<%= anoPicker - 1 %>" aria-label="Ano anterior"><%- include('../partials/icone', { cvIc: 'esquerda', cvCls: 'cv-ic--18' }) %></a>
      <span class="cv-num cv-num--p"><%= anoPicker %></span>
      <a class="cv-redondo cv-redondo--leve" href="/painel/agenda?data=<%= dataStr %><%= qsBarbeiro %>&anoPicker=<%= anoPicker + 1 %>" aria-label="Próximo ano"><%- include('../partials/icone', { cvIc: 'direita', cvCls: 'cv-ic--18' }) %></a>
    </div>
    <div class="cv-ag-meses">
      <% mesesPicker.forEach(function (m) { %>
        <a href="/painel/agenda?data=<%= m.iso %><%= qsBarbeiro %>" class="cv-chip" aria-pressed="<%= m.atual ? 'true' : 'false' %>"><span><%= m.nome %></span></a>
      <% }) %>
    </div>
  </div>
</section>

<% if (_podeBloquear) { %>
  <%/* Folha: bloquear horário. O barbeiro bloqueia só a própria agenda (o
       servidor ignora outro id). */%>
  <section class="cv-folha cv-ag-folha" id="agm-bloqueio" role="dialog" aria-modal="true" aria-labelledby="agm-bloq-tit">
    <div class="cv-folha-zona">
      <div class="cv-puxador" aria-hidden="true"></div>
      <div class="cv-folha-cab"><h2 id="agm-bloq-tit" tabindex="-1" data-foco>Bloquear horário</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button></div>
    </div>
    <div class="cv-folha-corpo">
      <form method="POST" action="/painel/agenda/bloqueios" id="form-bloqueio">
        <input type="hidden" name="barbeiro" value="<%= barbeiroSelecionado %>" />
        <div class="cv-campo"><label for="bloq-data">Data</label><input id="bloq-data" type="date" name="data" class="cv-entrada" value="<%= dataStr %>" required /></div>
        <% if (ehAdmin) { %>
          <div class="cv-campo"><label for="bloq-barbeiro">Barbeiro</label>
            <select id="bloq-barbeiro" name="barbeiroId" class="cv-entrada" required>
              <% barbeiros.forEach(function (b) { %><option value="<%= b.id %>" <%= barbeiroSelecionado === String(b.id) ? 'selected' : '' %>><%= b.nome %></option><% }) %>
            </select>
          </div>
        <% } else { %>
          <input type="hidden" name="barbeiroId" value="<%= usuario.id %>" />
        <% } %>
        <div class="cv-ag-duas">
          <div class="cv-campo"><label for="bloq-ini">Início</label><input id="bloq-ini" type="time" name="horaInicio" class="cv-entrada" required /></div>
          <div class="cv-campo"><label for="bloq-fim">Fim</label><input id="bloq-fim" type="time" name="horaFim" class="cv-entrada" required /></div>
        </div>
        <div class="cv-campo"><label for="bloq-motivo">Motivo, opcional</label><input id="bloq-motivo" name="motivo" class="cv-entrada" maxlength="80" placeholder="Almoço, folga…" autocomplete="off" /></div>
        <button type="submit" class="cv-btn cv-btn--largo" style="margin-top:20px"><%- include('../partials/icone', { cvIc: 'bloqueio', cvCls: 'cv-ic--20' }) %>Bloquear</button>
      </form>
    </div>
  </section>
<% } %>

<%/* Folha: novo agendamento (mockup 04b). Serviço com seleção múltipla,
     barbeiro (admin), data, horários do servidor (/painel/agenda/horarios; o
     ocupado sai listrado e riscado), hora exata para encaixe, plano do cliente
     quando o telefone tem plano ativo. Envia em JSON (Desfazer + M1); sem JS,
     o formulário posta como sempre. */%>
<section class="cv-folha cv-ag-folha" id="agm-novo" role="dialog" aria-modal="true" aria-labelledby="agm-novo-tit">
  <div class="cv-folha-zona">
    <div class="cv-puxador" aria-hidden="true"></div>
    <div class="cv-folha-cab"><h2 id="agm-novo-tit" tabindex="-1" data-foco>Novo agendamento</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button></div>
  </div>
  <div class="cv-folha-corpo">
    <form method="POST" action="/painel/agenda/novo" id="form-novo-agendamento" novalidate>
      <div class="cv-campo cv-ag-auto">
        <label for="cliente_nome-novo">Cliente</label>
        <input class="cv-entrada" id="cliente_nome-novo" name="cliente_nome" autocomplete="off" spellcheck="false" placeholder="Nome do cliente…" required />
        <input type="hidden" name="clienteId" id="clienteId-novo" value="" />
        <div id="sugestoes-cliente-novo" class="cv-ag-sugestoes" role="listbox" aria-label="Clientes cadastrados" hidden></div>
      </div>
      <div class="cv-campo">
        <label for="cliente_telefone-novo">WhatsApp</label>
        <input class="cv-entrada" id="cliente_telefone-novo" name="cliente_telefone" type="tel" inputmode="tel" autocomplete="off" placeholder="(51) 99999-9999" required />
      </div>

      <div class="cv-campo">
        <span class="cv-rotulo" id="rot-servicos">Serviço, pode escolher mais de um</span>
        <input type="hidden" name="servicoIds" id="servicoIds-novo" />
        <div class="cv-chips cv-ag-chips" id="pills-servico" role="group" aria-labelledby="rot-servicos">
          <% servicos.filter(function (s) { return !s.ehProduto; }).forEach(function (s) { %>
            <button type="button" class="cv-chip" aria-pressed="false" data-id="<%= s.id %>" data-nome="<%= s.nome %>"><span><%= s.nome %>, R$ <%= ((s.valor || 0) / 100).toFixed(2).replace('.', ',').replace(',00', '') %></span></button>
          <% }) %>
        </div>
      </div>

      <%/* Plano: aparece só quando o telefone tem plano ativo. */%>
      <div class="cv-campo cv-ag-plano" id="plano-novo-area" hidden>
        <input type="hidden" name="clientePlanoId" id="clientePlanoId-novo" value="" />
        <label class="cv-ag-check"><input type="checkbox" id="plano-novo-check" /><span id="plano-novo-label">Marcar pelo plano</span></label>
      </div>

      <% if (ehAdmin) { %>
        <div class="cv-campo">
          <span class="cv-rotulo" id="rot-barbeiro">Barbeiro</span>
          <input type="hidden" name="barbeiroId" id="barbeiroId-novo" value="<%= barbeiroSelecionado !== 'todos' ? barbeiroSelecionado : '' %>" />
          <div class="cv-chips cv-ag-chips" id="pills-barbeiro" role="group" aria-labelledby="rot-barbeiro">
            <% barbeiros.forEach(function (b) { %>
              <button type="button" class="cv-chip" aria-pressed="<%= barbeiroSelecionado === String(b.id) ? 'true' : 'false' %>" data-id="<%= b.id %>" data-nome="<%= b.nome.split(' ')[0] %>" title="<%= b.nome %>"><span><%= b.nome.split(' ')[0] %></span></button>
            <% }) %>
          </div>
        </div>
      <% } else { %>
        <input type="hidden" name="barbeiroId" id="barbeiroId-novo" value="<%= usuario.id %>" data-nome="<%= usuario.nome.split(' ')[0] %>" />
      <% } %>

      <div class="cv-campo">
        <label for="data-novo">Dia</label>
        <input class="cv-entrada" type="date" id="data-novo" name="data" value="<%= dataStr %>" min="<%= hojeIso %>" required />
      </div>

      <div class="cv-campo">
        <span class="cv-rotulo" id="rot-horas">Horário</span>
        <input type="hidden" name="hora" id="hora-novo" />
        <div class="cv-horas" id="pills-horario" role="group" aria-labelledby="rot-horas" aria-live="polite">
          <p class="cv-ajuda" style="grid-column:1/-1"><%= ehAdmin ? 'Escolha o barbeiro para ver os horários.' : 'Carregando horários…' %></p>
        </div>
        <label class="cv-ag-hora-exata"><span>ou um horário exato</span><input type="time" id="hora-livre" class="cv-entrada" aria-label="Horário exato" /></label>
      </div>

      <p class="cv-ag-resumo-novo" id="resumo-novo" aria-live="polite">Escolha o serviço e o horário.</p>
      <p class="cv-erro" id="erro-novo" role="alert" hidden></p>
      <button class="cv-btn cv-btn--largo" type="submit" id="confirmar-novo">Confirmar agendamento</button>
    </form>
  </div>
</section>

<%/* Folha de detalhe: uma por atendimento do dia. O miolo vem do parcial e se
     redesenha no lugar depois de cada ação (cv-agenda.js). */%>
<% agendamentos.forEach(function (ag) { %>
  <section class="cv-folha cv-ag-folha" id="agm-<%= ag.id %>" role="dialog" aria-modal="true" aria-labelledby="agm-tit-<%= ag.id %>">
    <div class="cv-folha-zona">
      <div class="cv-puxador" aria-hidden="true"></div>
      <div class="cv-ag-zona-fim"><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button></div>
    </div>
    <div class="cv-folha-corpo" data-detalhe="<%= ag.id %>">
      <%- include('_agenda-detalhe', {
            ag: ag, selo: _selo(ag), dataStr: dataStr,
            barbeiroSelecionado: barbeiroSelecionado, diaNum: diaNum, mesCurto: mesCurto,
            formasPagamento: formasPagamento, servicos: servicos, maxParcelas: maxParcelas
          }) %>
    </div>
  </section>
<% }) %>

<%/* Dados para o script: clientes do autocomplete e o barbeiro filtrado. */%>
<script type="application/json" id="cv-ag-dados"><%- jsonSeguro({ clientes: clientes, barbeiro: String(barbeiroSelecionado || ''), ehAdmin: !!ehAdmin }) %></script>
