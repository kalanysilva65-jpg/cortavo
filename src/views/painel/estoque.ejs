<%/* Estoque (redesign v3). Sem mockup próprio: o sistema aplicado com rigor.
     O objeto preto é o resumo (o que foi gasto em compras, unidades e itens);
     o "para repor" é o estado listrado (parado = estado, assinatura §2); a
     lista em cartão mostra a quantidade em número grande à direita. Novo,
     editar e categorias em folha. Mesmas rotas e campos. */%>
<%
  var fechar = include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' });
  var dinheiro = function (c, tam) { return include('../partials/dinheiro', { cvC: c, cvTam: tam || 'p' }); };
  var nomesBaixo = baixoEstoque.slice(0, 3).map(function (i) { return i.nome; }).join(', ');
  var restoBaixo = baixoEstoque.length - Math.min(3, baixoEstoque.length);
%>
<header class="cv-cab">
  <div class="cv-cab-txt"><p class="cv-cab-sup">Cadastros</p><h1>Estoque</h1></div>
  <div class="cv-cab-acoes"><button class="cv-btn" type="button" data-abrir-folha="es-folha-novo"><%- include('../partials/icone', { cvIc: 'mais', cvCls: 'cv-ic--18' }) %>Novo</button></div>
</header>

<div class="cv-secao" style="margin-top:16px">
  <section class="cv-objeto cv-gravada" aria-label="Resumo do estoque">
    <span class="rot" style="color:var(--c-sobre-objeto-2);font-size:14px;font-weight:600">Gasto em compras</span>
    <div style="margin-top:6px"><%- dinheiro(resumo.valorGasto, 'g') %></div>
    <p style="margin:8px 0 0;font-size:14px;color:var(--c-sobre-objeto-2)"><%= resumo.unidades %> <%= resumo.unidades === 1 ? 'unidade' : 'unidades' %> em <%= resumo.itens %> <%= resumo.itens === 1 ? 'item' : 'itens' %></p>
  </section>
</div>

<% if (baixoEstoque.length > 0) { %>
  <div class="cv-secao" style="margin-top:12px">
    <div class="cv-cartao cv-es-repor" role="status">
      <span class="cv-ic-redondo" aria-hidden="true"><%- include('../partials/icone', { cvIc: 'estoque', cvCls: 'cv-ic--20' }) %></span>
      <span class="corpo"><b><%= baixoEstoque.length %> para repor</b><small><%= nomesBaixo %><% if (restoBaixo > 0) { %> e mais <%= restoBaixo %><% } %></small></span>
    </div>
  </div>
<% } %>

<section class="cv-secao" style="margin-top:14px" aria-label="Itens">
  <% if (itens.length === 0) { %>
    <div class="cv-cartao cv-vazio" role="status"><h2>Nenhum item ainda</h2><p>Cadastre o que a barbearia usa (lâminas, toalhas, pomadas) e avise quando estiver acabando.</p></div>
  <% } else { %>
    <ul class="cv-lista cv-lista--sem-ic">
      <% itens.forEach(function (i) { var baixo = i.quantidade <= i.quantidadeMinima; %>
        <li><button type="button" class="cv-linha" data-abrir-folha="es-folha-<%= i.id %>">
          <span class="corpo"><span class="t"><%= i.nome %><% if (baixo) { %> <span class="cv-etq cv-etq--listra">repor</span><% } %></span><span class="s"><%= i.categoria ? i.categoria.nome : 'Sem categoria' %> · avisa em <%= i.quantidadeMinima %> un</span></span>
          <span class="fim"><b class="cv-es-qtd"><%= i.quantidade %></b><small>un</small></span>
        </button></li>
      <% }) %>
    </ul>
  <% } %>
  <button class="cv-btn cv-btn--texto cv-btn--largo" type="button" data-abrir-folha="es-folha-categorias" style="margin-top:6px">Categorias</button>
</section>

<% function campos(i) { var id = i ? i.id : 'novo'; %>
  <div class="cv-campo"><label for="nome-<%= id %>">Nome</label><input class="cv-entrada" id="nome-<%= id %>" name="nome" value="<%= i ? i.nome : '' %>" placeholder="Ex.: Lâmina descartável" required /></div>
  <div class="cv-campo"><label for="categoriaId-<%= id %>">Categoria</label><select class="cv-entrada" id="categoriaId-<%= id %>" name="categoriaId"><option value="">Sem categoria</option><% categorias.forEach(function (c) { %><option value="<%= c.id %>"<%= i && i.categoriaId === c.id ? ' selected' : '' %>><%= c.nome %></option><% }) %></select></div>
  <div class="cv-dupla" style="margin-top:14px">
    <div class="cv-campo"><label for="quantidade-<%= id %>">Quantidade</label><input class="cv-entrada cv-entrada--num" id="quantidade-<%= id %>" name="quantidade" type="number" min="0" inputmode="numeric" value="<%= i ? i.quantidade : 0 %>" /></div>
    <div class="cv-campo"><label for="quantidadeMinima-<%= id %>">Avisar em</label><input class="cv-entrada cv-entrada--num" id="quantidadeMinima-<%= id %>" name="quantidadeMinima" type="number" min="0" inputmode="numeric" value="<%= i ? i.quantidadeMinima : 0 %>" /></div>
  </div>
  <div class="cv-campo"><label for="valorGasto-<%= id %>">Valor gasto na compra, em reais</label><input class="cv-entrada cv-entrada--num" id="valorGasto-<%= id %>" name="valorGasto" type="number" step="0.01" min="0" inputmode="decimal" value="<%= i ? (i.valorGasto / 100).toFixed(2) : '' %>" placeholder="0,00" /></div>
<% } %>

<section class="cv-folha" id="es-folha-novo" data-folha role="dialog" aria-modal="true" aria-labelledby="es-novo-t">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="es-novo-t" tabindex="-1" data-foco>Novo item</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- fechar %></button></div></div>
  <div class="cv-folha-corpo"><form method="POST" action="/painel/estoque"><% campos(null) %><button class="cv-btn cv-btn--largo" type="submit">Adicionar</button></form></div>
</section>

<% itens.forEach(function (i) { %>
<section class="cv-folha" id="es-folha-<%= i.id %>" data-folha role="dialog" aria-modal="true" aria-labelledby="es-t-<%= i.id %>">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="es-t-<%= i.id %>" tabindex="-1" data-foco><%= i.nome %></h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- fechar %></button></div></div>
  <div class="cv-folha-corpo">
    <form method="POST" action="/painel/estoque/<%= i.id %>"><% campos(i) %><button class="cv-btn cv-btn--largo" type="submit">Salvar alterações</button></form>
    <form method="POST" action="/painel/estoque/<%= i.id %>/remover" class="cv-folha-acoes" data-confirmar="Excluir este item?"><button type="submit" class="cv-perigo-link">Excluir item</button></form>
  </div>
</section>
<% }) %>

<section class="cv-folha" id="es-folha-categorias" data-folha role="dialog" aria-modal="true" aria-labelledby="es-cats-t">
  <div class="cv-folha-zona"><div class="cv-puxador" aria-hidden="true"></div><div class="cv-folha-cab"><h2 id="es-cats-t" tabindex="-1" data-foco>Categorias</h2><button type="button" class="cv-redondo cv-redondo--leve" data-fechar aria-label="Fechar"><%- fechar %></button></div></div>
  <div class="cv-folha-corpo">
    <p class="cv-folha-sub">Remover uma categoria não apaga os itens: eles ficam sem categoria.</p>
    <form method="POST" action="/painel/estoque/categorias" class="cv-linha-form"><label class="cv-oculto" for="es-cat-nova">Nova categoria</label><input class="cv-entrada" id="es-cat-nova" name="nome" placeholder="Nova categoria" required /><button class="cv-btn cv-btn--2 cv-btn--p" type="submit">Adicionar</button></form>
    <% if (categorias.length) { %>
      <ul class="cv-linhas" style="margin-top:12px">
        <% categorias.forEach(function (c) { %>
          <li>
            <form method="POST" action="/painel/estoque/categorias/<%= c.id %>" class="cv-linha-form" style="flex:1"><input class="cv-entrada" name="nome" value="<%= c.nome %>" aria-label="Nome da categoria" /><button class="cv-btn cv-btn--2 cv-btn--p" type="submit">Salvar</button></form>
            <form method="POST" action="/painel/estoque/categorias/<%= c.id %>/remover" data-confirmar="Remover esta categoria?"><button class="cv-redondo cv-redondo--leve" type="submit" aria-label="Remover a categoria <%= c.nome %>"><%- fechar %></button></form>
          </li>
        <% }) %>
      </ul>
    <% } else { %><p class="cv-texto-apoio" style="margin-top:10px">Nenhuma categoria.</p><% } %>
  </div>
</section>

<script>
  function abrirFolha(id) { var ir = function () { if (window.cvAbrirFolha) cvAbrirFolha('es-folha-' + id); }; if (window.cvAbrirFolha) ir(); else document.addEventListener('DOMContentLoaded', ir); }
</script>
