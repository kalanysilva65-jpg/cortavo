<%/* Conversas (redesign v3). Sem mockup próprio: o sistema aplicado com
     rigor e sem as cores do WhatsApp (balões em branco e preto, tiques em
     cinza e preto). Lista com busca e atualização a cada 8 s; conversa aberta
     com o cabeçalho em vidro, os balões (public/js/chat-whatsapp.js, mesmos
     ids) e o compositor. Mesmas rotas e campos. */%>
<%
  function inic(nome) { var p = (nome || '?').trim().split(/\s+/); return ((p[0] || '?')[0] + (p[1] ? p[1][0] : '')).toUpperCase(); }
%>
<% if (!aberta) { %>
  <header class="cv-cab">
    <div class="cv-cab-txt"><p class="cv-cab-sup">WhatsApp da barbearia</p><h1>Conversas</h1></div>
  </header>

  <% if (!iaAtiva) { %>
    <div class="cv-secao" style="margin-top:14px"><div class="cv-cartao cv-cv-aviso" role="status"><%- include('../partials/icone', { cvIc: 'assistente' }) %><p>Respostas automáticas <b>desligadas</b> (falta a chave da IA). Você ainda pode responder na mão.</p></div></div>
  <% } else if (tetoAtingido) { %>
    <div class="cv-secao" style="margin-top:14px"><div class="cv-cartao cv-cv-aviso cv-cv-aviso--teto" role="status"><span class="faixa" aria-hidden="true"></span><p><b>Teto de IA do mês atingido.</b> As respostas automáticas pausaram para conter custo. Responda na mão; volta no próximo mês.</p></div></div>
  <% } %>

  <% if (conversas.length > 0) { %>
    <label class="cv-busca"><span class="cv-oculto">Buscar conversa</span><%- include('../partials/icone', { cvIc: 'busca' }) %><input class="cv-entrada" id="cv-busca" type="search" data-busca="cv" placeholder="Buscar conversa" autocomplete="off" /></label>
  <% } %>
  <section class="cv-secao" style="margin-top:14px" aria-label="Conversas">
    <div id="cv-lista" data-lista="cv"><%- include('_conversas-lista', { conversas: conversas }) %></div>
    <p class="cv-texto-apoio" data-sem-resultado="cv" hidden style="padding:16px 4px">Nenhuma conversa encontrada.</p>
  </section>

  <% if (ehAdmin) { %>
    <section class="cv-secao" aria-labelledby="cv-sim-t">
      <details class="cv-cartao cv-cv-simular">
        <summary id="cv-sim-t">Simular mensagem de cliente (teste)</summary>
        <form method="POST" action="/painel/conversas/simular">
          <div class="cv-campo"><label for="sim-tel">Telefone</label><input class="cv-entrada" id="sim-tel" name="telefone" type="tel" placeholder="11999998888" required /></div>
          <div class="cv-campo"><label for="sim-nome">Nome do cliente <span style="font-weight:400;color:var(--c-apoio)">(opcional)</span></label><input class="cv-entrada" id="sim-nome" name="nome" /></div>
          <div class="cv-campo"><label for="sim-txt">Mensagem do cliente</label><input class="cv-entrada" id="sim-txt" name="texto" required /></div>
          <button class="cv-btn cv-btn--2 cv-btn--largo" type="submit" style="margin-top:14px">Enviar como cliente</button>
          <span class="cv-ajuda">Só para testar a caixa de entrada antes de ligar o WhatsApp. A IA responde se estiver configurada.</span>
        </form>
      </details>
    </section>
  <% } %>

  <script>
    // Atualização da lista a cada 8 s: troca só o miolo e reaplica a busca.
    (function () {
      var lista = document.getElementById('cv-lista'), busca = document.getElementById('cv-busca');
      var ultimo = lista ? lista.innerHTML : '';
      setInterval(async function () {
        if (!lista || document.hidden) return;
        try {
          var r = await fetch('/painel/conversas/fragmento', { headers: { 'X-Requested-With': 'fetch' } });
          if (!r.ok || r.redirected) return; // sessão expirou: não injeta o login
          var html = await r.text();
          if (html.trim() && html !== ultimo) { lista.innerHTML = html; ultimo = html; if (busca) busca.dispatchEvent(new Event('input')); }
        } catch (e) {}
      }, 8000);
    })();
  </script>

<% } else { %>
  <div class="cv-cv-chat">
    <header class="cv-cv-topo">
      <a href="/painel/conversas" class="cv-redondo cv-redondo--leve" aria-label="Voltar para as conversas"><%- include('../partials/icone', { cvIc: 'esquerda', cvCls: 'cv-ic--20' }) %></a>
      <span class="cv-avatar cv-avatar--claro" aria-hidden="true"><%= inic(aberta.conversa.nome) %></span>
      <span class="id"><b><%= aberta.conversa.nome %></b><small><%= aberta.conversa.telefone %></small></span>
      <form method="POST" action="/painel/conversas/<%= aberta.conversa.id %>/ia">
        <input type="hidden" name="ativa" value="<%= aberta.conversa.iaAtiva ? '0' : '1' %>" />
        <button type="submit" class="cv-btn cv-btn--p<%= aberta.conversa.iaAtiva ? ' cv-btn--2' : '' %>"><%= aberta.conversa.iaAtiva ? 'Assumir' : 'Devolver à IA' %></button>
      </form>
    </header>
    <div class="cv-cv-status" role="status">
      <span><%= aberta.conversa.iaAtiva ? 'A IA está respondendo esta conversa.' : 'Você assumiu: a IA está pausada nesta conversa.' %></span>
      <form method="POST" action="/painel/conversas/<%= aberta.conversa.id %>/excluir" data-confirmar="Excluir esta conversa e todas as mensagens? Isso apaga os dados do cliente e não dá para desfazer."><button type="submit" class="cv-perigo-link" style="min-height:36px;font-size:13px">Excluir</button></form>
    </div>

    <div class="cv-cv-thread" id="cv-thread" data-id="<%= aberta.conversa.id %>" aria-live="polite"></div>
    <script type="application/json" id="cv-dados"><%- JSON.stringify(aberta.mensagens).split('<').join(String.fromCharCode(92) + 'u003c') %></script>

    <%/* Fora da janela de 24 h da Meta, texto e mídia livres não são entregues. */%>
    <div class="cv-cv-janela" id="cv-janela"<% if (aberta.conversa.janelaAberta) { %> hidden<% } %>><span class="faixa" aria-hidden="true"></span><p>Passaram 24 h desde a última mensagem do cliente. Pelas regras do WhatsApp, só dá para retomar com uma <b>mensagem modelo</b> ou esperar ele escrever.</p></div>

    <form class="cv-cv-compor" id="cv-form" method="POST" action="/painel/conversas/<%= aberta.conversa.id %>/responder" autocomplete="off">
      <label class="cv-redondo cv-redondo--leve" title="Enviar foto, vídeo ou arquivo"><%- include('../partials/icone', { cvIc: 'imagem', cvCls: 'cv-ic--20' }) %><span class="cv-oculto">Anexar</span><input type="file" id="cv-arquivo" class="cv-oculto" accept="image/*,video/*,audio/*,application/pdf,.doc,.docx,.xls,.xlsx,.txt" /></label>
      <input class="cv-entrada" id="cv-texto" name="texto" placeholder="Mensagem" maxlength="2000" aria-label="Sua resposta" />
      <button type="button" class="cv-cv-enviar" id="cv-mic" aria-label="Gravar áudio"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2.5" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3.5"/></svg></button>
      <button type="submit" class="cv-cv-enviar" id="cv-enviar" aria-label="Enviar" hidden><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg></button>
    </form>

    <div class="cv-cv-gravando" id="cv-gravando" hidden>
      <button type="button" class="cv-redondo cv-redondo--leve" id="cv-grav-cancel" aria-label="Cancelar gravação"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button>
      <span class="ponto" aria-hidden="true"></span><span id="cv-grav-tempo" class="cv-num">0:00</span>
      <button type="button" class="cv-cv-enviar" id="cv-grav-ok" aria-label="Enviar áudio"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg></button>
    </div>

    <div class="cv-cv-previa" id="cv-previa" hidden role="dialog" aria-modal="true" aria-labelledby="cv-prev-nome">
      <div class="topo"><button type="button" class="cv-redondo" id="cv-prev-fechar" aria-label="Cancelar"><%- include('../partials/icone', { cvIc: 'fechar', cvCls: 'cv-ic--18' }) %></button><span id="cv-prev-nome"></span></div>
      <div class="corpo" id="cv-prev-corpo"></div>
      <div class="pe"><input class="cv-entrada" id="cv-prev-legenda" placeholder="Adicionar legenda" maxlength="1000" aria-label="Legenda" /><button type="button" class="cv-cv-enviar" id="cv-prev-enviar" aria-label="Enviar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg></button></div>
    </div>
  </div>
  <script src="/js/chat-whatsapp.js" defer></script>
<% } %>
