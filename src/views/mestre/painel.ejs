<div class="cabecalho-pagina agenda-cabecalho">
  <div>
    <h1>Barbearias</h1>
    <p class="texto-secundario">Todas as barbearias assinantes. Clique no nome para gerenciar ou em “Entrar” para operar.</p>
  </div>
  <div class="flex gap-8">
    <a href="/mestre/uso" class="btn btn-secundario btn-sm">Uso &amp; custos</a>
    <a href="/mestre/canais" class="btn btn-secundario btn-sm">Canais &amp; mensagens</a>
    <a href="/mestre/auditoria" class="btn btn-secundario btn-sm">Auditoria</a>
    <a href="/mestre/nova" class="btn btn-primario btn-sm">+ Nova barbearia</a>
  </div>
</div>

<%/* Backup semanal (scripts/backup-semanal.js). Vermelho se falhou/atrasou. */%>
<% var bk = backup, fmtBk = function (d) { return new Date(d).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }); }; %>
<div class="card" style="border-left:4px solid <%= bk.situacao === 'ok' ? '#2e9e5b' : '#d93025' %>">
  <strong>Backup (diário):</strong>
  <% if (bk.situacao === 'ok') { %>
    ✅ último em <%= fmtBk(bk.ultimoOk.quando) %> — <%= (bk.ultimoOk.bytes / 1048576).toFixed(1) %> MB, conferido no Supabase.
  <% } else if (bk.situacao === 'nunca') { %>
    ⚠️ nenhum backup registrado ainda.
  <% } else if (bk.situacao === 'falhou') { %>
    ❌ o último (<%= fmtBk(bk.ultimo.quando) %>) FALHOU: <%= bk.ultimo.erro %>
  <% } else { %>
    ⚠️ atrasado — o último que deu certo foi em <%= fmtBk(bk.ultimoOk.quando) %>. Confira o cron no VPS.
  <% } %>
  <% if (bk.teste) { %><span class="texto-secundario"> · teste de restauração OK em <%= fmtBk(bk.teste.quando) %></span><% } %>
</div>

<!-- Busca + filtro de status (paginação server-side) -->
<div class="card">
  <form method="GET" action="/mestre" class="flex gap-8" style="flex-wrap:wrap;align-items:flex-end">
    <div class="campo" style="flex:1;min-width:200px;margin:0">
      <label for="q">Buscar</label>
      <input id="q" name="q" value="<%= filtros.q %>" placeholder="nome ou subdomínio" />
    </div>
    <div class="campo" style="margin:0">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="todas" <%= filtros.status === 'todas' ? 'selected' : '' %>>Todas</option>
        <option value="ativa" <%= filtros.status === 'ativa' ? 'selected' : '' %>>Ativas</option>
        <option value="inativa" <%= filtros.status === 'inativa' ? 'selected' : '' %>>Inativas</option>
      </select>
    </div>
    <button class="btn btn-primario btn-sm" type="submit">Filtrar</button>
    <% if (filtros.q || filtros.status !== 'todas') { %>
      <a href="/mestre" class="btn btn-secundario btn-sm">Limpar</a>
    <% } %>
  </form>

  <h2 class="mt-16">Assinantes (<%= total %>)</h2>
  <% if (barbearias.length === 0) { %>
    <p class="texto-secundario mt-16">Nenhuma barbearia encontrada com esse filtro.</p>
  <% } else { %>
    <div class="tabela-rolagem">
      <table class="tabela mt-16">
        <thead>
          <tr>
            <th>Barbearia</th>
            <th>Subdomínio</th>
            <th>Plano</th>
            <th class="col-valor">Equipe</th>
            <th class="col-valor">Clientes</th>
            <th class="col-valor">Agend.</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% barbearias.forEach(function (barb) { %>
            <tr>
              <td><a href="/mestre/barbearias/<%= barb.id %>" class="link-cliente"><%= barb.nome %></a></td>
              <td><span class="texto-sutil"><%= barb.slug %></span></td>
              <% var pl = planoDe(barb.planoCortavo); var av = avisoBarbeiros(pl, barb._count.usuarios, barb.nome); %>
              <td>
                <span class="selo-plano<%= av ? ' selo-plano--aviso' : '' %>"><%= pl.nome %></span>
                <% if (av) { %><div class="texto-sutil" style="margin-top:4px"><%= av %></div><% } %>
              </td>
              <td class="col-valor"><%= barb._count.usuarios %></td>
              <td class="col-valor"><%= barb._count.clientes %></td>
              <td class="col-valor"><%= barb._count.agendamentos %></td>
              <td>
                <% if (barb.ativo) { %>
                  <span class="badge-papel">Ativa</span>
                <% } else { %>
                  <span class="texto-sutil">Inativa</span>
                <% } %>
              </td>
              <td class="col-acao">
                <form method="POST" action="/mestre/entrar/<%= barb.id %>" class="inline">
                  <button class="btn btn-primario btn-sm" type="submit">Entrar →</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (paginacao.totalPaginas > 1) { %>
      <%
        var base = '/mestre?q=' + encodeURIComponent(filtros.q) + '&status=' + filtros.status + '&pagina=';
      %>
      <div class="flex gap-8 mt-16" style="align-items:center;justify-content:center">
        <% if (paginacao.pagina > 1) { %>
          <a href="<%= base + (paginacao.pagina - 1) %>" class="btn btn-secundario btn-sm">← Anterior</a>
        <% } %>
        <span class="texto-sutil">Página <%= paginacao.pagina %> de <%= paginacao.totalPaginas %></span>
        <% if (paginacao.pagina < paginacao.totalPaginas) { %>
          <a href="<%= base + (paginacao.pagina + 1) %>" class="btn btn-secundario btn-sm">Próxima →</a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>
