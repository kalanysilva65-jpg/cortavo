<%/* Uso & custos de IA por barbearia (painel-mestre). Tabela + atualização em
     tempo real (polling em /mestre/uso.json). Estilos no cv-mestre.css. */%>
<div class="m-topo">
  <div>
    <h1>Uso &amp; custos</h1>
    <p class="cv-texto-apoio">Consumo de IA por barbearia — <strong id="uso-mes"><%= competencia %></strong>. Atualiza sozinho. <span class="cv-texto-apoio">(estimativa; a fatura oficial fica na Anthropic/Meta)</span></p>
  </div>
  <div class="m-flex">
    <form method="GET" action="/mestre/uso" class="m-flex" style="align-items:flex-end;margin:0">
      <div class="cv-campo" style="margin:0">
        <label for="competencia">Mês</label>
        <input id="competencia" type="month" name="competencia" value="<%= competencia %>" />
      </div>
      <button class="cv-btn cv-btn--2 cv-btn--p" type="submit">Ver</button>
    </form>
    <a href="/mestre" class="cv-btn cv-btn--2 cv-btn--p">Voltar</a>
  </div>
</div>

<div class="cv-cartao m-bloco">
  <p class="cv-texto-apoio" style="margin-top:0">
    Modelos: WhatsApp <strong><%= modelos.whatsapp %></strong> · Copiloto <strong><%= modelos.copiloto %></strong>.
    Custo <strong>real</strong> da IA (cache já contado a 10%), convertido a <strong>R$ <%= cotacao.toFixed(2) %></strong>/US$.
    É só a parte da <strong>IA</strong> — a conversa do WhatsApp (Meta) é grátis quando o cliente inicia.
    <br>Margem estimada assumindo plano de <strong>R$ <%= precoPlanoRef.toFixed(2) %></strong>/mês por barbearia ativa (ajuste em <code>PLANO_PRECO_REF</code>).
    <br><strong>Tokens</strong> (formato <em>entrada / saída</em>): separados por canal — WhatsApp (secretária) e Copiloto (assistente do painel). Já ponderados pelo cache (é o valor que gera o custo). A coluna <strong>Entrada crua</strong> mostra os tokens de entrada REAIS, sem a ponderação do cache (a saída já é crua) — medida só a partir de 20/09/2026 (meses anteriores aparecem como —).
    <br><strong>WhatsApp (Meta)</strong>: mensagens enviadas no mês pela IA + equipe. Desde 01/10/2026 a Meta cobra a partir da <%= (typeof wppGratisMes !== 'undefined' ? wppGratisMes : 1000).toLocaleString('pt-BR') %>ª por número (~<%= (typeof wppPrecoMsgBRL !== 'undefined' ? wppPrecoMsgBRL : 0.035).toLocaleString('pt-BR', { style:'currency', currency:'BRL', minimumFractionDigits: 3 }) %> cada) e cada lembrete (template) desde o 1º — tudo no cartão da Cortavo, então esse custo já entra em <em>Custo</em> e <em>Margem</em>. Linha em <span style="color:#b45309;font-weight:700">laranja</span> = passou de 80% da franquia grátis.
    <br><span class="cv-texto-apoio">Obs.: o custo é <strong>estimado com o modelo ATUAL</strong> (WhatsApp <%= modelos.whatsapp %>). Se você trocou de modelo no meio do mês (ex.: Haiku → Sonnet), os tokens antigos são reprecificados pelo novo modelo e a estimativa pode ficar <strong>acima</strong> do valor real da Anthropic — que é a fatura oficial. No mês seguinte (modelo estável) os números se aproximam.</span>
  </p>

  <div class="m-rolagem">
    <table class="m-tab">
      <thead>
        <tr>
          <th>Barbearia</th>
          <th style="text-align:right">Conversas</th>
          <th style="text-align:right">Respostas IA</th>
          <th style="text-align:right">Copiloto</th>
          <th style="text-align:right">WhatsApp tok. (ent/saí)</th>
          <th style="text-align:right">Copiloto tok. (ent/saí)</th>
          <th style="text-align:right">Entrada crua</th>
          <th style="text-align:right">WhatsApp msgs (pagas) · lembr.</th>
          <th style="text-align:right">Custo IA + Meta (R$)</th>
          <th style="text-align:right">R$/conversa</th>
          <th style="text-align:right">Margem (R$)</th>
        </tr>
      </thead>
      <tbody id="uso-corpo">
        <% function brl(v){ return (v||0).toLocaleString('pt-BR', { style:'currency', currency:'BRL' }); } %>
        <% function num(v){ return (v||0).toLocaleString('pt-BR'); } %>
        <% function tok(e, s){ return num(e) + ' / ' + num(s); } %>
        <% function wpp(l){ return num(l.msgsEnviadas) + ' (' + num(l.msgsPagas) + ') · ' + num(l.lembretesMes) + (l.custoMetaBRL ? ' = ' + brl(l.custoMetaBRL) : ''); } %>
        <% function cru(l){ var v = l.tokensEntradaCru || 0; if (v === 0 && (l.tokensEntrada || 0) > 0) return '—'; return num(v); } %>
        <% linhas.forEach(function (l) { %>
          <tr<%- l.alertaMsgs ? ' style="background:#fff7ed"' : '' %>>
            <td><%= l.nome %><%- l.alertaMsgs ? ' <span style="color:#b45309;font-weight:700" title="Perto/acima das mensagens grátis do mês">⚠</span>' : '' %></td>
            <td style="text-align:right"><%= num(l.conversas) %></td>
            <td style="text-align:right"><%= num(l.respostas) %></td>
            <td style="text-align:right"><%= num(l.copilotoConsultas) %></td>
            <td style="text-align:right"><%= tok(l.wppTokensEntrada, l.wppTokensSaida) %></td>
            <td style="text-align:right"><%= tok(l.copTokensEntrada, l.copTokensSaida) %></td>
            <td style="text-align:right"><%= cru(l) %></td>
            <td style="text-align:right"><%= wpp(l) %></td>
            <td style="text-align:right"><%= brl(l.custoBRL) %></td>
            <td style="text-align:right"><%= brl(l.custoPorConversaBRL) %></td>
            <td style="text-align:right"><%= l.ativa ? brl(l.margemBRL) + (l.margemPct != null ? ' (' + l.margemPct + '%)' : '') : '—' %></td>
          </tr>
        <% }) %>
        <% if (linhas.length === 0) { %>
          <tr><td colspan="11" class="cv-texto-apoio">Nenhum uso registrado neste mês.</td></tr>
        <% } %>
      </tbody>
      <tfoot>
        <tr style="font-weight:700">
          <td>Total<%= totais.ativas ? ' (' + totais.ativas + ' ativas)' : '' %></td>
          <td style="text-align:right" id="uso-tot-conversas"><%= totais.conversas.toLocaleString('pt-BR') %></td>
          <td style="text-align:right" id="uso-tot-respostas"><%= totais.respostas.toLocaleString('pt-BR') %></td>
          <td style="text-align:right" id="uso-tot-copiloto"><%= totais.copiloto.toLocaleString('pt-BR') %></td>
          <td style="text-align:right" id="uso-tot-wpptok"><%= tok(totais.wppTokensEntrada, totais.wppTokensSaida) %></td>
          <td style="text-align:right" id="uso-tot-coptok"><%= tok(totais.copTokensEntrada, totais.copTokensSaida) %></td>
          <td style="text-align:right" id="uso-tot-cru"><%= (totais.tokensEntradaCru === 0 && totais.tokensEntrada > 0) ? '—' : num(totais.tokensEntradaCru) %></td>
          <td style="text-align:right" id="uso-tot-wpp"><%= wpp(totais) %></td>
          <td style="text-align:right" id="uso-tot-custo"><%= brl(totais.custoBRL) %></td>
          <td style="text-align:right" id="uso-tot-porconversa"><%= brl(totais.custoPorConversaBRL) %></td>
          <td style="text-align:right" id="uso-tot-margem"><%= brl(totais.margemBRL) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<script>
  (function () {
    var comp = <%- JSON.stringify(competencia) %>;
    var corpo = document.getElementById('uso-corpo');
    if (!corpo) return;
    function n(v) { return (v || 0).toLocaleString('pt-BR'); }
    function brl(v) { return (v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }
    function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
    function tok(e, s) { return n(e) + ' / ' + n(s); }
    function wpp(l) { return n(l.msgsEnviadas) + ' (' + n(l.msgsPagas) + ') · ' + n(l.lembretesMes) + (l.custoMetaBRL ? ' = ' + brl(l.custoMetaBRL) : ''); }
    function cru(l) { var v = l.tokensEntradaCru || 0; if (v === 0 && (l.tokensEntrada || 0) > 0) return '—'; return n(v); }
    async function atualizar() {
      if (document.hidden) return;
      try {
        var r = await fetch('/mestre/uso.json?competencia=' + encodeURIComponent(comp), { headers: { 'X-Requested-With': 'fetch' } });
        if (!r.ok || r.redirected) return;
        var d = await r.json();
        if (!d || !d.linhas) return;
        corpo.innerHTML = d.linhas.length
          ? d.linhas.map(function (l) {
              return '<tr' + (l.alertaMsgs ? ' style="background:#fff7ed"' : '') + '><td>' + esc(l.nome) + (l.alertaMsgs ? ' <span style="color:#b45309;font-weight:700">⚠</span>' : '') + '</td>' +
                '<td style="text-align:right">' + n(l.conversas) + '</td>' +
                '<td style="text-align:right">' + n(l.respostas) + '</td>' +
                '<td style="text-align:right">' + n(l.copilotoConsultas) + '</td>' +
                '<td style="text-align:right">' + tok(l.wppTokensEntrada, l.wppTokensSaida) + '</td>' +
                '<td style="text-align:right">' + tok(l.copTokensEntrada, l.copTokensSaida) + '</td>' +
                '<td style="text-align:right">' + cru(l) + '</td>' +
                '<td style="text-align:right">' + wpp(l) + '</td>' +
                '<td style="text-align:right">' + brl(l.custoBRL) + '</td>' +
                '<td style="text-align:right">' + brl(l.custoPorConversaBRL) + '</td>' +
                '<td style="text-align:right">' + (l.ativa ? brl(l.margemBRL) + (l.margemPct != null ? ' (' + l.margemPct + '%)' : '') : '—') + '</td></tr>';
            }).join('')
          : '<tr><td colspan="11" class="cv-texto-apoio">Nenhum uso registrado neste mês.</td></tr>';
        document.getElementById('uso-tot-conversas').textContent = n(d.totais.conversas);
        document.getElementById('uso-tot-respostas').textContent = n(d.totais.respostas);
        document.getElementById('uso-tot-copiloto').textContent = n(d.totais.copiloto);
        var wt = document.getElementById('uso-tot-wpptok'); if (wt) wt.textContent = tok(d.totais.wppTokensEntrada, d.totais.wppTokensSaida);
        var ct = document.getElementById('uso-tot-coptok'); if (ct) ct.textContent = tok(d.totais.copTokensEntrada, d.totais.copTokensSaida);
        var wTot = document.getElementById('uso-tot-wpp'); if (wTot) wTot.textContent = wpp(d.totais);
        var cruTot = document.getElementById('uso-tot-cru'); if (cruTot) cruTot.textContent = (d.totais.tokensEntradaCru === 0 && d.totais.tokensEntrada > 0) ? '—' : n(d.totais.tokensEntradaCru);
        document.getElementById('uso-tot-custo').textContent = brl(d.totais.custoBRL);
        document.getElementById('uso-tot-porconversa').textContent = brl(d.totais.custoPorConversaBRL);
        var m = document.getElementById('uso-tot-margem'); if (m) m.textContent = brl(d.totais.margemBRL);
      } catch (e) {}
    }
    setInterval(atualizar, 7000);
  })();
</script>
