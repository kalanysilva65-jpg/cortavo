<div class="cabecalho-pagina agenda-cabecalho">
  <div>
    <h1><%= barbearia.nome %></h1>
    <p class="texto-secundario">Subdomínio: <strong><%= barbearia.slug %></strong> · <%= barbearia.ativo ? 'Ativa' : 'Pausada' %></p>
  </div>
  <div class="flex gap-8">
    <% if (barbearia.ativo) { %>
      <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/ativa" class="inline"
            onsubmit="return confirm(<%= JSON.stringify('Pausar o acesso da ' + barbearia.nome + '? Vai parar: login do dono e dos barbeiros, secretária, assistente, lembretes e agendamento online. Nenhum dado é apagado; Reativar volta tudo.') %>)">
        <input type="hidden" name="ativa" value="false" />
        <button class="btn btn-secundario btn-sm" type="submit">Pausar acesso</button>
      </form>
    <% } else { %>
      <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/ativa" class="inline"
            onsubmit="return confirm(<%= JSON.stringify('Reativar a ' + barbearia.nome + '? Login, secretária, assistente e lembretes futuros voltam.') %>)">
        <input type="hidden" name="ativa" value="true" />
        <button class="btn btn-secundario btn-sm" type="submit">Reativar</button>
      </form>
    <% } %>
    <form method="POST" action="/mestre/entrar/<%= barbearia.id %>" class="inline">
      <button class="btn btn-primario btn-sm" type="submit">Entrar nesta barbearia →</button>
    </form>
    <a href="/mestre" class="btn btn-secundario btn-sm">← Voltar</a>
  </div>
</div>

<!-- Dados da barbearia -->
<div class="card mb-16">
  <h2>Dados da barbearia</h2>
  <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>" class="form mt-16">
    <div class="grid-2">
      <div class="campo">
        <label for="nome">Nome</label>
        <input id="nome" name="nome" value="<%= barbearia.nome %>" required />
      </div>
      <div class="campo">
        <label for="slug">Subdomínio</label>
        <input id="slug" name="slug" value="<%= barbearia.slug %>" required />
      </div>
    </div>
    <div class="campo mt-16">
      <label for="endereco">Endereço</label>
      <input id="endereco" name="endereco" value="<%= barbearia.endereco || '' %>" placeholder="Rua, número, bairro, cidade — SP" />
      <small class="texto-sutil">Usado na busca "perto de você" do app do cliente. Ao salvar, localizamos no mapa automaticamente.
        <% if (barbearia.latitude && barbearia.longitude) { %>
          <span style="color:var(--verde,#22c55e)">✓ Localizada no mapa.</span>
        <% } else if (barbearia.endereco) { %>
          <span style="color:#e5a">Ainda não localizada — confira o endereço.</span>
        <% } %>
      </small>
    </div>
    <p class="texto-sutil" style="margin-top:8px">
      Status: <strong><%= barbearia.ativo ? 'Ativa' : 'Pausada' %></strong> — use o botão
      <%= barbearia.ativo ? '“Pausar acesso”' : '“Reativar”' %> no topo para mudar (fica registrado na auditoria).
    </p>
    <div class="mt-16">
      <button class="btn btn-primario btn-sm" type="submit">Salvar dados</button>
    </div>
  </form>
</div>

<!-- Notas internas (só o painel-mestre vê) -->
<div class="card mb-16">
  <h2>Notas internas</h2>
  <p class="texto-secundario">Anotações suas sobre esta barbearia (contato, combinados, pendências). A barbearia nunca vê isto.</p>
  <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/notas" class="form mt-16">
    <div class="campo">
      <textarea name="notasInternas" rows="4" placeholder="Ex.: dono é o Bruno, prefere contato por WhatsApp; combinou período de teste até dia 20."><%= barbearia.notasInternas || '' %></textarea>
    </div>
    <div class="mt-16">
      <button class="btn btn-primario btn-sm" type="submit">Salvar notas</button>
    </div>
  </form>
</div>

<!-- Marca -->
<div class="card mb-16">
  <h2>Marca</h2>
  <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/marca" enctype="multipart/form-data" class="form mt-16">
    <% if (marca.logoUrl) { %>
      <div class="mb-16">
        <img src="<%= marca.logoUrl %>" alt="Logo atual" style="max-height:64px;" />
      </div>
    <% } %>
    <div class="campo">
      <label for="foto">Logo (JPG, PNG ou WEBP · máx. 4 MB)</label>
      <input id="foto" type="file" name="foto" accept="image/*" />
    </div>
    <label class="flex gap-8" style="align-items:center;">
      <input type="checkbox" name="mostrar_powered_by" <%= marca.mostrarPoweredBy ? 'checked' : '' %> />
      <span>Mostrar selo “Desenvolvido por Cortavo.”</span>
    </label>
    <div class="flex gap-8 mt-16">
      <button class="btn btn-primario btn-sm" type="submit">Salvar marca</button>
      <% if (marca.logoUrl) { %>
        <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/marca/remover-logo" class="inline">
          <button class="btn btn-secundario btn-sm" type="submit">Remover logo</button>
        </form>
      <% } %>
    </div>
  </form>
</div>

<!-- Foto de capa (hero da Home do painel) -->
<div class="card mb-16">
  <h2>Foto de capa</h2>
  <p class="texto-secundario">Aparece no topo da Home do painel, atrás da saudação. Sem foto, mostra um fundo escuro padrão.</p>
  <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/capa" enctype="multipart/form-data" class="form mt-16">
    <% if (barbearia.capaUrl) { %>
      <div class="mb-16">
        <img src="<%= barbearia.capaUrl %>" alt="Capa atual" style="width:100%;max-height:140px;object-fit:cover;border-radius:12px;" />
      </div>
    <% } %>
    <div class="campo">
      <label for="capa">Imagem (JPG, PNG ou WEBP · máx. 4 MB)</label>
      <input id="capa" type="file" name="foto" accept="image/*" />
    </div>
    <div class="flex gap-8 mt-16">
      <button class="btn btn-primario btn-sm" type="submit">Salvar capa</button>
      <% if (barbearia.capaUrl) { %>
        <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/capa/remover" class="inline">
          <button class="btn btn-secundario btn-sm" type="submit">Remover capa</button>
        </form>
      <% } %>
    </div>
  </form>
</div>

<!-- Equipe -->
<div class="card mb-16">
  <h2>Equipe (<%= equipe.length %>)</h2>
  <% if (equipe.length === 0) { %>
    <p class="texto-secundario mt-16">Nenhum barbeiro cadastrado ainda.</p>
  <% } else { %>
    <div class="tabela-rolagem">
      <table class="tabela mt-16">
        <thead><tr><th>Nome</th><th>E-mail</th><th>Papel</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% equipe.forEach(function (m) { %>
            <tr>
              <td><%= m.nome %></td>
              <td><span class="texto-sutil"><%= m.email %></span></td>
              <td><%= m.papel === 'admin' ? 'Admin' : 'Barbeiro' %></td>
              <td><%= m.ativo ? 'Ativo' : 'Inativo' %></td>
              <td class="col-acao">
                <div class="flex gap-8" style="justify-content:flex-end">
                  <a href="/mestre/barbearias/<%= barbearia.id %>/equipe/<%= m.id %>/editar" class="btn btn-secundario btn-sm">Editar</a>
                  <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/equipe/<%= m.id %>/reset-senha" class="inline"
                        onsubmit="return confirm('Gerar uma senha provisória para <%= m.nome %>? A senha atual deixa de valer e aparece uma nova para você repassar.')">
                    <button class="btn btn-secundario btn-sm" type="submit">Resetar senha</button>
                  </form>
                  <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/equipe/<%= m.id %>/toggle" class="inline">
                    <button class="btn btn-secundario btn-sm" type="submit"><%= m.ativo ? 'Desativar' : 'Ativar' %></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <h3 class="mt-16">Adicionar barbeiro</h3>
  <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/equipe" class="form mt-16">
    <div class="grid-2">
      <div class="campo">
        <label for="bnome">Nome</label>
        <input id="bnome" name="nome" required />
      </div>
      <div class="campo">
        <label for="bemail">E-mail</label>
        <input id="bemail" type="email" name="email" required />
      </div>
    </div>
    <div class="grid-2">
      <div class="campo">
        <label for="bsenha">Senha (mínimo 6)</label>
        <input id="bsenha" type="text" name="senha" required />
      </div>
      <div class="campo">
        <label for="bpapel">Papel</label>
        <select id="bpapel" name="papel">
          <option value="funcionario">Barbeiro</option>
          <option value="admin">Admin</option>
        </select>
      </div>
    </div>
    <div class="mt-16">
      <button class="btn btn-primario btn-sm" type="submit">Adicionar</button>
    </div>
  </form>
</div>

<!-- Zona de perigo -->
<div class="card">
  <h2>Excluir barbearia</h2>
  <p class="texto-secundario mt-16">Remove a barbearia e todos os dados dela (equipe, clientes, agenda, caixa). Não dá para desfazer.</p>
  <form method="POST" action="/mestre/barbearias/<%= barbearia.id %>/remover" class="mt-16"
        onsubmit="return confirm('Excluir a barbearia <%= barbearia.nome %> e TODOS os dados dela?')">
    <button class="btn-x" style="width:auto;padding:8px 16px;border-radius:8px;" type="submit">Excluir barbearia</button>
  </form>
</div>
