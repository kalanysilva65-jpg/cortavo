<div class="m-topo">
  <div>
    <h1>Auditoria</h1>
    <p class="cv-texto-apoio">Registro das ações administrativas do painel-mestre. Só leitura — nada aqui é editável ou apagável pelo app.</p>
  </div>
  <a href="/mestre" class="cv-btn cv-btn--2 cv-btn--p">← Voltar</a>
</div>

<div class="cv-cartao m-bloco">
  <h2>Ações (<%= total %>)</h2>
  <% if (logs.length === 0) { %>
    <p class="cv-texto-apoio m-mt">Nenhuma ação registrada ainda.</p>
  <% } else { %>
    <div class="m-rolagem">
      <table class="m-tab m-mt">
        <thead>
          <tr>
            <th>Quando</th>
            <th>Quem</th>
            <th>Ação</th>
            <th>Detalhe</th>
            <th>IP</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function (log) { %>
            <tr>
              <td><span class="m-sutil"><%= new Date(log.criadoEm).toLocaleString('pt-BR') %></span></td>
              <td><%= log.adminNome %></td>
              <td><span class="cv-etq"><%= log.acao %></span></td>
              <td><%= log.detalhe || '' %></td>
              <td><span class="m-sutil"><%= log.ip || '—' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (paginacao.totalPaginas > 1) { %>
      <div class="m-flex m-mt" style="align-items:center;justify-content:center">
        <% if (paginacao.pagina > 1) { %>
          <a href="/mestre/auditoria?pagina=<%= paginacao.pagina - 1 %>" class="cv-btn cv-btn--2 cv-btn--p">← Anterior</a>
        <% } %>
        <span class="m-sutil">Página <%= paginacao.pagina %> de <%= paginacao.totalPaginas %></span>
        <% if (paginacao.pagina < paginacao.totalPaginas) { %>
          <a href="/mestre/auditoria?pagina=<%= paginacao.pagina + 1 %>" class="cv-btn cv-btn--2 cv-btn--p">Próxima →</a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>
