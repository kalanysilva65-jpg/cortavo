<%
  // Agenda pública v3 (F12): a barbearia é a protagonista; o Cortavo aparece só
  // no rodapé ("feito com Cortavo"). Passo 0 = consulta de plano (fora da
  // trilha de 4 etapas); passo 5 = pronto (sem cabeçalho: o selo é o topo).
  var AG_NOMES = { 0: 'Plano', 1: 'Serviços', 2: 'Barbeiro', 3: 'Horário', 4: 'Dados', 5: 'Pronto' };
  var agPasso = (typeof passo !== 'undefined' && passo !== null) ? Number(passo) : 0;
  var agNome = AG_NOMES[agPasso] || '';
  var agVoltar = (typeof voltarHref !== 'undefined' && voltarHref) ? voltarHref : null;
  var agMarca = (typeof barbearia !== 'undefined' && barbearia) ? barbearia.nome : 'Agendamento';
  var agLogo = (typeof marcaLogoUrl !== 'undefined' && marcaLogoUrl) ? marcaLogoUrl : null;
  // Inicial sem o "Barbearia " da frente (mesma regra do mockup).
  var agIni = (agMarca.replace(/^Barbearia\s+(d[aeo]s?\s+|e\s+)?/i, '') || agMarca).charAt(0).toUpperCase();
  var agHoje = (typeof horarioHoje !== 'undefined' && horarioHoje) ? horarioHoje : null;
  var agFmt = typeof fmtT6 === 'function' ? fmtT6 : function (c) { return 'R$' + Math.round(c / 100); };

  // Resumo do painel da esquerda (PC): vem dos mesmos locais do passo.
  var ladoLinhas = [];
  var ladoTotal = null;
  var temAss = typeof assinatura !== 'undefined' && assinatura;
  if (agPasso >= 2 && agPasso <= 4 && typeof servicos !== 'undefined' && servicos && servicos.length) {
    servicos.forEach(function (s) { ladoLinhas.push([s.nome, temAss ? 'Incluso' : agFmt(s.valor)]); });
    if (agPasso >= 3 && typeof barbeiro !== 'undefined' && barbeiro) ladoLinhas.push(['Barbeiro', barbeiro.nomePublico || barbeiro.nome]);
    if (agPasso === 4 && typeof dataExtenso !== 'undefined') ladoLinhas.push(['Quando', dataExtenso + ' · ' + hora]);
    if (typeof valorTotal !== 'undefined') ladoTotal = temAss ? 'Plano' : ((typeof aPartirDe !== 'undefined' && aPartirDe) ? 'a partir de ' : '') + agFmt(valorTotal);
  }
  var LOGO_D = 'M600 350A250 250 0 1 0 415 763L550 765L897 385L760 385L483 686L450 662L430 652A139.8 139.8 0 1 1 522 427Z';
  var feitoHTML = '<p class="ap-feito"><svg viewBox="150 240 770 545" aria-hidden="true"><path fill="currentColor" d="' + LOGO_D + '"/></svg>feito com Cortavo</p>';
  function logoHTML() {
    return agLogo ? '<img src="' + String(agLogo).replace(/"/g, '&quot;') + '" alt="" />' : '<span class="ini">' + agIni.replace(/</g, '&lt;') + '</span>';
  }
%>
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %><%= agMarca %></title>
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/cv.css" />
    <link rel="stylesheet" href="/css/cv-agendar.css" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F2F2F2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <script src="/js/cv-mola.js" defer></script>
    <script src="/js/cv-movimento.js" defer></script>
    <script>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){})})}</script>
  </head>
  <body class="ap">
    <%/* Aviso fixo das barbearias de demonstração (spec 03). */%>
    <% if (typeof barbearia !== 'undefined' && barbearia && ['demo', 'vitrine'].includes(barbearia.slug)) { %>
      <p class="ap-aviso ap-aviso--demo" role="note">Barbearia de demonstração: pode marcar à vontade, ninguém vai aparecer.</p>
    <% } %>
    <div class="ap-grade">
      <aside class="ap-lado" aria-label="Barbearia">
        <a class="ap-marca-link" href="/agendar" aria-label="<%= agMarca %>, início"><span class="ap-logo"><%- logoHTML() %></span></a>
        <h1><%= agMarca %></h1>
        <p class="info"><% if (agHoje) { %><%= agHoje.texto %><br><% } %>Agende em menos de um minuto. A confirmação chega no seu WhatsApp.</p>
        <div class="escolha">
          <h2>Seu agendamento</h2>
          <% if (ladoLinhas.length) { %>
            <div class="ap-conta">
              <% ladoLinhas.forEach(function (l) { %><div><span><%= l[0] %></span><b><%= l[1] %></b></div><% }) %>
            </div>
            <% if (ladoTotal) { %><div class="ap-total"><span>Total</span><b class="ap-total-val"><%= ladoTotal %></b></div><% } %>
          <% } else { %>
            <p class="vazio"><%= agPasso === 5 ? 'Tudo certo. Até já!' : 'Escolha os serviços para começar.' %></p>
          <% } %>
        </div>
        <%- feitoHTML %>
      </aside>

      <main class="ap-tela">
        <% if (agPasso !== 5) { %>
          <header class="ap-marca">
            <a class="ap-marca-link" href="/agendar" aria-label="<%= agMarca %>, início"><span class="ap-logo"><%- logoHTML() %></span></a>
            <span class="ap-marca-txt"><b><%= agMarca %></b><% if (agHoje) { %><span><% if (agHoje.aberto) { %><i></i><% } %><%= agHoje.texto %></span><% } %></span>
            <% if (agVoltar) { %>
              <a class="cv-redondo ap-voltar" href="<%= agVoltar %>" aria-label="Voltar"><%- include('../partials/icone', { cvIc: 'esquerda', cvCls: 'cv-ic--20' }) %></a>
            <% } %>
          </header>
          <% if (agPasso >= 1 && agPasso <= 4) { %>
            <div class="ap-trilha" role="progressbar" aria-valuemin="1" aria-valuemax="4" aria-valuenow="<%= agPasso %>" aria-label="Passo <%= agPasso %> de 4">
              <% for (var i = 1; i <= 4; i++) { %><i class="<%= i < agPasso ? 'feito' : (i === agPasso ? 'atual' : '') %>"></i><% } %>
            </div>
            <div class="ap-passo-rot"><b><%= agNome %></b><span><%= agPasso %> de 4</span></div>
          <% } %>
        <% } %>
        <%- body %>
        <% if (agPasso !== 5) { %><div class="ap-feito-cel"><%- feitoHTML %></div><% } %>
      </main>
    </div>
    <script src="/js/aviso-conexao.js" defer></script>
  </body>
</html>
