<%
  // Cabeçalho do design SUAVE (2026-07-31): a marca vai pro CENTRO (a
  // referência dedica 112px a ela) e "Voltar" vira uma pílula branca no canto
  // direito. O passo 0 é a consulta de plano — fica FORA da trilha de 4 etapas
  // do agendamento, então não acende tracinho nenhum. O passo 5 (sucesso)
  // fecha os quatro.
  var AG_NOMES = { 0: 'Plano', 1: 'Serviços', 2: 'Barbeiro', 3: 'Horário', 4: 'Dados', 5: 'Pronto' };
  var agPasso = (typeof passo !== 'undefined' && passo !== null) ? Number(passo) : 0;
  var agNome = AG_NOMES[agPasso] || '';
  var agAtual = Math.min(Math.max(agPasso, 1), 4);
  // O destino do "Voltar" muda por passo (e carrega a querystring do fluxo),
  // então quem sabe dele é o controlador — a view só desenha.
  var agVoltar = (typeof voltarHref !== 'undefined' && voltarHref) ? voltarHref : null;
  var agMarca = (typeof barbearia !== 'undefined' && barbearia) ? barbearia.nome : 'Agendamento';
%>
<!DOCTYPE html>
<html lang="pt-BR" class="sv-ag-html">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %><%= agMarca %></title>
    <%/* 'Overused Grotesk' agora vem do próprio pacote (public/fonts) — o
         @font-face está em agendamento-novo.css. Sem Google Fonts: uma ida à
         rede a menos antes do primeiro quadro, e a fonte certa mesmo offline. */%>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/tema-minimal.css" />
    <link rel="stylesheet" href="/css/agendamento-novo.css" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f2f2f2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <script>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){})})}</script>
  </head>
  <body class="sv-ag-body">
    <div class="sv-ag6-tela">
      <%/* Aviso fixo das barbearias de demonstração (spec 03). */%>
      <% if (typeof barbearia !== 'undefined' && barbearia && ['demo', 'vitrine'].includes(barbearia.slug)) { %>
        <p class="sv-ag6-aviso-demo" role="note" style="margin:0;padding:10px 16px;font-size:14px;text-align:center;background:#f3efe7;color:#2b2620;border-bottom:1px solid #e4ddd0">
          Barbearia de demonstração: pode marcar à vontade, ninguém vai aparecer.
        </p>
      <% } %>
      <header class="sv-ag6-topo">
        <div class="sv-ag6-marca-linha">
          <%/* O acesso da equipe (login) saiu do topo público a pedido do dono
               (2026-09-06): a página é do cliente, e o atalho da equipe poluía.
               A equipe entra por cortavo.com.br/login direto. */%>
          <a href="/agendar" class="sv-ag6-marca">
            <% if (typeof marcaLogoUrl !== 'undefined' && marcaLogoUrl) { %>
              <img class="sv-ag6-marca-logo" src="<%= marcaLogoUrl %>" alt="<%= agMarca %>" />
            <% } else { %>
              <span class="sv-ag6-marca-inicial"><%= agMarca.charAt(0).toUpperCase() %></span>
              <span class="sv-ag6-marca-nome"><%= agMarca %></span>
            <% } %>
          </a>
          <% if (agVoltar) { %>
            <a class="sv-ag6-pilula sv-ag6-pilula--canto sv-ag6-pilula--dir" href="<%= agVoltar %>">Voltar</a>
          <% } %>
        </div>

        <div class="sv-ag6-topo-linha">
          <div class="sv-ag6-ticks">
            <% for (var i = 1; i <= 4; i++) { %>
              <span class="sv-ag6-tick <%= i < agAtual || agPasso === 5 ? 'feito' : '' %> <%= i === agAtual && agPasso >= 1 && agPasso <= 4 ? 'atual' : '' %>"></span>
            <% } %>
          </div>
          <% if (agNome) { %><div class="sv-ag6-passo-nome"><%= agNome %></div><% } %>
        </div>
      </header>

      <main class="sv-ag6-corpo">
        <%- include('../partials/flash') %>
        <%- body %>
      </main>
    </div>
  <script src="/js/aviso-conexao.js" defer></script>
<script src="/js/folha-arrastar.js" defer></script>
</body>
</html>
