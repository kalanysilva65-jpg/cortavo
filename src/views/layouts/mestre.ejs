<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>Painel-mestre</title>
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/tokens.css?v=<%= assetV %>" />
    <link rel="stylesheet" href="/css/cv.css?v=<%= assetV %>" />
    <link rel="stylesheet" href="/css/sv-mestre.css?v=<%= assetV %>" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f2f2f2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header class="topo">
      <div class="container topo-inner">
        <a href="/mestre" class="marca-mestre">CORTAVO</a>
        <div class="topo-usuario">
          <span class="usuario-nome"><%= usuario.nome %></span>
          <span class="badge-papel">Dono</span>
          <form method="POST" action="/logout" class="inline">
            <button class="btn btn-secundario btn-sm" type="submit">Sair</button>
          </form>
        </div>
      </div>
    </header>

    <main class="container conteudo">
      <%- include('../partials/flash') %> <%- body %>
    </main>
  <script src="/js/aviso-conexao.js" defer></script>
<script src="/js/foto-comprimir.js" defer></script>
<script src="/js/folha-arrastar.js" defer></script>
<script src="/js/cv-mola.js?v=<%= assetV %>" defer></script>
<script src="/js/cv-movimento.js?v=<%= assetV %>" defer></script>
</body>
</html>
