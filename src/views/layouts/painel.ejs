<%
  // Precisa vir ANTES do <head>: é daqui que sai quais CSS a página carrega.
  // Redesign v3 completo (F11, 2026-10-10): toda tela do painel é v3; a pilha
  // antiga (styles, suave, sv-*, tema-minimal, painel-app, painel-novo) saiu.
  // Telas migradas, uma fatia por vez (registro do que já foi conferido em
  // print e teste). A faixa do teste grátis mora só na Início.
  var TELAS_V3 = ['/painel', '/painel/mais', '/painel/gestao', '/painel/agenda', '/painel/caixa', '/painel/caixa/fechar', '/painel/comissoes', '/painel/secretaria', '/painel/meu-plano', '/painel/perfil', '/painel/link', '/painel/link/cartaz', '/painel/clientes', '/painel/equipe', '/painel/servicos', '/painel/produtos', '/painel/estoque', '/painel/planos', '/painel/metas', '/painel/logo', '/painel/horarios', '/painel/fidelidade', '/painel/conversas', '/painel/ia', '/painel/relatorios'];
  // Telas de cadastro e configuração v3: peças comuns (cv-cadastro.css/js).
  var CAD_V3 = ['/painel/clientes', '/painel/equipe', '/painel/servicos', '/painel/produtos', '/painel/estoque', '/painel/planos', '/painel/metas', '/painel/logo', '/painel/horarios', '/painel/fidelidade', '/painel/conversas', '/painel/ia', '/painel/relatorios', '/painel/caixa'];
  // Formulários avulsos (links antigos) também no v3.
  var AVULSOS_V3 = /^\/painel\/(estoque|servicos|planos)\/(novo|\d+\/editar)$|^\/painel\/agenda\/novo$|^\/painel\/secretaria\/teste$/;
  var ehCad = CAD_V3.indexOf(currentPath) !== -1 || AVULSOS_V3.test(currentPath);
  // Folha de estilo e script próprios de uma tela v3 (além de cv-telas).
  var EXTRA_V3 = { '/painel/secretaria/teste': 'cv-ia', '/painel/ia': 'cv-ia', '/painel/conversas': 'cv-conversas', '/painel': 'cv-link', '/painel/link': 'cv-link', '/painel/link/cartaz': 'cv-link', '/painel/agenda': 'cv-agenda', '/painel/caixa': 'cv-caixa', '/painel/caixa/fechar': 'cv-caixa', '/painel/comissoes': 'cv-comissoes', '/painel/secretaria': 'cv-secretaria', '/painel/meu-plano': 'cv-secretaria', '/painel/perfil': 'cv-secretaria' };
  var extraV3 = EXTRA_V3[currentPath] || null;
  // Script próprio da tela (nem toda tela v3 tem).
  var JS_V3 = { '/painel/link': 'cv-link', '/painel/link/cartaz': 'cv-link', '/painel/agenda': 'cv-agenda', '/painel/caixa': 'cv-caixa', '/painel/caixa/fechar': 'cv-caixa', '/painel/comissoes': 'cv-comissoes' };
  var jsV3 = JS_V3[currentPath] || null;
  var ehV3 = true; // F11: não há mais tela na pilha antiga
%>
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <%/* maximum-scale=1 + user-scalable=no travam o zoom (pinça e toque-duplo):
         dentro do app (WKWebView do Capacitor) o zoom desalinhava a tela e a
         barra fixa. É respeitado no app; no Safari comum é ignorado (ok). */%>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %><%= (typeof barbeariaAtual !== 'undefined' && barbeariaAtual) ? barbeariaAtual.nome : 'Painel' %></title>
    <%/* v3: tokens e componentes da Dani; cv.css traz a base nativa e as
         classes cv-. Só o peso 800 é pré-carregado (números e títulos). */%>
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/tokens.css?v=<%= assetV %>" />
    <link rel="stylesheet" href="/css/cv.css?v=<%= assetV %>" />
    <%/* Casca v3 (navbar, avisos) e as peças de tela. */%>
    <link rel="stylesheet" href="/css/cv-telas.css?v=<%= assetV %>" />
    <%/* F13: menu lateral e grades no PC (só vale a partir de 1024 px). */%>
    <link rel="stylesheet" href="/css/cv-pc.css?v=<%= assetV %>" />
    <% if (ehCad) { %><link rel="stylesheet" href="/css/cv-cadastro.css?v=<%= assetV %>" /><% } %>
    <% if (extraV3) { %><link rel="stylesheet" href="/css/<%= extraV3 %>.css?v=<%= assetV %>" /><% } %>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F2F2F2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <script>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){})})}</script>
    <%/* Avisos nativos: só age dentro do app da loja (Capacitor). No navegador
         o arquivo sai sem fazer nada — lá quem cuida é o Web Push do Perfil. */%>
    <script defer src="/js/push-nativo.js?v=<%= assetV %>"></script>
    <%/* Movimento v3 (M1 a M7): molas da Apple em CSS linear() + WAAPI. */%>
    <script src="/js/cv-mola.js?v=<%= assetV %>" defer></script>
    <script src="/js/cv-movimento.js?v=<%= assetV %>" defer></script>
    <script src="/js/cv-vida.js?v=<%= assetV %>" defer></script>
  </head>
  <%
    // Telas de tela cheia, sem a barra de navegação (pedido do dono, 2026-09-30).
    // v3: a navbar é fixa em todas as seções (spec 12); só as telas cheias de
    // conversa (campo de texto no rodapé) e a de logo ficam sem ela.
    // Formulários de página inteira (AVULSOS_V3) também saem sem navbar: o
    // botão final fica fixo no pé (revisão Dani, P1 #4).
    var semNav = AVULSOS_V3.test(currentPath) || currentPath === '/painel/ia' || currentPath === '/painel/secretaria/teste' || (currentPath === '/painel/conversas' && typeof aberta !== 'undefined' && !!aberta);
  %>
  <body class="app-painel pg-cv<%= semNav ? ' sem-nav' : '' %>">
    <%/* .cv-palco recua quando uma folha abre (M4); o aviso do servidor vira
         o aviso em vidro preto acima da navbar. */%>
    <div class="cv-palco"><main class="cv-tela" id="tela"><%- body %></main></div>
    <%- include('../partials/flash', { flashCv: true }) %>
    <%- include('../partials/nav-inferior') %>
  <script src="/js/aviso-conexao.js" defer></script>
<script src="/js/foto-comprimir.js" defer></script>
<% if (currentPath === '/painel/servicos' || /^\/painel\/servicos\/(novo|\d+\/editar)$/.test(currentPath)) { %><script src="/js/foto-mini.js?v=<%= assetV %>" defer></script><% } %>
<script src="/js/cv-casca.js?v=<%= assetV %>" defer></script>
<% if (ehCad) { %><script src="/js/cv-cadastro.js?v=<%= assetV %>" defer></script><% } %>
<% if (jsV3 === 'cv-link') { %><script src="/js/qr.js?v=<%= assetV %>" defer></script><% } %>
<% if (jsV3) { %><script src="/js/<%= jsV3 %>.js?v=<%= assetV %>" defer></script><% } %>
</body>
</html>
