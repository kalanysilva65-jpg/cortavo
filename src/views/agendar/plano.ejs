<%
  var DIAS_SEMANA_EXT = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
  function _diasPlanoLabel(diasStr) {
    var dias = String(diasStr || '').split(',').map(Number).filter(function (n) { return !isNaN(n); }).sort(function (a, b) { return a - b; });
    if (dias.length === 7) return 'todos os dias';
    var corrido = dias.every(function (d, i) { return i === 0 || d === dias[i - 1] + 1; });
    if (corrido && dias.length > 1) return DIAS_SEMANA_EXT[dias[0]] + ' a ' + DIAS_SEMANA_EXT[dias[dias.length - 1]];
    return dias.map(function (d) { return DIAS_SEMANA_EXT[d].slice(0, 3); }).join(', ');
  }
%>

<%/* v3 (F12): mesma gramática dos passos: título, o campo num cartão branco
     e a consulta no botão da barra de vidro. Os planos encontrados viram
     cartões, como os serviços. */%>
<form method="GET" action="/agendar/plano" id="ap-form-plano">
  <h1 class="ap-h1">Meu plano</h1>
  <p class="ap-sub">Informe seu telefone para verificarmos seu plano ativo.</p>
  <div class="ap-conteudo">
    <%- include('_aviso') %>
    <div class="ap-cartao">
      <div class="cv-campo">
        <label for="telefone">Telefone / WhatsApp</label>
        <input class="cv-entrada" id="telefone" name="telefone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(11) 90000-0000" value="<%= telefoneDigitado %>" required autofocus />
      </div>
    </div>

    <% if (resultado) { %>
      <% if (resultado.assinaturas.length === 0) { %>
        <div class="ap-cartao ap-vazio"><b>Nenhum plano ativo</b><p>Nenhum plano ativo encontrado para esse telefone.</p><a href="/agendar" class="cv-btn cv-btn--2">Agendar sem plano</a></div>
      <% } else { %>
        <div class="ap-bloco-cab"><b>Olá, <%= resultado.cliente.nome.split(' ')[0] %></b><span><%= resultado.assinaturas.length %> plano<%= resultado.assinaturas.length > 1 ? 's' : '' %></span></div>
        <% resultado.assinaturas.forEach(function (a) { %>
          <a class="ap-item" href="<%= a.plano.servicos.length === 1 ? '/agendar/barbeiro?servicoId=' + a.plano.servicos[0].servicoId + '&assinatura=' + a.id : '/agendar?assinatura=' + a.id %>">
            <span class="txt">
              <b><%= a.plano.nome %></b>
              <small>
                <%= a.plano.tipo === 'ilimitado' ? 'Ilimitado · ' + _diasPlanoLabel(a.plano.diasSemana) : (a.usosPorServico ? (function(){ try { var m = JSON.parse(a.usosPorServico); return a.plano.servicos.filter(function(x){ return x.servicoId in m; }).map(function(x){ return x.servico.nome + ': ' + m[x.servicoId]; }).join(' · '); } catch (e) { return a.usosRestantes + ' uso(s) restante(s)'; } })() : a.usosRestantes + ' uso(s) restante(s)') %>
                · até <%= fmtData(a.dataFim) %><%= a.plano.servicos.length ? ' · ' + a.plano.servicos.map(function (x) { return x.servico.nome; }).join(' + ') : '' %>
              </small>
            </span>
            <span class="ap-usar">Usar</span>
          </a>
        <% }) %>
      <% } %>
    <% } %>
  </div>

  <div class="ap-barra ap-barra--so" role="region" aria-label="Consultar">
    <button class="cv-btn" type="submit">Consultar</button>
  </div>
</form>
