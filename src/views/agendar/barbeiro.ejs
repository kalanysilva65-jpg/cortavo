<%
  function _iniciais(nome) {
    var p = String(nome || '').trim().split(/\s+/);
    return p.length > 1 ? (p[0][0] + p[p.length - 1][0]).toUpperCase() : p[0].slice(0, 2).toUpperCase();
  }
  function _primeiroNome(nome) {
    return String(nome || '').trim().split(/\s+/)[0];
  }
  function _duracao(min) {
    if (min < 60) return min + ' min';
    var h = Math.floor(min / 60);
    var r = min % 60;
    return h + 'h' + (r ? String(r).padStart(2, '0') : '');
  }
  var qsBase = 'servicoIds=' + servicoIdsStr + (assinatura ? '&assinatura=' + assinatura.id : '');
%>

<%/* v3 (F12): ladrilhos com retrato (2 colunas no celular, 3 no PC). O 1º
     barbeiro já vem escolhido; "Qualquer disponível" fica por ÚLTIMO (pedido
     do dono, 2026-09-06). O toque só marca: quem avança é a barra de vidro. */%>
<% var SIL = '<svg class="sil" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="36" r="19" fill="currentColor"/><path d="M10 100c3-24 20-38 40-38s37 14 40 38z" fill="currentColor"/></svg>'; %>
<h1 class="ap-h1">Com quem?</h1>
<p class="ap-sub"><%= servicos.map(function (s) { return s.nome; }).join(' + ') %></p>
<div class="ap-conteudo">
  <%- include('_aviso') %>
  <% if (barbeiros.length === 0) { %>
    <div class="ap-cartao ap-vazio"><div class="listra"></div><b>Nenhum barbeiro disponível agora</b><p>Volte mais tarde ou fale direto com a barbearia.</p></div>
  <% } else { %>
    <div class="ap-barbs" id="ag6-trilho" role="group" aria-label="Barbeiro">
      <% barbeiros.forEach(function (b, i) { %>
        <% var totalB = (typeof totais !== 'undefined' && totais[b.id] !== undefined) ? totais[b.id] : valorTotal; %>
        <button type="button" class="ap-barb <%= i === 0 ? 'ativo' : '' %>" aria-pressed="<%= i === 0 ? 'true' : 'false' %>" data-href="/agendar/horario?<%= qsBase %>&barbeiroId=<%= b.id %>" data-total="<%= assinatura ? 'Incluso' : fmtT6(totalB) %>" data-nome="com <%= b.nomePublico || b.nome %>">
          <span class="ap-retrato">
            <% if (b.fotoUrl) { %>
              <img src="<%= b.fotoUrl %>" alt="" loading="lazy"<% if (b.fotoPos) { %> style="object-position: <%= b.fotoPos %>"<% } %> />
            <% } else { %><%- SIL %><% } %>
            <span class="ap-sel-marca"><%- include('../partials/icone', { cvIc: 'check', cvCls: 'cv-ic--16' }) %></span>
          </span>
          <span class="rod">
            <b><%= b.nomePublico || b.nome %></b>
            <small><% if (b.descricao) { %><span class="d"><%= b.descricao %></span><% } %><%= assinatura ? 'Incluso' : fmtT6(totalB) %></small>
          </span>
        </button>
      <% }) %>
      <% if (mostrarQualquer) { %>
        <% var totalAny = (typeof totalQualquer !== 'undefined') ? totalQualquer : valorTotal;
           var rotAny = assinatura ? 'Incluso' : ((typeof qualquerVaria !== 'undefined' && qualquerVaria) ? 'a partir de ' : '') + fmtT6(totalAny); %>
        <button type="button" class="ap-barb ap-barb--qualquer" aria-pressed="false" data-href="/agendar/horario?<%= qsBase %>&barbeiroId=any" data-total="<%= rotAny %>" data-nome="Qualquer disponível">
          <span class="ap-retrato"><%- include('../partials/icone', { cvIc: 'equipe' }) %><span class="ap-sel-marca"><%- include('../partials/icone', { cvIc: 'check', cvCls: 'cv-ic--16' }) %></span></span>
          <span class="rod"><b>Qualquer disponível</b><small>Mais rápido para agendar</small></span>
        </button>
      <% } %>
    </div>
  <% } %>
</div>

<% if (barbeiros.length > 0) { %>
  <div class="ap-barra" role="region" aria-label="Resumo e continuar">
    <span class="info"><b id="ag6-barb-total"><%= assinatura ? 'Incluso' : fmtT6((typeof totais !== 'undefined' && totais[barbeiros[0].id] !== undefined) ? totais[barbeiros[0].id] : valorTotal) %></b><span id="ag6-barb-sub">com <%= barbeiros[0].nomePublico || barbeiros[0].nome %> · <%= _duracao(duracaoTotal) %></span></span>
    <a class="cv-btn" id="ag6-barb-cta" href="/agendar/horario?<%= qsBase %>&barbeiroId=<%= barbeiros[0].id %>">Continuar</a>
  </div>

  <script>
    // O toque no ladrilho só marca a escolha (destaque + destino da barra);
    // quem segue pro horário é a barra, igual aos outros passos.
    (function () {
      var trilho = document.getElementById('ag6-trilho');
      if (!trilho) return;
      var tiles = Array.prototype.slice.call(trilho.querySelectorAll('.ap-barb'));
      var cta = document.getElementById('ag6-barb-cta');
      var totalEl = document.getElementById('ag6-barb-total');
      var subEl = document.getElementById('ag6-barb-sub');
      var dur = <%- JSON.stringify(_duracao(duracaoTotal)) %>;

      tiles.forEach(function (tile) {
        tile.addEventListener('click', function () {
          tiles.forEach(function (t) {
            t.classList.toggle('ativo', t === tile);
            t.setAttribute('aria-pressed', t === tile ? 'true' : 'false');
          });
          cta.href = tile.dataset.href;
          // O preço pode variar por barbeiro: a barra mostra o total de quem foi escolhido.
          if (totalEl && tile.dataset.total) totalEl.textContent = tile.dataset.total;
          if (subEl && tile.dataset.nome) subEl.textContent = tile.dataset.nome + ' · ' + dur;
        });
      });
    })();
  </script>
<% } %>
