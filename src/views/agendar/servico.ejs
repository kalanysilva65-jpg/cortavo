<%
  function _diasPlanoLabelServico(diasStr) {
    var DIAS = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'];
    var dias = String(diasStr || '').split(',').map(Number).filter(function (n) { return !isNaN(n); }).sort(function (a, b) { return a - b; });
    if (dias.length === 7) return 'todos os dias';
    var corrido = dias.every(function (d, i) { return i === 0 || d === dias[i - 1] + 1; });
    if (corrido && dias.length > 1) return DIAS[dias[0]] + '–' + DIAS[dias[dias.length - 1]];
    return dias.map(function (d) { return DIAS[d]; }).join(', ');
  }
%>

<%/* v3 (F12): cartões brancos; o escolhido vira o objeto preto. Foto do
     serviço é OPCIONAL: com foto, miniatura 72px à direita (fotoMiniUrl, a
     versão leve; cai na fotoUrl se não houver), com a faixa listrada do M3 até
     a imagem chegar; sem foto, o cartão fica como antes (sem buraco). */%>
<%
  function _fotoServ(s) {
    var u = s.fotoMiniUrl || s.fotoUrl;
    if (!u) return '';
    return '<span class="ap-foto"><img src="' + String(u).replace(/"/g, '&quot;') + '" alt="" width="72" height="72" loading="lazy" decoding="async" onload="this.parentNode.classList.add(&quot;carregada&quot;)" onerror="this.parentNode.remove()"></span>';
  }
%>
<h1 class="ap-h1">O que vamos fazer?</h1>
<p class="ap-sub"><%= assinatura ? 'Escolha o serviço do seu plano.' : 'Escolha um ou mais serviços.' %><% if (!assinatura) { %> <span id="ag6-conta" aria-live="polite"></span><% } %></p>
<div class="ap-conteudo">
  <%- include('_aviso') %>
  <% if (assinatura) { %>
    <p class="ap-aviso">
      Usando o plano <strong><%= assinatura.plano.nome %></strong><%= assinatura.usosRestantes !== null ? ' · ' + (assinatura.usosPorServico ? (function(){ try { var m = JSON.parse(assinatura.usosPorServico); return assinatura.plano.servicos.filter(function(x){ return x.servicoId in m; }).map(function(x){ return x.servico.nome + ': ' + m[x.servicoId]; }).join(' · '); } catch (e) { return assinatura.usosRestantes + ' uso(s) restante(s)'; } })() : assinatura.usosRestantes + ' uso(s) restante(s)') : ' · ilimitado (' + _diasPlanoLabelServico(assinatura.plano.diasSemana) + ')' %>.
      <a href="/agendar">Agendar sem plano</a>
    </p>
  <% } else if (servicos.length > 0) { %>
    <%/* A porta do plano fica ANTES da lista: quem tem plano não deve
         percorrer os preços pra depois descobrir o atalho. */%>
    <a href="/agendar/plano" class="ap-plano"><%- include('../partials/icone', { cvIc: 'cartao', cvCls: 'cv-ic--18' }) %>Já tenho um plano</a>
  <% } %>

  <% if (servicos.length === 0) { %>
    <div class="ap-cartao ap-vazio"><div class="listra"></div><b>Nenhum serviço disponível agora</b><p>A barbearia ainda está montando a agenda. Volte mais tarde ou fale direto com eles.</p></div>
  <% } else if (assinatura) { %>
    <%/* Plano: seleção única e direta por link (o plano cobre um serviço por
         agendamento: nada a somar). */%>
    <% servicos.forEach(function (s) { %>
      <a class="ap-serv" href="/agendar/barbeiro?servicoIds=<%= s.id %>&assinatura=<%= assinatura.id %>">
        <span class="txt"><b><%= s.nome %></b><small><%= s.duracaoMin %> min · Incluso</small></span>
        <%- _fotoServ(s) %>
        <span class="marca"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
      </a>
    <% }) %>
  <% } else { %>
    <form id="form-servicos" action="/agendar/barbeiro" method="GET" onsubmit="return validarSelecao()">
      <input type="hidden" name="servicoIds" id="servicoIds-input" value="" />
      <div id="lista-servicos" style="display:grid;gap:10px">
        <% servicos.forEach(function (s) {
             /* Preço pode variar por barbeiro: aqui o barbeiro ainda não foi
                escolhido, então mostra "a partir de" o menor valor. */
             var fx = (typeof faixas !== 'undefined' && faixas[s.id]) || { min: s.valor, max: s.valor };
             var varia = fx.min !== fx.max; %>
          <button type="button" class="ap-serv" aria-pressed="false" data-id="<%= s.id %>" data-valor="<%= fx.min %>" data-varia="<%= varia ? '1' : '' %>" data-min="<%= s.duracaoMin %>" data-encaixe="<%= s.ehEncaixe ? '1' : '' %>" onclick="toggleServico(this)">
            <span class="txt">
              <b><%= s.nome %></b>
              <small><%= s.duracaoMin %> min · <%= varia ? 'a partir de ' : '' %><%= fmtT6(fx.min) %></small>
              <% if (s.descricao) { %><span class="desc"><%= s.descricao %></span><% } %>
            </span>
            <%- _fotoServ(s) %>
            <span class="marca"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
          </button>
        <% }) %>
      </div>
    </form>
  <% } %>
</div>

<% if (!assinatura && servicos.length > 0) { %>
  <%/* Barra de vidro sempre visível: é o submit do formulário. Sem escolha,
       o botão fica cinza e a info diz o que fazer. */%>
  <div class="ap-barra" role="region" aria-label="Resumo e continuar">
    <span class="info">
      <span id="ag6-cta-vazio"><b>Nenhum serviço</b><span>Toque para escolher</span></span>
      <span id="ag6-cta-info" hidden><b id="ag6-cta-total">R$0</b><span id="ag6-cta-sub"></span></span>
    </span>
    <button class="cv-btn" type="submit" form="form-servicos" id="btn-continuar" disabled><span id="ag6-cta-cta">Continuar</span></button>
  </div>

  <script>
    // Seleção múltipla no cliente: o formulário leva só a lista de ids em um
    // campo escondido, então tudo o que a barra mostra (contagem, duração
    // somada, total) é recalculado aqui a cada toque.
    const selecionados = new Set();
    const precos = {};
    const duracoes = {};
    const encaixes = {};
    const variam = {};
    document.querySelectorAll('#lista-servicos .ap-serv').forEach(function (el) {
      precos[el.dataset.id] = Number(el.dataset.valor);
      variam[el.dataset.id] = el.dataset.varia === '1';
      duracoes[el.dataset.id] = Number(el.dataset.min);
      encaixes[el.dataset.id] = el.dataset.encaixe === '1';
    });
    // Regra do "encaixe": serviço-encaixe não soma tempo quando há outro serviço
    // normal na seleção; sozinho (ou só encaixes), conta a própria duração.
    function duracaoSelecao(ids) {
      var regular = 0, enc = 0;
      ids.forEach(function (id) { if (encaixes[id]) enc += duracoes[id]; else regular += duracoes[id]; });
      return regular > 0 ? regular : enc;
    }
    // "R$40": sem centavos e sem espaço (a barra é estreita).
    function fmtT6Local(centavos) {
      return 'R$' + Math.round(centavos / 100).toLocaleString('pt-BR');
    }
    function fmtDuracaoLocal(min) {
      if (min < 60) return min + ' min';
      const h = Math.floor(min / 60);
      const r = min % 60;
      return h + 'h' + (r ? String(r).padStart(2, '0') : '');
    }
    function toggleServico(el) {
      const id = el.dataset.id;
      if (selecionados.has(id)) {
        selecionados.delete(id);
        el.classList.remove('sel');
      } else {
        selecionados.add(id);
        el.classList.add('sel');
      }
      el.setAttribute('aria-pressed', selecionados.has(id) ? 'true' : 'false');
      document.getElementById('servicoIds-input').value = Array.from(selecionados).join(',');

      const n = selecionados.size;
      const btn = document.getElementById('btn-continuar');
      btn.disabled = n === 0;
      document.getElementById('ag6-conta').textContent = n ? n + ' selecionado' + (n > 1 ? 's' : '') + '.' : '';

      const ids = Array.from(selecionados);
      const total = ids.reduce(function (s, id) { return s + precos[id]; }, 0);
      const min = duracaoSelecao(ids);
      // Se algum escolhido muda de preço conforme o barbeiro, o total é "a partir de".
      const algumVaria = ids.some(function (id) { return variam[id]; });
      document.getElementById('ag6-cta-total').textContent = (algumVaria ? 'a partir de ' : '') + fmtT6Local(total);
      document.getElementById('ag6-cta-sub').textContent =
        n + ' serviço' + (n > 1 ? 's' : '') + ' · ' + fmtDuracaoLocal(min);
      // Vazio (nada escolhido) x info + "Continuar" (com escolha).
      document.getElementById('ag6-cta-vazio').hidden = n > 0;
      document.getElementById('ag6-cta-info').hidden = n === 0;
    }
    function validarSelecao() {
      return selecionados.size > 0;
    }
  </script>
<% } %>
