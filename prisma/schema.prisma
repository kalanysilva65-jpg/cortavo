// Modelo de dados da barbearia (MULTI-BARBEARIA / SaaS).
// Cada registro pertence a uma Barbearia (o "tenant"), identificada pelo `slug`
// (que vira o subdomínio: <slug>.seuapp.com). O painel-mestre (dono do sistema)
// enxerga todas as barbearias; cada barbearia só enxerga os próprios dados.
//
// Os nomes das tabelas/colunas no banco ficam em português (snake_case) via @map.
// Valores monetários são guardados como INTEIROS em centavos (ex.: 4000 = R$ 40,00)
// para evitar erros de arredondamento de ponto flutuante; a formatação acontece na view.

generator client {
  provider = "prisma-client-js"
  // Gera os motores de query para as plataformas Linux mais prováveis em
  // produção (Hostinger/CloudLinux é RHEL; cobrimos Debian e musl por garantia).
  // Sem isso, o motor gerado no build pode ser incompatível com o runtime e
  // crashar nativamente na primeira query. "native" mantém o dev local.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Tenant do sistema: uma barbearia assinante. O `slug` é o subdomínio.
model Barbearia {
  id       Int      @id @default(autoincrement())
  nome     String
  slug     String   @unique // subdomínio: <slug>.seuapp.com
  ativo    Boolean  @default(true)
  // Endereço e coordenadas (para a busca "perto de você" no app do cliente).
  // lat/lng são preenchidos automaticamente ao salvar o endereço (geocodificação).
  endereco  String?
  latitude  Float?
  longitude Float?
  capaUrl   String?  @map("capa_url") // foto de capa do hero da Home (em /uploads)
  notasInternas String? @map("notas_internas") // anotações do dono do SaaS sobre a barbearia (só o painel-mestre vê)
  // Plano da Cortavo (assinatura da barbearia com a Cortavo). NÃO confundir com
  // o model `Plano` (pacotes que a barbearia vende aos clientes dela).
  // Valores: "personalizado" | "essencial" | "barbearia" | "barbearia_ia".
  // O que cada plano libera fica num lugar só: src/services/planoCortavo.js.
  // "personalizado" = tudo liberado e tetos pela Configuracao (como antes da
  // fase 2); todas as barbearias que já existiam entram assim.
  planoCortavo       String    @default("personalizado") @map("plano_cortavo")
  planoCortavoDesde  DateTime? @map("plano_cortavo_desde") // quando o plano atual começou a valer
  // Teste grátis (fase 2.6, spec 05). Regras em src/services/testeGratis.js.
  // situacaoCortavo: "ativa" | "teste" | "pausada_teste" | "pausada_atraso".
  // Todas as barbearias que já existiam ficam "ativa", sem teste.
  situacaoCortavo        String    @default("ativa") @map("situacao_cortavo")
  testeInicio            DateTime? @map("teste_inicio")
  testeFim               DateTime? @map("teste_fim") // início + 14 dias (+ prorrogação)
  testeProrrogado        Boolean   @default(false) @map("teste_prorrogado") // só uma vez
  testeProrrogacaoMotivo String?   @map("teste_prorrogacao_motivo")
  testeSegurarPausa      Boolean   @default(false) @map("teste_segurar_pausa") // "Segurar pausa" da Kalany
  testePagoEm            DateTime? @map("teste_pago_em") // pagamento confirmado (manual até a spec 06)
  testeAvisoFimEm        DateTime? @map("teste_aviso_fim_em") // aviso do 12º dia já enviado
  testeAvisoVencidoEm    DateTime? @map("teste_aviso_vencido_em") // aviso do 15º dia já enviado
  testePausadoEm         DateTime? @map("teste_pausado_em")
  testeRespostas         Int       @default(0) @map("teste_respostas") // secretária no teste (separado do mensal)
  testeConsultas         Int       @default(0) @map("teste_consultas") // assistente no teste (50 no período, separado do mensal)
  fundador               String?   // null | "reservada" | "confirmada" (no máximo 5 ao mesmo tempo)
  fundadorEm             DateTime? @map("fundador_em")
  criadoEm DateTime @default(now()) @map("criado_em")

  usuarios           Usuario[]
  horariosTrabalho   HorarioTrabalho[]
  bloqueios          Bloqueio[]
  categoriasServico  CategoriaServico[]
  servicos           Servico[]
  agendamentos       Agendamento[]
  clientes           Cliente[]
  planos             Plano[]
  clientePlanos      ClientePlano[]
  categoriasEstoque  CategoriaEstoque[]
  estoque            Estoque[]
  categoriasCaixa    CategoriaCaixa[]
  caixa              Caixa[]
  configuracoes      Configuracao[]
  cupons             Cupom[]
  resgatesFidelidade FidelidadeResgate[]
  pagamentos         PagamentoAgendamento[]
  servicoInsumos     ServicoInsumo[]
  metas              Meta[]
  conversas          Conversa[]
  usoIA              UsoIA[]
  usoIAModelo        UsoIAModelo[]
  lembreteLogs       LembreteLog[]
  comissaoPagamentos ComissaoPagamento[]
  fechamentosCaixa   FechamentoCaixa[]

  @@map("barbearias")
}

/// Equipe / barbeiros (admin + funcionários) OU o dono do sistema.
/// - papel "dono": super-admin do SaaS, sem barbearia (barbeariaId nulo).
/// - papel "admin"/"funcionario": pertence a uma barbearia. Todos agendáveis.
model Usuario {
  id          Int      @id @default(autoincrement())
  barbeariaId Int?     @map("barbearia_id") // nulo apenas para o dono do sistema
  nome        String
  email       String
  senhaHash   String   @map("senha_hash")
  fotoUrl     String?  @map("foto_url") // foto do barbeiro (em /uploads)
  fotoPos     String?  @map("foto_pos") // enquadramento da foto no card público (object-position, ex.: "50% 30%")
  nomePublico String? @map("nome_publico") // como o nome aparece no agendamento público (null = usa `nome`); o dono da barbearia escolhe
  descricao   String? // texto curto do profissional no agendamento público (ex.: "Especialista em degradê")
  papel       String // "dono" | "admin" | "funcionario"
  ativo       Boolean  @default(true)
  senhaProvisoria Boolean @default(false) @map("senha_provisoria") // senha padrão/criada pelo admin: força troca no 1º login
  comissaoPercentual Float @default(50) @map("comissao_percentual") // % de comissão do barbeiro
  acessosBloqueados String? @map("acessos_bloqueados") // JSON das telas bloqueadas p/ funcionário; nulo = tudo liberado
  criadoEm  DateTime @default(now()) @map("criado_em")

  barbearia        Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  horariosTrabalho HorarioTrabalho[]
  bloqueios        Bloqueio[]
  agendamentos     Agendamento[]
  dispositivosPush DispositivoPush[]
  logsAuditoria    LogAuditoria[]
  metas            Meta[]
  precosServico    ServicoPrecoBarbeiro[]
  comissoesPagas   ComissaoPagamento[]

  // E-mail único DENTRO de cada barbearia (o mesmo e-mail pode existir em barbearias diferentes).
  @@unique([barbeariaId, email])
  @@map("usuarios")
}

/// Aparelho autorizado a receber aviso de agendamento novo.
///
/// Um usuário pode ter vários (celular, tablet, o computador da barbearia), e
/// cada um é uma inscrição independente — desligar o aviso num aparelho não
/// pode calar os outros.
///
/// Serve aos dois mundos: no navegador (Web Push) `endpoint` é a URL que o
/// próprio navegador fornece e p256dh/auth são as chaves de cifragem dela; no
/// app nativo (APNs/FCM, quando existir) `endpoint` guarda o token do aparelho
/// e as chaves ficam nulas. `plataforma` diz qual dos dois é, para o serviço de
/// envio saber por onde mandar.
model DispositivoPush {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  endpoint   String   @unique // URL do Web Push, ou token do aparelho no nativo
  p256dh     String? // só Web Push
  auth       String? // só Web Push
  plataforma String   @default("web") // web | ios | android
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("dispositivos_push")
}

/// Jornada de trabalho de cada barbeiro (um registro por dia da semana).
model HorarioTrabalho {
  id          Int     @id @default(autoincrement())
  barbeariaId Int     @map("barbearia_id")
  usuarioId   Int     @map("usuario_id")
  diaSemana   Int     @map("dia_semana") // 0=domingo ... 6=sábado
  horaInicio  String  @map("hora_inicio") // ex.: "09:00"
  horaFim     String  @map("hora_fim") // ex.: "20:00"
  trabalha    Boolean @default(true) // false = folga nesse dia

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // A tela de agendamento consulta a jornada por (barbeiro, dia da semana) a
  // cada troca de dia. Sem índice o SQLite varre a tabela inteira.
  @@index([usuarioId, diaSemana])
  @@map("horarios_trabalho")
}

/// Bloqueios manuais de horário (almoço, compromisso, dia fechado etc.).
model Bloqueio {
  id          Int      @id @default(autoincrement())
  barbeariaId Int      @map("barbearia_id")
  usuarioId   Int      @map("usuario_id")
  data        DateTime // dia do bloqueio (00:00)
  horaInicio  String   @map("hora_inicio")
  horaFim     String   @map("hora_fim")
  motivo      String? // opcional

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, data])
  @@map("bloqueios")
}

/// Categorias dos serviços/produtos do catálogo (configuráveis manualmente).
model CategoriaServico {
  id          Int       @id @default(autoincrement())
  barbeariaId Int       @map("barbearia_id")
  nome        String
  servicos    Servico[]

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@map("categorias_servico")
}

/// Serviços e produtos que o cliente agenda / a equipe adiciona ao atendimento.
model Servico {
  id          Int     @id @default(autoincrement())
  barbeariaId Int     @map("barbearia_id")
  nome        String
  descricao   String? // descrição curta exibida no card de agendamento
  categoriaId Int?    @map("categoria_id")
  valor       Int // centavos
  duracaoMin  Int     @map("duracao_min") // usado para calcular os horários
  fotoUrl     String? @map("foto_url") // caminho da imagem em /uploads
  ativo              Boolean @default(true)
  ehProduto          Boolean @default(false) @map("eh_produto") // produto x serviço
  // "Encaixe": serviço que, agendado JUNTO com outro, não soma tempo (cabe no
  // tempo do outro). Sozinho, conta a própria duração. Ver duracaoComEncaixe.
  ehEncaixe          Boolean @default(false) @map("eh_encaixe")
  comissaoPercentual Float   @default(10) @map("comissao_percentual") // % de comissão sobre o produto

  barbearia Barbearia         @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  categoria CategoriaServico? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  itens     AgendamentoItem[]
  planos    Plano[]
  insumos   ServicoInsumo[]
  precosBarbeiro ServicoPrecoBarbeiro[]
  planosIncluidos PlanoServico[]

  @@map("servicos")
}

/// Preço de um serviço PARA UM barbeiro específico (opcional). Sem linha aqui,
/// vale o preço padrão do serviço (Servico.valor). Regra única de leitura em
/// services/precos.js — usada pelo agendamento público, app, agenda manual,
/// secretária e FAQ, pra todos cobrarem o mesmo valor.
model ServicoPrecoBarbeiro {
  id          Int @id @default(autoincrement())
  barbeariaId Int @map("barbearia_id")
  servicoId   Int @map("servico_id")
  usuarioId   Int @map("usuario_id")
  valor       Int // centavos

  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([servicoId, usuarioId])
  @@index([barbeariaId])
  @@map("servico_precos_barbeiro")
}

/// "Receita" de consumo de estoque de um serviço/produto: ao CONCLUIR um
/// atendimento, cada item baixa `quantidade` unidades do item de estoque ligado
/// (multiplicado pela quantidade do item no atendimento). Cobre os dois casos:
/// produto vendido baixando a si mesmo ("vendeu, baixou") e serviço consumindo
/// insumos internos ("ficha técnica"). Reabrir/cancelar devolve ao estoque.
model ServicoInsumo {
  id          Int @id @default(autoincrement())
  barbeariaId Int @map("barbearia_id")
  servicoId   Int @map("servico_id")
  estoqueId   Int @map("estoque_id")
  quantidade  Int @default(1) // unidades consumidas por 1 unidade do serviço/produto

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  servico   Servico   @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  estoque   Estoque   @relation(fields: [estoqueId], references: [id], onDelete: Cascade)

  // Um serviço não repete o mesmo item de estoque (a quantidade já cobre isso).
  @@unique([servicoId, estoqueId])
  @@index([estoqueId])
  @@map("servico_insumos")
}

/// Agendamentos do cliente, vinculados a um barbeiro específico (obrigatório).
model Agendamento {
  id              Int      @id @default(autoincrement())
  barbeariaId     Int      @map("barbearia_id")
  usuarioId       Int      @map("usuario_id") // barbeiro escolhido
  clienteNome     String   @map("cliente_nome")
  clienteEmail    String?  @map("cliente_email")
  clienteTelefone String   @map("cliente_telefone")
  data            DateTime // dia do agendamento (00:00)
  horaInicio      String   @map("hora_inicio")
  // agendado | concluido | cancelado | faltou. "faltou" (no-show, spec 12 B3,
  // decisão da Kalany 2026-10-05) é SEPARADO de cancelado: o cliente não veio.
  // Lista única dos status em src/config/statusAgendamento.js.
  status          String   @default("agendado")
  // Instante em que o atendimento foi CONCLUÍDO (nulo enquanto não for).
  //
  // Não dá para deduzir de `data`: o barbeiro conclui hoje um atendimento que
  // era de ontem, e é no dia da conclusão que o dinheiro entra. Faturamento,
  // atendimentos e ticket médio contam por ESTE campo — decisão do dono em
  // 2026-08-16 ("o valor vai aparecer no dia que foi concluído"). A OCUPAÇÃO da
  // agenda continua contando por `data`, que é quando o barbeiro esteve ocupado.
  concluidoEm     DateTime? @map("concluido_em")
  // Instante em que o LEMBRETE de WhatsApp foi enviado (nulo = ainda não). Evita
  // mandar o mesmo lembrete duas vezes; preenchido pelo agendador (services/lembretes.js).
  lembreteEnviadoEm DateTime? @map("lembrete_enviado_em")
  valorTotal      Int      @default(0) @map("valor_total") // centavos; soma dos itens, salvo se totalManual
  // Total digitado à mão na folha de detalhe (desconto no pacote, valor
  // combinado). Quando ligado, o total MANDA: somar ou remover item não o
  // recalcula mais, porque o combinado com o cliente é que vale — a lista de
  // itens continua registrando o que foi feito, sem mexer no que se cobra.
  totalManual     Boolean  @default(false) @map("total_manual")
  // Como o cliente pagou (registrado ao concluir): pix | credito | debito | dinheiro.
  formaPagamento  String?  @map("forma_pagamento")
  clienteId       Int?     @map("cliente_id") // vínculo opcional ao cadastro LOCAL (CRM) da barbearia
  contaClienteId  Int?     @map("conta_cliente_id") // conta GLOBAL do app do cliente (marketplace)
  clientePlanoId  Int?     @map("cliente_plano_id") // assinatura usada (agendamento via plano)
  // Canal de origem do agendamento: publico (link) | app (marketplace) |
  // whatsapp (secretária IA) | barbeiro (manual no painel). Nulo = registros
  // anteriores a este campo (mostrados como "Anterior" no painel-mestre).
  origem          String?  @map("origem")
  // Cancelamento (spec 12, B3/G13). Nulos nos registros anteriores a estes
  // campos e em quem nunca foi cancelado. `canceladoPor` = quem pediu:
  // equipe | cliente | secretaria | assistente. `canceladoPorId` = o usuário da
  // equipe, quando foi a equipe (sem chave estrangeira de propósito: o
  // histórico sobrevive à saída do barbeiro). Reabrir limpa os quatro.
  canceladoEm        DateTime? @map("cancelado_em")
  canceladoPor       String?   @map("cancelado_por")
  canceladoPorId     Int?      @map("cancelado_por_id")
  motivoCancelamento String?   @map("motivo_cancelamento")
  criadoEm        DateTime @default(now()) @map("criado_em")

  barbearia    Barbearia         @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  usuario      Usuario           @relation(fields: [usuarioId], references: [id])
  cliente      Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  contaCliente ContaCliente?     @relation(fields: [contaClienteId], references: [id], onDelete: SetNull)
  clientePlano ClientePlano?     @relation(fields: [clientePlanoId], references: [id], onDelete: SetNull)
  itens        AgendamentoItem[]
  caixa        Caixa[]
  pagamentos   PagamentoAgendamento[]
  lembreteLogs LembreteLog[]

  // `agendamentos` é a tabela que mais cresce (nunca é limpa). Os dois filtros
  // quentes são: disponibilidade do barbeiro numa data (agendamento público) e
  // a agenda do dia da barbearia (painel).
  @@index([usuarioId, data])
  @@index([barbeariaId, data])
  // Faturamento, ticket e atendimentos contam por `concluidoEm` (decisão de
  // 2026-08-16); sem este índice a Gestão varria a tabela (spec 12, B3).
  @@index([barbeariaId, concluidoEm])
  @@map("agendamentos")
}

/// Como um atendimento foi pago. Uma linha por FORMA usada: o cliente pode
/// dividir a conta (ex.: R$20 em dinheiro + R$25 em 2x no crédito), e cada
/// pedaço vira uma linha aqui e uma entrada própria no caixa — é o que mantém
/// o relatório "por forma de pagamento" correto quando a conta é dividida.
///
/// `Agendamento.formaPagamento` continua existindo como resumo do caso simples
/// (uma forma só) e para os registros antigos, anteriores a esta tabela.
model PagamentoAgendamento {
  id             Int    @id @default(autoincrement())
  barbeariaId    Int    @map("barbearia_id")
  agendamentoId  Int    @map("agendamento_id")
  valor          Int // centavos
  formaPagamento String @map("forma_pagamento") // pix | credito | debito | dinheiro
  parcelas       Int    @default(1) // só faz sentido no crédito; 1 = à vista

  barbearia   Barbearia   @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId])
  @@map("agendamento_pagamentos")
}

/// Conta de cliente do MARKETPLACE (app do cliente). GLOBAL: um login por e-mail
/// funciona em QUALQUER barbearia. NÃO confundir com `Cliente`, que é o cadastro
/// LOCAL (CRM) de cada barbearia, chaveado por telefone. Ao agendar por uma conta,
/// o sistema garante um `Cliente` local correspondente para o painel/planos daquela
/// barbearia continuarem funcionando (o `Agendamento` guarda os dois vínculos).
model ContaCliente {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique // único no sistema inteiro (não por barbearia)
  senhaHash String   @map("senha_hash")
  telefone  String? // normalizado: apenas dígitos
  fotoUrl   String?  @map("foto_url")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  agendamentos Agendamento[]

  @@map("contas_cliente")
}

/// Cadastro de clientes. Telefone guardado normalizado (só dígitos), único por barbearia.
model Cliente {
  id             Int       @id @default(autoincrement())
  barbeariaId    Int       @map("barbearia_id")
  nome           String
  telefone       String // normalizado: apenas dígitos
  dataNascimento DateTime? @map("data_nascimento") // opcional
  observacoes    String? // nota livre do admin/barbeiro sobre o cliente
  selosFidelidade Int      @default(0) @map("selos_fidelidade") // programa de fidelidade: selos acumulados
  criadoEm       DateTime  @default(now()) @map("criado_em")

  barbearia    Barbearia         @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]
  planos       ClientePlano[]
  resgates     FidelidadeResgate[]

  // Telefone único DENTRO de cada barbearia.
  @@unique([barbeariaId, telefone])
  @@map("clientes")
}

/// Modelos de plano (assinatura) configurados pelo admin.
/// limitado = nº de usos; ilimitado = sem limite de usos.
/// diasSemana: dias em que o plano pode ser usado (0=dom .. 6=sáb, separados por vírgula).
model Plano {
  id           Int      @id @default(autoincrement())
  barbeariaId  Int      @map("barbearia_id")
  nome         String
  tipo         String // "limitado" | "ilimitado"
  usos         Int? // nº de usos (apenas para o tipo limitado)
  validadeDias Int      @default(30) @map("validade_dias") // validade em dias a partir da aquisição
  valor        Int      @default(0) // centavos; entra no caixa quando o cliente adquire
  ativo        Boolean  @default(true)
  servicoId    Int?     @map("servico_id") // LEGADO (um serviço só) — substituído por `servicos` (vários); não é mais usado

  diasSemana   String   @default("0,1,2,3,4,5,6") @map("dias_semana")
  criadoEm     DateTime @default(now()) @map("criado_em")

  barbearia   Barbearia      @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  servico     Servico?       @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  assinaturas ClientePlano[]
  servicos    PlanoServico[] // serviços cobertos pelo plano (vazio = qualquer serviço)

  @@map("planos")
}

/// Serviços cobertos por um plano (um plano pode cobrir vários; sem nenhum = qualquer).
model PlanoServico {
  id        Int @id @default(autoincrement())
  planoId   Int @map("plano_id")
  servicoId Int @map("servico_id")
  usos      Int? // usos/mês DESTE serviço no plano (null = sem cota própria)

  plano   Plano   @relation(fields: [planoId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([planoId, servicoId])
  @@map("plano_servicos")
}

/// Assinatura: vincula um plano a um cliente, com validade e usos restantes.
model ClientePlano {
  id            Int      @id @default(autoincrement())
  barbeariaId   Int      @map("barbearia_id")
  clienteId     Int      @map("cliente_id")
  planoId       Int      @map("plano_id")
  dataInicio    DateTime @map("data_inicio")
  dataFim       DateTime @map("data_fim")
  usosRestantes Int?     @map("usos_restantes") // null = ilimitado
  usosPorServico String? @map("usos_por_servico") // JSON {"servicoId": restantes}; null = plano sem cota por serviço
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")

  barbearia    Barbearia     @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  cliente      Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  plano        Plano         @relation(fields: [planoId], references: [id])
  agendamentos Agendamento[]

  @@map("cliente_planos")
}

/// Cupom de desconto do programa de fidelidade (tela Fidelidade).
model Cupom {
  id        Int      @id @default(autoincrement())
  barbeariaId Int    @map("barbearia_id")
  nome      String
  descricao String?
  desconto  String // texto livre: "20%" ou "R$15" — o mesmo formato do HTML original
  validade  DateTime
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@map("cupons")
}

/// Registro de resgate de selos de fidelidade (zera o contador do cliente).
/// Existe pra dar sentido real ao contador "Resgates/mês" da tela Fidelidade
/// — o HTML original só mostrava o "+1 selo", sem uma ação de resgatar.
model FidelidadeResgate {
  id          Int      @id @default(autoincrement())
  barbeariaId Int      @map("barbearia_id")
  clienteId   Int      @map("cliente_id")
  selosUsados Int      @map("selos_usados")
  data        DateTime @default(now())

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("fidelidade_resgates")
}

/// Itens (serviços/produtos) de cada agendamento. A equipe adiciona/remove aqui.
/// Não tem barbeariaId próprio: pertence sempre ao Agendamento (que é da barbearia).
model AgendamentoItem {
  id            Int @id @default(autoincrement())
  agendamentoId Int @map("agendamento_id")
  servicoId     Int @map("servico_id")
  valorUnitario Int @map("valor_unitario") // "congela" o preço no momento do agendamento (centavos)
  quantidade    Int @default(1)

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  servico     Servico     @relation(fields: [servicoId], references: [id])

  // Carregado junto de todo agendamento (include: itens) para somar a duração.
  @@index([agendamentoId])
  @@map("agendamento_itens")
}

/// Categorias dos itens de estoque (configuráveis manualmente).
model CategoriaEstoque {
  id          Int       @id @default(autoincrement())
  barbeariaId Int       @map("barbearia_id")
  nome        String
  itens       Estoque[]

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@map("categorias_estoque")
}

/// Itens de estoque (insumos internos). Alerta quando quantidade <= quantidadeMinima.
model Estoque {
  id               Int      @id @default(autoincrement())
  barbeariaId      Int      @map("barbearia_id")
  nome             String
  categoriaId      Int?     @map("categoria_id")
  quantidade       Int      @default(0)
  quantidadeMinima Int      @default(0) @map("quantidade_minima") // dispara o alerta
  valorGasto       Int      @default(0) @map("valor_gasto") // custo da compra (centavos)
  atualizadoEm     DateTime @default(now()) @updatedAt @map("atualizado_em")

  barbearia Barbearia         @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  categoria CategoriaEstoque? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  consumos  ServicoInsumo[]

  @@map("estoque")
}

/// Categorias das movimentações de caixa (configuráveis manualmente).
model CategoriaCaixa {
  id          Int     @id @default(autoincrement())
  barbeariaId Int     @map("barbearia_id")
  nome        String
  tipo        String // entrada | saida
  lancamentos Caixa[]

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@map("categorias_caixa")
}

/// Movimentações de caixa (entradas e saídas).
model Caixa {
  id            Int      @id @default(autoincrement())
  barbeariaId   Int      @map("barbearia_id")
  categoriaId   Int?     @map("categoria_id")
  descricao     String
  valor         Int // centavos
  tipo          String // entrada | saida
  data          DateTime @default(now())
  agendamentoId Int?     @map("agendamento_id") // preenchido se veio de um agendamento concluído
  formaPagamento String? @map("forma_pagamento") // pix | credito | debito | dinheiro (opcional)

  barbearia   Barbearia       @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  categoria   CategoriaCaixa? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  agendamento Agendamento?    @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)

  // `caixa` cresce a cada atendimento concluído (nunca é limpa) e é filtrada por
  // período no Dashboard e nos Relatórios. Sem índice o SQLite varria a tabela
  // inteira (todos os tenants). O 1º cobre a maioria das telas (entrada/saída num
  // período); o 2º atende o filtro só por data. Medido: Dashboard -78%, ano -86%.
  @@index([barbeariaId, tipo, data])
  @@index([barbeariaId, data])
  @@map("caixa")
}

/// Configurações gerais do app (chave/valor) por barbearia.
/// Ex.: caixa_automatico = "false", logo_url, mostrar_powered_by.
model Configuracao {
  id          Int    @id @default(autoincrement())
  barbeariaId Int    @map("barbearia_id")
  chave       String
  valor       String

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  // Cada chave é única DENTRO de cada barbearia.
  @@unique([barbeariaId, chave])
  @@map("configuracoes")
}

/// Trilha de auditoria do PAINEL-MESTRE (super-admin do SaaS). Registra toda
/// ação administrativa sensível — criar/excluir barbearia, suspender/reativar,
/// resetar senha, impersonar. É append-only por natureza (nunca editado/apagado
/// pelo app). `adminNome` é desnormalizado de propósito: o log tem que sobreviver
/// à exclusão do usuário que agiu, então não depende da relação para ser lido.
model LogAuditoria {
  id        Int      @id @default(autoincrement())
  adminId   Int?     @map("admin_id") // quem agiu (dono do SaaS); SetNull se a conta for removida
  adminNome String   @map("admin_nome") // cópia do nome no momento da ação (durável)
  acao      String // ex.: "barbearia.criar", "usuario.reset_senha", "barbearia.suspender"
  alvoTipo  String?  @map("alvo_tipo") // ex.: "barbearia", "usuario"
  alvoId    Int?     @map("alvo_id")
  detalhe   String? // texto livre: o que mudou, para quem, etc.
  ip        String? // IP de origem (req.ip, com trust proxy resolve o real atrás do nginx)
  criadoEm  DateTime @default(now()) @map("criado_em")

  admin Usuario? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@map("logs_auditoria")
}

/// Meta configurável (aba Metas, pedido do dono 2026-09-07). O admin escolhe a
/// MÉTRICA e o alvo, e o escopo: a barbearia toda (usuarioId nulo) ou um barbeiro.
/// O progresso é sempre do MÊS corrente (calculado na hora, não guardado).
model Meta {
  id          Int      @id @default(autoincrement())
  barbeariaId Int      @map("barbearia_id")
  usuarioId   Int?     @map("usuario_id") // nulo = barbearia toda; senão, meta do barbeiro
  metrica     String // "faturamento" | "atendimentos" | "novos_clientes" | "ticket_medio"
  alvo        Int // centavos (faturamento/ticket_medio) ou quantidade (atendimentos/novos_clientes)
  criadoEm    DateTime @default(now()) @map("criado_em")

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("metas")
}

/// Conversa de WhatsApp com um cliente — a "caixa de entrada" da secretária de
/// IA (Fase 3.2). Uma thread por cliente (telefone) em cada barbearia. Quando um
/// humano assume (`iaAtiva=false`), a IA para de responder ESTA conversa até
/// devolverem o controle. `naoLidas` conta mensagens do cliente ainda não vistas
/// pela equipe; `ultimaPrevia`/`ultimaMensagemEm` alimentam a lista de conversas.
model Conversa {
  id               Int      @id @default(autoincrement())
  barbeariaId      Int      @map("barbearia_id")
  clienteTelefone  String   @map("cliente_telefone") // normalizado (só dígitos)
  clienteNome      String?  @map("cliente_nome")
  clienteId        Int?     @map("cliente_id") // vínculo opcional ao CRM local
  iaAtiva          Boolean  @default(true) @map("ia_ativa")
  // Marco de "recomeço" do contexto da IA. Ao devolver o atendimento à IA
  // (Devolver à IA), gravamos agora() aqui e a IA passa a considerar SÓ as
  // mensagens a partir deste instante — assim ela não fica presa no histórico
  // antigo de handoff ("já chamei a equipe") e retoma o atendimento de verdade.
  iaContextoDesde  DateTime? @map("ia_contexto_desde")
  status           String   @default("aberta") // aberta | arquivada
  naoLidas         Int      @default(0) @map("nao_lidas")
  ultimaPrevia     String?  @map("ultima_previa")
  ultimaMensagemEm DateTime @default(now()) @map("ultima_mensagem_em")
  ultimaMsgClienteEm DateTime? @map("ultima_msg_cliente_em") // janela de 24h da Meta
  criadoEm         DateTime @default(now()) @map("criado_em")

  barbearia Barbearia  @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]

  @@unique([barbeariaId, clienteTelefone])
  @@index([barbeariaId, ultimaMensagemEm])
  @@map("conversas")
}

/// Uma mensagem de uma Conversa. `autor`: "cliente" (recebida), "ia" (resposta
/// automática) ou "humano" (a equipe respondeu pela caixa de entrada).
model Mensagem {
  id         Int      @id @default(autoincrement())
  conversaId Int      @map("conversa_id")
  autor      String // cliente | ia | humano
  texto      String // texto, legenda da mídia ou transcrição do áudio
  // "Clone do WhatsApp" (2026-09-30): mídia + id/status da Meta.
  tipo         String  @default("texto") // texto | imagem | video | audio | documento | figurinha | localizacao | contato
  midiaArquivo String? @map("midia_arquivo") // nome do arquivo em <APP_DATA_DIR>/wa-midia (servido só logado)
  midiaMime    String? @map("midia_mime")
  midiaNome    String? @map("midia_nome") // nome original (documentos)
  waId         String? @map("wa_id") // wamid da Meta — liga os status (entregue/lida)
  statusEnvio  String? @map("status_envio") // enviada | entregue | lida | falhou (só saída)
  criadoEm   DateTime @default(now()) @map("criado_em")

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId, criadoEm])
  @@index([waId])
  @@map("mensagens")
}

/// Registro DURÁVEL de cada lembrete de WhatsApp enviado (services/lembretes.js).
/// Existe além da marca `Agendamento.lembreteEnviadoEm` porque o histórico não
/// pode depender do agendamento continuar vivo: se ele for cancelado/apagado, o
/// lembrete já enviado não some do relatório. Por isso os dados do cliente são
/// COPIADOS aqui (não só referenciados) e `agendamentoId` é opcional (SetNull).
model LembreteLog {
  id              Int       @id @default(autoincrement())
  barbeariaId     Int       @map("barbearia_id")
  agendamentoId   Int?      @map("agendamento_id") // referência; nula se o agendamento for apagado
  clienteNome     String    @map("cliente_nome")
  clienteTelefone String    @map("cliente_telefone")
  horaAgendamento String?   @map("hora_agendamento") // "HH:MM" lembrado
  dataAgendamento DateTime? @map("data_agendamento") // dia do agendamento
  enviadoEm       DateTime  @default(now()) @map("enviado_em")

  barbearia   Barbearia    @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)

  @@index([barbeariaId, enviadoEm])
  @@map("lembrete_logs")
}

/// Consumo mensal da secretária de IA por barbearia (Fase 3.5) — base do TETO de
/// custo. Uma linha por barbearia por mês (`competencia` = "AAAA-MM"). Ao bater o
/// teto, a IA pausa as respostas automáticas no mês e `avisadoTeto` evita repetir
/// o aviso ao dono. Reinicia sozinho no mês seguinte (nova competência).
model UsoIA {
  id            Int      @id @default(autoincrement())
  barbeariaId   Int      @map("barbearia_id")
  competencia   String // "AAAA-MM"
  // WhatsApp (secretária) — `respostas`/tokens são o que o TETO da 3.5 já usa.
  respostas     Int      @default(0)
  tokensEntrada Int      @default(0) @map("tokens_entrada")
  tokensSaida   Int      @default(0) @map("tokens_saida")
  // Entrada CRUA (tokens de entrada reais, SEM a ponderação do cache). Base da
  // coluna "Entrada crua" no painel de uso; medida a partir de 2026-09-20.
  tokensEntradaCru Int   @default(0) @map("tokens_entrada_cru")
  avisadoTeto   Boolean  @default(false) @map("avisado_teto")
  // Copiloto (Assistente do painel) — contado à parte (modelo/preço diferentes).
  copilotoConsultas     Int @default(0) @map("copiloto_consultas")
  copilotoTokensEntrada Int @default(0) @map("copiloto_tokens_entrada")
  copilotoTokensSaida   Int @default(0) @map("copiloto_tokens_saida")
  copilotoTokensEntradaCru Int @default(0) @map("copiloto_tokens_entrada_cru")
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em")

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@unique([barbeariaId, competencia])
  @@map("uso_ia")
}

/// Consumo de IA DETALHADO por MODELO, para o custo do painel-mestre bater mesmo
/// quando o modelo muda no meio do mês (ex.: Haiku -> Sonnet). Uma linha por
/// (barbearia, competência, canal, modelo). O custo soma cada linha pelo preço do
/// seu próprio modelo, em vez de reprecificar tudo pelo modelo atual. A `UsoIA`
/// continua sendo a base do TETO e das contagens; esta tabela é só para custo.
model UsoIAModelo {
  id            Int      @id @default(autoincrement())
  barbeariaId   Int      @map("barbearia_id")
  competencia   String // "AAAA-MM"
  canal         String // "whatsapp" | "copiloto"
  modelo        String // ex.: "claude-haiku-4-5"
  tokensEntrada Int      @default(0) @map("tokens_entrada") // já ponderados pelo cache
  tokensSaida   Int      @default(0) @map("tokens_saida")
  tokensEntradaCru Int   @default(0) @map("tokens_entrada_cru") // input REAL (sem ponderar cache)
  chamadas      Int      @default(0) // respostas (whatsapp) ou consultas (copiloto)
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em")

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@unique([barbeariaId, competencia, canal, modelo])
  @@map("uso_ia_modelo")
}

/// Baixa de comissão (spec 12, B3/B5/G15): o responsável marca como PAGA a
/// comissão de um barbeiro num período. Hoje a comissão é só calculada
/// (comissaoController); esta tabela guarda o que foi pago, quando e por quem.
/// `valorCalculado` é o que o app calculou no momento da baixa (para conferir
/// depois se alguém reabriu um atendimento do período). `caixaId` = saída
/// lançada no caixa junto com a baixa (opcional).
model ComissaoPagamento {
  id             Int      @id @default(autoincrement())
  barbeariaId    Int      @map("barbearia_id")
  usuarioId      Int      @map("usuario_id") // barbeiro que recebeu
  periodoInicio  DateTime @map("periodo_inicio") // 1º dia do período (00:00)
  periodoFim     DateTime @map("periodo_fim") // último dia do período, incluso (00:00)
  valor          Int // centavos pagos
  valorCalculado Int      @map("valor_calculado") // centavos calculados na hora da baixa
  pagoEm         DateTime @default(now()) @map("pago_em")
  pagoPorId      Int?     @map("pago_por_id") // quem deu baixa (sem FK: sobrevive à saída)
  pagoPorNome    String   @map("pago_por_nome")
  observacao     String?
  caixaId        Int?     @map("caixa_id")

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([barbeariaId, usuarioId, periodoInicio])
  @@map("comissao_pagamentos")
}

/// Fechamento do caixa do dia (redesign v3, F6: "Fechar o caixa de hoje").
/// Um por barbearia por dia. Guarda o resumo do dia NO MOMENTO do fechamento
/// (entradas, saídas, por forma de pagamento) e a conferência da gaveta:
/// `dinheiroEsperado` = fundo inicial + entradas em dinheiro − saídas em
/// dinheiro; `diferenca` = contado − esperado (negativo = faltou dinheiro).
/// Fechar de novo o mesmo dia ("refazer") atualiza o registro e soma `vezes`.
/// Não trava lançamentos: é um registro de conferência, não um bloqueio.
model FechamentoCaixa {
  id               Int      @id @default(autoincrement())
  barbeariaId      Int      @map("barbearia_id")
  dia              DateTime // o dia fechado (00:00 local)
  fechadoEm        DateTime @default(now()) @map("fechado_em")
  fechadoPorId     Int?     @map("fechado_por_id") // sem FK: o registro sobrevive à saída da pessoa
  fechadoPorNome   String   @map("fechado_por_nome")
  entradas         Int // centavos
  saidas           Int // centavos
  saldo            Int // centavos (entradas − saídas)
  porForma         String   @map("por_forma") // JSON { pix, credito, debito, dinheiro, sem_forma } das entradas
  atendimentos     Int // atendimentos concluídos no dia
  fundoInicial     Int      @default(0) @map("fundo_inicial") // troco que já estava na gaveta (centavos)
  dinheiroEsperado Int      @map("dinheiro_esperado")
  dinheiroContado  Int      @map("dinheiro_contado")
  diferenca        Int
  observacao       String?
  vezes            Int      @default(1) // quantas vezes o dia foi fechado

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@unique([barbeariaId, dia])
  @@map("fechamentos_caixa")
}
