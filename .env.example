# Copie este arquivo para .env e ajuste os valores

# Porta do servidor
PORT=3000

# Segredo da sessão (troque por um valor aleatório)
SESSION_SECRET=troque-por-um-segredo-aleatorio

# Banco SQLite (caminho relativo à pasta prisma/)
DATABASE_URL="file:../data/app.db"

# PRODUÇÃO — leia com atenção:
# A pasta do código é RECRIADA a cada "Reimplantar". Se o banco, os uploads e as
# sessões ficarem dentro dela, TUDO é perdido no deploy (clientes, agendamentos,
# fotos). Aponte as duas variáveis abaixo para um diretório FORA do deploy:
#
#   APP_DATA_DIR=/home/SEU_USUARIO/cortavo-data
#   DATABASE_URL="file:/home/SEU_USUARIO/cortavo-data/app.db"
#
# O DATABASE_URL precisa ser um caminho ABSOLUTO: o `prisma migrate deploy` do
# postinstall lê esta variável e resolve caminhos relativos a partir de prisma/.

# Domínio raiz da aplicação em produção (sem "www", sem subdomínio de barbearia).
# Necessário para diferenciar o domínio raiz de um subdomínio de barbearia
# (ex.: andrade.cortavo.com.br). Deixe em branco em desenvolvimento local.
APP_DOMAIN=cortavo.com.br

# E-mail de acesso (spec 13): link para a pessoa CRIAR a própria senha.
# Hoje: SMTP do Gmail com SENHA DE APP da conta cortavo.app@gmail.com
# (exige a verificação em duas etapas ligada na conta). Amanhã dá para trocar
# por Brevo/Resend/SES mudando SÓ estas variáveis.
# Sem estas variáveis o app sobe normalmente: o mestre mostra "E-mail não
# enviado" e o botão Reenviar. A senha NUNCA vai neste arquivo de exemplo.
EMAIL_SMTP_HOST=
# 465 = SSL direto; 587 = STARTTLS
EMAIL_SMTP_PORTA=
# Login no SMTP (no Gmail, o próprio endereço da conta)
EMAIL_SMTP_USUARIO=
# SEGREDO: senha de app do Google (16 letras). Só no .env do servidor.
EMAIL_SMTP_SENHA=
# Endereço do "De" e do "Responder para"
EMAIL_REMETENTE=
# Nome do "De" (padrão: Cortavo)
EMAIL_REMETENTE_NOME=
# 1 em desenvolvimento e testes: não envia nada (só registra "envio simulado").
# Vazio em produção.
EMAIL_ENVIO_DESLIGADO=
# Teto de e-mails de acesso por dia (opcional; padrão 200). O Gmail aceita 500/dia.
EMAIL_LIMITE_DIA=
